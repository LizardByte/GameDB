elease_region": {"id": 5, "region": "japan"}}, {"id": 759684, "date": 1188864000, "platform": 38, "y": 2007, "release_region": {"id": 7, "region": "asia"}}, {"id": 759685, "date": 1182988800, "platform": 9, "y": 2007, "release_region": {"id": 5, "region": "japan"}}, {"id": 759686, "date": 1188864000, "platform": 9, "y": 2007, "release_region": {"id": 7, "region": "asia"}}], "screenshots": [{"id": 1737311, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc118in.jpg"}, {"id": 1737312, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc118io.jpg"}, {"id": 1737313, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc118ip.jpg"}], "slug": "the-king-of-fighters-kyo", "storyline": "The game takes place 11 months after the '96 tournament, and covers the months prior to the '97 tournament and the tournament itself from an RPG-like point of view. You control Kyo, and go around the world (starting in your home, Osaka and eventually going to places like Mexico and California) advancing a plot line related to the Orochi storyline and your eternal enemy, Iori Yagami, by interacting with other characters from the series, solving subquests and winning fights viewed from a first-person perspective.", "summary": "The King of Fighters: Kyo is a visual novel on the The King of Fighters series developed by Yumekobo and released by SNK on the PlayStation on August 27, 1998. The art for this game was produced by the same illustrator of the manga, Masato Natsumoto. It was re-released on PSN as a PSOne Classics on June 28, 2007. An unofficial Spanish translation was released in 2013.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/the-king-of-fighters-kyo", "videos": [{"id": 154402, "name": "Game Intro", "video_id": "97XpFNWAu_A", "url": "https://www.youtube.com/watch?v=97XpFNWAu_A", "title": "The King of Fighters Kyo   Intro", "thumb": "https://i.ytimg.com/vi/97XpFNWAu_A/hqdefault.jpg"}], "collections": [{"id": 854, "name": "The King of Fighters"}]}