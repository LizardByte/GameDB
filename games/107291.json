g"}, {"id": 245313, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ujrsqpbx97havwqrxrys.jpg"}, {"id": 245312, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ebyziw7pmmewyuhxrewv.jpg"}, {"id": 245319, "url": "//images.igdb.com/igdb/image/upload/t_thumb/l0pmwabrxjgtctrcmcxw.jpg"}, {"id": 245317, "url": "//images.igdb.com/igdb/image/upload/t_thumb/iaky8vikolvqvw0ca0m6.jpg"}, {"id": 245311, "url": "//images.igdb.com/igdb/image/upload/t_thumb/akpbcdujpdil82fsrcah.jpg"}, {"id": 245318, "url": "//images.igdb.com/igdb/image/upload/t_thumb/d7eck4vl3bdorxavyfq7.jpg"}, {"id": 245314, "url": "//images.igdb.com/igdb/image/upload/t_thumb/vdchv7cn8b1gbjklt25p.jpg"}, {"id": 245316, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ty3zgt8ng9smhij4ktys.jpg"}, {"id": 245315, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zwlpnaexzqvbjexdcuhy.jpg"}, {"id": 245321, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ircdrwdqbynvkvcgcnwc.jpg"}, {"id": 245320, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tekjfjmtih6bznoorwgz.jpg"}], "slug": "infected-shelter", "storyline": "\"You play as a member of a surviving group in a post-apocalyptic world. On one fateful morning you awake to find the shelter is raided and your people are kidnapped for reasons unknown. Leaving your shelter you emerge into the harsh infected land and start looking for the kidnappers and the truth behind the events. Your path lead you through randomly generated post-apocalyptic areas controlled by different enemy factions with brutal leaders and shelters occupied by infected creatures.\n\nYou have to use your skills in a fast paced, violent and complex 2D brawler-like combat where lots of firearms and melee weapons are waiting for you to beat and execute your enemies. You will unlock new weapons, clothes, skills, relics and RPG-like character improvements during your journey.\"", "summary": "\"Dead Cells + Castle Crashers + executions = Infected Shelter\n\nInfected Shelter is a randomly generated rogue-lite post-apocalyptic action RPG shooter / dungeon brawler. Singleplayer and co-op for up to four players.\n\nEvery run is different because of the randomly generated content. By beating enemies players can loot more than 150 different blueprints of permanent improvements and this is the key to Infected Shelter's replayability. Instead of just collecting loot to make yourself more powerful during a single run, you unlock new weapons, clothes, skills, relics and RPG-like character improvements that change how you play the game in the following runs.\"", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/infected-shelter", "videos": [{"id": 21899, "name": "Trailer", "video_id": "oZJJFLkQudg", "url": "https://www.youtube.com/watch?v=oZJJFLkQudg", "title": "Infected Shelter - Announcement Trailer", "thumb": "https://i.ytimg.com/vi/oZJJFLkQudg/maxresdefault.jpg"}, {"id": 26788, "name": "Trailer", "video_id": "I1cw3no8oic", "url": "https://www.youtube.com/watch?v=I1cw3no8oic", "title": "Infected Shelter - Early Access Release Date Trailer", "thumb": "https://i.ytimg.com/vi/I1cw3no8oic/maxresdefault.jpg"}, {"id": 25799, "name": "Trailer", "video_id": "0OCmpH5e7Zg", "url": "https://www.youtube.com/watch?v=0OCmpH5e7Zg", "title": "Infected Shelter  - PAX East 2019 Trailer - Coming Soon to Early Access", "thumb": "https://i.ytimg.com/vi/0OCmpH5e7Zg/maxresdefault.jpg"}, {"id": 27114, "name": "Launch Trailer", "video_id": "4br79WiIBg0", "url": "https://www.youtube.com/watch?v=4br79WiIBg0", "title": "Infected Shelter | Trailer | Available Now", "thumb": "https://i.ytimg.com/vi/4br79WiIBg0/maxresdefault.jpg"}]}