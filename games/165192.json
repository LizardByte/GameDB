, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scj2du.jpg"}, {"id": 889559, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scj2dz.jpg"}, {"id": 889557, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scj2dx.jpg"}, {"id": 889562, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scj2e2.jpg"}], "slug": "the-elder-scrolls-v-skyrim-anniversary-edition", "storyline": "The adventure unfolds in Skyrim, a cold and mountainous province in the north of the continent of Tamriel, divided into nine holds and long regarded as the ancestral homeland of the Nords. The once-mighty Empire that rules the land has been left weakened by a brutal war, and civil unrest simmers between imperial loyalists and rebels. The story begins with the player captured by imperial soldiers and mistakenly marked for execution alongside the rebel leader Ulfric Stormcloak. The grim proceedings are shattered when a fearsome dragon named Alduin descends upon the outpost, and in the chaos the player escapes. Soon after, upon slaying a dragon and absorbing its very soul, the player is revealed to be the legendary Dragonborn, and is summoned by the mysterious Greybeards to embrace an ancient and world-shaping destiny.", "summary": "The Elder Scrolls V: Skyrim - Anniversary Edition contains the full game plus all three expansions and over 500 pieces of unique content from Creation Club, including pre-existing and new quests, dungeons, bosses, weapons, spells and more!", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/the-elder-scrolls-v-skyrim-anniversary-edition", "videos": [{"id": 60232, "name": "Trailer", "video_id": "t-_56Ouy8II", "url": "https://www.youtube.com/watch?v=t-_56Ouy8II", "title": "The Elder Scrolls V: Skyrim Anniversary Edition Trailer", "thumb": "https://i.ytimg.com/vi/t-_56Ouy8II/maxresdefault.jpg"}, {"id": 60233, "name": "Gameplay Video", "video_id": "0kQjFqkeOTQ", "url": "https://