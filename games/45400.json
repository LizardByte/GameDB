": [{"id": 1797008, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12ikw.jpg"}, {"id": 1797009, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12ikx.jpg"}, {"id": 1797010, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12iky.jpg"}, {"id": 1797011, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12ikz.jpg"}], "slug": "zoku-gussun-oyoyo", "summary": "Zoku Gussun Oyoyo is an action puzzle game and a sequel to Risky Challenge. The game plays essentially the same as its predecessor \u2014 position falling blocks in a well, Tetris-style, to guide the characters to the exit of each stage \u2014 but includes 100 all-new puzzles and several new game modes. Normal and Versus modes are the single-player story and two-player versus modes returning from the previous game; Tsume mode is a dedicated puzzle mode; Climbing mode is an endless climb mode where the goal is to climb upward as far as possible; and Ranking Certification mode is a trial mode where the player must complete a selection of stages to earn higher rankings.\n\nThe PlayStation and Saturn versions feature slightly different puzzle layouts but are otherwise identical.", "themes": [{"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/zoku-gussun-oyoyo", "videos": [{"id": 178008, "name": "Gameplay Video", "video_id": "Uf6X5kLzVD4", "url": "https://www.youtube.com/watch?v=Uf6X5kLzVD4", "title": "Zoku Gussun Oyoyo (Saturn): First 15 minutes", "thumb": "https://i.ytimg.com/vi/Uf6X5kLzVD4/maxresdefault.jpg"}], "collections": [{"id": 3079, "name": "Gussun Oyoyo"}]}