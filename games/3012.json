rldwide"}}, {"id": 480336, "platform": 39, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 480337, "date": 1582243200, "platform": 3, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 480334, "platform": 34, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 628457, "platform": 3, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 8702, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sy6jropccqstdkmedjx4.jpg"}, {"id": 8707, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bjop5z47vethch5cvyo9.jpg"}, {"id": 8705, "url": "//images.igdb.com/igdb/image/upload/t_thumb/h0xlxvat5eqv0rhqzptm.jpg"}, {"id": 1698133, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10ead.jpg"}, {"id": 1752217, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11k0p.jpg"}, {"id": 1811027, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12teb.jpg"}, {"id": 1811076, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12tfo.jpg"}, {"id": 1811063, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12tfb.jpg"}, {"id": 1811064, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12tfc.jpg"}, {"id": 1398666, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctz7u.jpg"}, {"id": 1398668, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctz7w.jpg"}, {"id": 8703, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ftqnfk7renpj6dvkv1e6.jpg"}, {"id": 1398670, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctz7y.jpg"}, {"id": 1398667, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctz7v.jpg"}, {"id": 1398669, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctz7x.jpg"}, {"id": 8704, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bemfmxwo2g0kjy0zx37v.jpg"}], "slug": "osu", "summary": "Osu! is a and open source rhythm game originally created by Australian developer Dean Herbert in 2007. The gameplay is based on the Osu! Tatakae! Ouendan series and primarily involves clicking circles that appear on screen in time with music using a cursor or finger.\n\nThe game features four rulesets: osu!standard (click circles, sliders, and spinners), osu!taiko (drum-based notes inspired by Taiko no Tatsujin), osu!catch (catching falling fruit), and osu!mania (vertically scrolling key-based notes). Levels, called beatmaps, are created and uploaded by the community, providing a large and constantly expanding library. Players can compete on global leaderboards ranked by performance points or join real-time multiplayer rooms. The game supports keyboard, mouse, and graphics tablet input.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/osu", "videos": [{"id": 127250, "name": "Gameplay Video", "video_id": "p3cWTxvyKpA", "url": "https://www.youtube.com/watch?v=p3cWTxvyKpA", "title": "[OSU!] MOST INSANE PLAY IN THE WORLD! 100% ACCURACY The Quick Brown Fox - The Big Black", "thumb": "https://i.ytimg.com/vi/p3cWTxvyKpA/maxresdefault.jpg"}]}