e_region": {"id": 8, "region": "worldwide"}}, {"id": 475498, "platform": 49, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 559601, "platform": 6, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 324048, "date": 1645747200, "platform": 167, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 709280, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7a8.jpg"}, {"id": 709281, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7a9.jpg"}, {"id": 709282, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7aa.jpg"}, {"id": 709283, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7ab.jpg"}, {"id": 709284, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7ac.jpg"}, {"id": 709285, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scf7ad.jpg"}], "slug": "elden-ring-launch-edition", "storyline": "Elden Ring takes place in the Lands Between, a fictional realm over which several demigods rule. It was previously ruled over by the immortal Queen Marika, who acted as keeper of the Elden Ring, a powerful force that manifested itself as the physical concept of order. When Marika shattered the Elden Ring and disappeared, her demigod children began fighting over pieces of the Ring in an event called The Shattering. Each demigod has a shard of the Ring called a Great Rune, which corrupts them with power. In the game, the player character is a Tarnished, one of a group of exiles from the Lands Between who are summoned back after the Shattering. The player must traverse the realm to repair the Elden Ring and become the Elden Lord.", "summary": "The Elden Ring: Launch Edition is a special edition of Elden Ring that was available at the game's release. This edition includes several physical and digital items aimed at enhancing the experience for early adopters. It includes:\n\n- Physical copy of the game;\n- Exclusive SteelBook Case: A collectible metal case featuring unique artwork.\n- Art Cards: A set of 3 exclusive art cards depicting scenes or characters from the game.\n- Woven Patch: A patch featuring a significant symbol from Elden Ring;\n- Stickers: A set of stickers with designs related to the game;\n- Poster: An exclusive poster showcasing artwork from the game.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/elden-ring-launch-edition", "videos": [{"id": 63220, "name": "Trailer", "video_id": "l6pCyV7PnqI", "url": "https://www.youtube.com/watch?v=l6pCyV7PnqI", "title": "ELDEN RING \u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30c8\u30ec\u30fc\u30e9\u30fc\u3010SummerGameFest2021\u3011", "thumb": "https://i.ytimg.com/vi/l6pCyV7PnqI/maxresdefault.jpg"}]}