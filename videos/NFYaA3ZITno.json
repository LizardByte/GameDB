{"id": "NFYaA3ZITno", "snippet": {"title": "\uc774\ub2e8\uacfc \ud658\uc0c1\uc744 \uc2ec\ud310\ud558\ub77c :: \uc774\ub2e8\uc2ec\ud310\uad00 \uc250\ud37c\ub4dc", "description": "\uc774\ub2e8\uc2ec\ud310\uad00 \uc250\ud37c\ub4dc\uac00 \ub418\uc5b4 \uc218\uc0c1\ud55c \ub9c8\uc744\uc5d0\uc11c \ubc8c\uc5b4\uc9c4 \uc774\ub2e8 \uc0ac\uac74\uc744 \uc218\uc0ac\ud558\uace0, \uadf8\ub4e4\uc744 \uc2ec\ud310\ud558\uc2ed\uc2dc\uc624.\n\uacf5\ud3ec\uc640 \ud63c\ub780\uc5d0 \uc7a0\uae34 \uc138\uc0c1\uc758 \ube44\ubc00\uc744 \ud30c\ud5e4\uce58\uace0, \ud544\uc5f0\uc801\uc778 \uc120\ud0dd\uc758 \uae30\ub85c\uc5d0 \uc11c\uc2ed\uc2dc\uc624.\n\ub2f9\uc2e0\uc758 \ucd94\ub9ac\uc640 \uacb0\uc815\uc774 \uc138\uc0c1\uc744 \ubc14\uafd4\ub193\uc744 \ube44\uc8fc\uc5bc \ub178\ubca8 \ubbf8\uc2a4\ud130\ub9ac \ucd94\ub9ac\uadf9.\n\uc774 \uc808\ub9dd\uc801\uc778 \uacf5\ud3ec \uc18d\uc5d0\uc11c \ub05d\uae4c\uc9c0 \uc0b4\uc544\ub0a8\uc73c\uc2ed\uc2dc\uc624.\n\nSteam \ub370\ubaa8 \ubc84\uc804 \ubb34\ub8cc \ud50c\ub808\uc774 \uac00\ub2a5\n\ud140\ube14\ubc85 \ud380\ub529 \uc9c4\ud589 \uc911, \ub313\uae00 \ucc38\uc870.", "thumbnails": {"default": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/default.jpg", "width": 120, "height": 90}, "medium": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/mqdefault.jpg", "width": 320, "height": 180}, "high": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/hqdefault.jpg", "width": 480, "height": 360}, "standard": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/sddefault.jpg", "width": 640, "height": 480}, "maxres": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/maxresdefault.jpg", "width": 1280, "height": 720}, "fhd": {"url": "https://i.ytimg.com/vi/NFYaA3ZITno/fhddefault.jpg", "width": 1920, "height": 1080}}, "localized": {"title": "\uc774\ub2e8\uacfc \ud658\uc0c1\uc744 \uc2ec\ud310\ud558\ub77c :: \uc774\ub2e8\uc2ec\ud310\uad00 \uc250\ud37c\ub4dc", "description": "\uc774\ub2e8\uc2ec\ud310\uad00 \uc250\ud37c\ub4dc\uac00 \ub418\uc5b4 \uc218\uc0c1\ud55c \ub9c8\uc744\uc5d0\uc11c \ubc8c\uc5