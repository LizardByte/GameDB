": [{"id": 1017360, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt00.jpg"}, {"id": 1017362, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt02.jpg"}, {"id": 1017363, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt03.jpg"}, {"id": 1017366, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt06.jpg"}, {"id": 1017361, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt01.jpg"}, {"id": 1017365, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt05.jpg"}, {"id": 1017364, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclt04.jpg"}], "slug": "street-fighter-alpha-3--2", "storyline": "The PlayStation version makes Balrog, Juli and Juni immediately playable and adds the remaining characters introduced in Super Street Fighter II: Dee Jay, Fei Long and T. Hawk, along with Guile from Street Fighter II, and Evil Ryu and Shin Akuma from Street Fighter Alpha 2, the latter three being unlockable. The Dreamcast and Saturn versions move Guile, Evil Ryu and Shin Akuma to the default roster (although the latter shares a slot with his regular counterpart and is playable via a special button combination). The more powerful version of M. Bison who is the true final boss of Alpha 3 with the special Shadaloo-ism meter, Final M. Bison, is also made playable in these Sega versions via a code.", "summary": "The PlayStation port of Street Fighter Alpha 3 has added new characters to the roster, including Juli, Juni, Balrog, Dee Jay, Fei Long and T. Hawk. They come with new portraits and their own scenarios. Guile, Evil Ryu and Shin Akuma have also been added as secret characters that can be unlocked through World Tour mode, a mode that allows players to strengthen and customize the fighting style of their chosen character while traveling the world.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/street-fighter-alpha-3--2", "videos": [{"id": 196100, "name": "Trailer", "video_id": "mkZPociFSyc", "url": "https://www.youtube.com/watch?v=mkZPociFSyc", "title": "Street Fighter Alpha 3 (PSX) - Longplay", "thumb": "https://i.ytimg.com/vi/mkZPociFSyc/maxresdefault.jpg"}], "collections": [{"id": 2883, "name": "Street Fighter Alpha"}, {"id": 219, "name": "Street Fighter"}]}