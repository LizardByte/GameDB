ecoop": false, "offlinemax": 4, "onlinecoop": false, "platform": 63, "splitscreen": false, "checksum": "58eda009-f09f-d6b0-886f-6d5101ccf386"}], "name": "Hole-In-One Miniature Golf", "platforms": [115, 15, 63, 14, 13, 16], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 924994, "date": 599529600, "platform": 16, "y": 1988, "release_region": {"id": 2, "region": "north_america"}}, {"id": 924995, "date": 599529600, "platform": 115, "y": 1988, "release_region": {"id": 2, "region": "north_america"}}, {"id": 924996, "date": 599529600, "platform": 63, "y": 1988, "release_region": {"id": 1, "region": "europe"}}, {"id": 924997, "date": 599529600, "platform": 15, "y": 1988, "release_region": {"id": 1, "region": "europe"}}, {"id": 924998, "date": 631065600, "platform": 13, "y": 1989, "release_region": {"id": 2, "region": "north_america"}}, {"id": 924999, "date": 662601600, "platform": 14, "y": 1990, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 1853145, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13pw9.jpg"}, {"id": 1853146, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13pwa.jpg"}, {"id": 1853147, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13pwb.jpg"}, {"id": 1853148, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13pwc.jpg"}], "slug": "hole-in-one-miniature-golf", "summary": "Hole-In-One Miniature Golf provides an overhead view of each hole. The gameplay is controlled entirely with the mouse. You place the ball on the starting pad and click the left mouse button. Once you have placed the ball, \"stretch\" a line from the ball to the pointer. The direction the line is pointing is the direction the ball will go. The length of the line or the distance between the pointer and the ball is relative to the power on the shot. Once you are satisfied, click the left mouse button to putt the ball.\n\nYou are allowed to go three shots over par. Any more than that and you will get a penalty stroke and must advance to the next hole (or player). You can also get one stroke penalty for going into a water hazard. Your scorecard will be displayed after the first nine holes but can be viewed at anytime using the Options Menu. After completing the course the scorecard will be displayed again. You can print your scores or exit to continue.\n\nThe game features five complete 18-hole courses with different themes including a Tutorial Course that walks the player through every aspect of gameplay, a Classics Course which is patterned after the basic traditional miniature golf course, an Intermediate Course that adds more obstacles, elevations and difficulty, an adventurous Fantasy Course with designs ranging from castles to pinball and the Expert Course for those who master the game. The game can be installed on a hard drive.", "url": "https://www.igdb.com/games/hole-in-one-miniature-golf", "videos": [{"id": 186065, "name": "Gameplay Video", "video_id": "pnOzPwYYo0I", "url": "https://www.youtube.com/watch?v=pnOzPwYYo0I", "title": "Mini Golf - Atari ST (1988)", "thumb": "https://i.ytimg.com/vi/pnOzPwYYo0I/sddefault.jpg"}, {"id": 187096, "name": "Trailer", "video_id": "LYVF-H_5SYI", "url": "https://www.youtube.com/watch?v=LYVF-H_5SYI", "title": "[c64] Mini Golf (1988)", "thumb": "https://i.ytimg.com/vi/LYVF-H_5SYI/maxresdefault.jpg"}]}