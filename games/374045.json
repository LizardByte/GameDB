igdb/image/upload/t_thumb/sc1463x.jpg"}, {"id": 1874158, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1463y.jpg"}, {"id": 1874159, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1463z.jpg"}, {"id": 1874160, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14640.jpg"}, {"id": 1874161, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14641.jpg"}], "slug": "neighborhood-video", "storyline": "Following the mysterious disappearance of the previous cashier at local video rental store, Neighborhood Video, you are contracted as an amateur private investigator to case the place while undercover. In between browsing shelves and mopping floors, follow clues left behind by the missing employee by completing escape room puzzles and perusing the film database. Translate ciphers, combine objects, and hunt for hidden messages to uncover a blockbuster conspiracy. Between employees vanishing without a trace, the impending threat of rival video stores, and hints at cult activity, find more than you bargained for - all for minimum wage.", "summary": "Crack the case of the missing video store employee in this 3D point and click mystery game by solving escape room puzzles, combing the computer database, and scouring shelves as an undercover detective posing as a cashier during your first weekend at the suspiciously understaffed Neighborhood Video.", "themes": [{"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/neighborhood-video", "videos": [{"id": 189625, "name": "Gameplay Trailer", "video_id": "MWApiCWh5l8", "url": "https://www.youtube.com/watch?v=MWApiCWh5l8", "title": "Neighborhood Video Demo Trailer", "thumb": "https://i.ytimg.com/vi/MWApiCWh5l8/maxresdefault.jpg"}]}