, "lancoop": false, "offlinecoop": false, "offlinemax": 2, "onlinecoop": false, "platform": 39, "splitscreen": true, "checksum": "8063c53a-dd79-f93c-b71e-20f2afafdda5"}, {"id": 45055, "campaigncoop": false, "dropin": false, "game": 347722, "lancoop": false, "offlinecoop": false, "offlinemax": 2, "onlinecoop": false, "platform": 34, "splitscreen": true, "checksum": "3a43f9b8-03c8-21ce-bc17-22c70e10ef48"}], "name": "Catch Flex", "platforms": [34, 6, 39, 167], "player_perspectives": [{"id": 2, "name": "Third person"}], "release_dates": [{"id": 965510, "date": 1786233600, "platform": 34, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 965511, "date": 1788220800, "platform": 39, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 965512, "date": 1788307200, "platform": 167, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 959190, "date": 1787961600, "platform": 6, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1923172, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xg.jpg"}, {"id": 1923173, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xh.jpg"}, {"id": 1923177, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xl.jpg"}, {"id": 1923176, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xk.jpg"}, {"id": 1923174, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xi.jpg"}, {"id": 1923175, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc157xj.jpg"}], "slug": "catch-flex--1", "summary": "Catch Flex is a full-body dance rhythm game played in front of a single camera, with no VR headset, no gamepad and no wearables. The camera sees your whole body, your moves are the input, and even the menus are gesture-controlled. Tracking runs locally on the device, or on a phone running the free Catch Flex: Controller app, which sends only movement data over the local network and never uploads video.\n\nSix kinds of move make up a chart. Slash blocks in the direction of the arrow, catch rings with a hand or a foot, kick the balls or knock them back, stomp floor markers on the beat, ride slide trails to the end, and dodge obstacles by ducking, leaning or stepping over. Vol. 1 holds ten hand-charted original tracks from 96 to 150 BPM, house, electro and techno, all charted within reach of a real body with no jumping needed. An optional no-fail mode lets you move through a whole song without chasing a score.\n\nBeyond the solo run there is local split-screen Versus for two players, global leaderboards and ten achievements. Custom levels are made in Catch Flex Editor, a free browser editor, and loaded into the game over Wi-Fi. The game also reads charts saved in other common level formats.", "themes": [{"id": 1, "name": "Action"}, {"id": 40, "name": "Party"}], "url": "https://www.igdb.com/games/catch-flex--1", "videos": [{"id": 196361, "name": "Trailer", "video_id": "5lhQA7ca368", "url": "https://www.youtube.com/watch?v=5lhQA7ca368", "title": "Catch Flex \u2014 Official Launch Trailer | Full-Body Rhythm Game, No VR", "thumb": "https://i.ytimg.com/vi/5lhQA7ca368/uhddefault.jpg"}]}