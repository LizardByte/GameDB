{"id": 18381, "artworks": [{"id": 204748, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dzg.jpg"}, {"id": 204745, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dzd.jpg"}, {"id": 204746, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dze.jpg"}, {"id": 204747, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dzf.jpg"}, {"id": 204744, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dzc.jpg"}, {"id": 204749, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4dzh.jpg"}], "cover": {"id": 332249, "url": "//images.igdb.com/igdb/image/upload/t_thumb/co74d5.jpg"}, "external_games": [{"id": 135929, "name": "Pac & Pal", "uid": "23313", "url": "https://www.giantbomb.com/games/3030-23313/", "external_game_source": {"id": 3, "name": "GiantBomb"}}, {"id": 1921112, "name": "Pac & Pal", "uid": "21145", "url": "https://www.twitch.tv/directory/game/Pac%20%26%20Pal", "external_game_source": {"id": 14, "name": "Twitch"}}], "franchises": [{"id": 892, "name": "Pac-Man"}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 9, "name": "Puzzle"}, {"id": 33, "name": "Arcade"}], "involved_companies": [{"id": 278191, "company": {"id": 263, "name": "Namco"}, "developer": true}], "name": "Pac & Pal", "platforms": [52], "player_perspectives": [{"id": 4, "name": "Side view"}], "rating": 54.55278071063801, "release_dates": [{"id": 48421, "date": 428371200, "platform": 52, "y": 1983, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 1366299, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scta8r.jpg"}, {"id": 1366300, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scta8s.jpg"}, {"id": 1366301, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scta8t.jpg"}], "slug": "pac-and-pal", "summary": "Pac & Pal is an arcade game that was released by Namco on July 30, 1983 exclusively in Japan. It runs on Namco Super Pac-Man hardware, and the object of the game is for Pac-Man to eat all the items before he is caught by the ghosts. Most of the items are fruits from the original Pac-Man game, with a few new additions. Their value varies, starting with cherries at 50 points, and ending with keys from 700 to 5000 points. The items had to first be unlocked by turning over cards distributed around the maze (instead of eating keys like in Super Pac-Man). Very few cabinets still exist today, and this is possibly one of the rarest Pac-Man titles to find in playable format outside Japan.", "themes": [{"id": 1, "name": "Action"}, {"id": 34, "name": "Educational"}], "url": "https://www.igdb.com/games/pac-and-pal", "collections": [{"id": 2095, "name": "Pac-Man"}]}