mpany": {"id": 14755, "name": "Modus Games"}, "developer": false}], "name": "Teslagrad 2", "platforms": [169, 48, 6, 167, 49, 130], "player_perspectives": [{"id": 4, "name": "Side view"}], "rating": 70.26857826619819, "release_dates": [{"id": 493690, "date": 1681862400, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 493689, "date": 1681862400, "platform": 130, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 493691, "date": 1681862400, "platform": 48, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 493694, "date": 1681862400, "platform": 169, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 493692, "date": 1681862400, "platform": 167, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 493693, "date": 1681862400, "platform": 49, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 863837, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sciijh.jpg"}, {"id": 863838, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sciiji.jpg"}, {"id": 863840, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sciijk.jpg"}, {"id": 863841, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sciijl.jpg"}, {"id": 863839, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sciijj.jpg"}], "slug": "teslagrad-2", "storyline": "A young girl named Lumina finds herself stranded far from home after disaster strikes, cast into a strange and rugged land steeped in Norse and Viking-age myth. Alone in this wild, storm-swept realm of towering mountains, ancient ruins, and looming beasts, she has only her wits and a growing mastery of electromagnetism to see her through. As she journeys across the unfamiliar country in search of a way back, Lumina awakens powerful abilities, learning to command magnetic forces and even teleport through the world around her. Her path is barred by intricate puzzles, treacherous terrain, and formidable guardians that must be outmaneuvered and overcome. Continuing the tale begun in Teslagrad, this sequel follows Lumina deeper into a mysterious folklore-inspired world, where every discovery brings her a step closer to understanding the land she has fallen into and the long road that will carry her home.", "summary": "Teslagrad 2 is the sequel to the original Teslagrad, developed by Rain Games and released in 2023. This 2D puzzle platformer builds upon the magnetic and electrical mechanics of its predecessor, with players once again using these abilities to solve puzzles and traverse complex environments. Set in a new region, the game introduces new powers, enemies, and challenges, while maintaining the visual storytelling and atmospheric design characteristic of the series.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/teslagrad-2", "videos": [{"id": 73745, "name": "Announcement Trailer", "video_id": "-JSXsbzIeDQ", "url": "https://www.youtube.com/watch?v=-JSXsbzIeDQ", "title": "Teslagrad 2 - Announcement Trailer - Future Games Show Gamescom 2022", "thumb": "https://i.ytimg.com/vi/-JSXsbzIeDQ/maxresdefault.jpg"}, {"id": 88017, "name": "Launch Trailer", "video_id": "uT1PMAFd8wQ", "url": "https://www.youtube.com/watch?v=uT1PMAFd8wQ", "title": "Teslagrad 2 - Launch Trailer - Nintendo Switch", "thumb": "https://i.ytimg.com/vi/uT1PMAFd8wQ/maxresdefault.jpg"}], "collections": [{"id": 2634, "name": "Teslagrad"}]}