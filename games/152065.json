, "name": "Fantasy"}], "url": "https://www.igdb.com/games/salt-and-sacrifice", "videos": [{"id": 50605, "name": "Announcement Trailer", "video_id": "ZnBkp9ascxc", "url": "https://www.youtube.com/watch?v=ZnBkp9ascxc", "title": "Salt and Sacrifice - Announcement Trailer | PS5, PS4", "thumb": "https://i.ytimg.com/vi/ZnBkp9ascxc/maxresdefault.jpg"}, {"id": 53901, "name": "Gameplay Trailer", "video_id": "DljZ9-pW8I0", "url": "https://www.youtube.com/watch?v=DljZ9-pW8I0", "title": "Salt & Sacrifice multiplayer gameplay features - Future Games Show GamesCom 2021", "thumb": "https://i.ytimg.com/vi/DljZ9-pW8I0/maxresdefault.jpg"}, {"id": 53900, "name": "Gameplay Trailer", "video_id": "P7cuQRCASCQ", "url": "https://www.youtube.com/watch?v=P7cuQRCASCQ", "title": "Salt and Sacrifice Exclusive Extended Gameplay - Play For All 2021", "thumb": "https://i.ytimg.com/vi/P7cuQRCASCQ/maxresdefault.jpg"}, {"id": 64242, "name": "Release Date Trailer", "video_id": "HJ3Vc66jI2A", "url": "https://www.youtube.com/watch?v=HJ3Vc66jI2A", "title": "Salt and Sacrifice -  Release Date Announce Trailer | PS5, PS4", "thumb": "https://i.ytimg.com/vi/HJ3Vc66jI2A/maxresdefault.jpg"}, {"id": 100180, "name": "Release Date Trailer", "video_id": "UZuIbooK28E", "url": "https://www.youtube.com/watch?v=UZuIbooK28E", "title": "Salt and Sacrifice Release Date Trailer - November 7, 2023 | Steam/Switch", "thumb": "https://i.ytimg.com/vi/UZuIbooK28E/hqdefault.jpg"}], "collections": [{"id": 7379, "name": "Salt"}]}