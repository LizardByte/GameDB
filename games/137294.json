dwide"}}], "screenshots": [{"id": 397588, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8is4.jpg"}, {"id": 397589, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8is5.jpg"}, {"id": 397590, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8is6.jpg"}, {"id": 397591, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8is7.jpg"}, {"id": 551297, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scbtdt.jpg"}, {"id": 551374, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scbtfy.jpg"}], "slug": "the-sims-4-journey-to-batuu", "storyline": "Visit iconic locations from the Star Wars saga as you complete challenges and special missions to tip the balance of power. Every decision your Sims make counts in the grand scheme of a galactic conflict. Who knows, maybe you\u2019ll even find love along the way.\n\nYour Sims are definitely not at home anymore. From the Millennium Falcon to the bustling cantina and unique attire of Batuu, Sims will be surrounded by the iconic sights and sounds of Star Wars.\n\nWhen your Sim returns home, bring back new decor and recipes inspired by your travels, play a game of sabacc, or host a playful lightsaber training session.\n\nEvery adventurous Sim needs a lightsaber and a droid. Collect kyber crystals to construct your unique lightsaber, then head to the Droid Depot to get a trusty companion to accompany you on missions.\n\nBe careful who you trust. Batuu is home to the scruffy and the scheming, the noble and the brave; so choose your allies carefully. First Order, Resistance or Scoundrels - the choice is up to you.\n\nOnce you\u2019ve chosen a faction, complete missions, collect rewards and earn reputation points. Climbing the chain of command by completing missions also begins to introduce new faction contacts like Vi Moradi and Rey.", "summary": "Create your Sim's unique Star Wars story as you explore the remote world of Batuu, from Galaxy's Edge at Disneyland and Disney World, in The Sims 4: Journey to Batuu. Will your Sim join up with the Resistance, fall in with the scoundrels, or enlist with the First Order? It's up to you! Build up your Sim's reputation to unlock missions, purchase a lightsaber or droid, and meet iconic Star Wars characters like Rey and Kylo Ren.", "themes": [{"id": 17, "name": "Fantasy"}, {"id": 27, "name": "Comedy"}, {"id": 33, "name": "Sandbox"}, {"id": 44, "name": "Romance"}], "url": "https://www.igdb.com/games/the-sims-4-journey-to-batuu", "videos": [{"id": 52673, "name": "Gameplay Trailer", "video_id": "oe5N_0TQOkM", "url": "https://www.youtube.com/watch?v=oe5N_0TQOkM", "title": "The Sims\u2122 4 Star Wars\u2122: Journey to Batuu | Official Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/oe5N_0TQOkM/maxresdefault.jpg"}, {"id": 52671, "name": "Announcement Trailer", "video_id": "A4swl1VObu8", "url": "https://www.youtube.com/watch?v=A4swl1VObu8", "title": "The Sims 4 Star Wars: Journey to Batuu | Official Reveal Trailer", "thumb": "https://i.ytimg.com/vi/A4swl1VObu8/maxresdefault.jpg"}], "collections": [{"id": 61, "name": "The Sims"}]}