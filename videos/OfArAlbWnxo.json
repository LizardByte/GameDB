n\u041a\u0440\u0435\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0430\u043a\u0448\u043d: RE+ARRANGE\n\n\u0420\u0435\u0436\u0438\u0441\u0441\u0451\u0440: \u0414\u0430\u0448\u0430 \u041f\u0440\u0438\u0431\u0438\u0449\u0443\u043a\n\u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440-\u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a: Untitled Unknown\nC\u0446\u0435\u043d\u0430\u0440\u0438\u0441\u0442: \u0424\u0438\u043b\u0438\u043f\u043f \u0418\u0432\u0430\u043d\u043e\u0432\n\n\u041f\u043e\u0441\u0442-\u043f\u0440\u043e\u0434\u0430\u043a\u0448\u043d \u043f\u0440\u043e\u0434\u044e\u0441\u0435\u0440: \u041f\u0430\u0432\u0435\u043b \u0427\u0443\u0433\u0443\u043d\u043e\u0432\n\u041b\u0438\u043d\u0435\u0439\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u044e\u0441\u0435\u0440: \u0414\u0435\u043c\u043e\u043d\n\u0410\u0441\u0441\u0438\u0441\u0442\u0435\u043d \u043b\u0438\u043d\u0435\u0439\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0434\u044e\u0441\u0435\u0440\u0430: Maxim Rodzevich\n\u041f\u0440\u043e\u0434\u044e\u0441\u0435\u0440 \u0441\u044a\u0435\u043c\u043a\u0438: Katya Yukka\n\n\u041a\u0440\u0435\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u0438 \u0430\u0440\u0442-\u0434\u0438\u0440\u0435\u043a\u0448\u043d: \u0414\u0430\u0448\u0430 \u041f\u0440\u0438\u0431\u0438\u0449\u0443\u043a, \u0424\u0435\u0434\u044f \u0421\u0443\u0431\u0431\u043e\u0442\u0438\u043d\n3D \u0414\u0436\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0441\u0442: \u041c\u0438\u0445\u0430\u0438\u043b \u0424\u0438\u043b\u0430\u0442\u043a\u0438\u043d (3d.bariga)\n3D \u0414\u0436\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0441\u0442: \u0410\u043d\u0434\u0440\u043e\u0438\u0434\nCG \u0414\u0436\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0441\u0442: \u0414\u0430\u043d\u0438\u0438\u043b \u0421\u043e\u0440\u043e\u043a\u0438\u043d (rosh111r)\n\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u043d\u0430\u044f \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u043a\u0430\u0442 \u0441\u0446\u0435\u043d: \u0415\u0433\u043e\u0440 \u0411\u0430\u0441\u044e\u0431\u0438\u043d (goofiebeing)\n\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u043d\u0430\u044f \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u043a\u0430\u0442 \u0441\u0446\u0435\u043d: \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044f \u041f\u0430\u043a\u0441\u0435\u0435\u0432\u0430\n\u041b\u0438\u0434 \u043f\u043e \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u0430\u043c: \u041c\u0438\u0445\u0430\u0438\u043b \u041f\u0430\u0432\u043b\u043e\u0432\u0438\u0447 \u0422\u0435\u0440\u0435\u043d\u0442\u044c\u0435\u0432\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043f\u043e \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u0430\u043c: \u0414\u0438\u043d\u0438\u0441 (confusion.totale)\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043f\u043e \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u0430\u043c: \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 (_baldgold)\n\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a-\u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a: \u0414\u0430\u0448\u0430 \u041d\u0430\u0437\u0430\u0440\u043e\u0432\u0430\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a-\u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a: \u0415\u0432\u0433\u0435\u043d\u0438\u0439 \u0414\u043c\u0438\u0442\u0440\u0438\u0435\u0432\u0438\u0447 \u041c\u0435\u0442\u0435\u043b\u0430\n\u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440: \u0414\u0430\u043d\u0438\u044d\u043b\u0430 \u041c\u0430\u0434\u0436\u0443\u0433\u0430\n\u0410\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u043e\u0440: \u041d\u0430\u0441\u0442\u0430\u0441\u044c\u044f \u0412\u0435\u0440\u043d\u0438\u043a\u043e\u0432\u0441\u043a\u0430\u044f\n\n\u041b\u0438\u0434 \u043f\u043e \u0441\u043a\u0443\u043b\u044c\u043f\u0442\u0438\u043d\u0433\u0443 \u043b\u0438\u0446, SFX: \u0414\u0430\u0448\u0430 \u0420\u044b\u043a\u043e\u0432\u0430\n\u0421\u043a\u0443\u043b\u044c\u043f\u0442\u0438\u043d\u0433: \u041a\u0430\u0442\u044f \u0417\u0433\u0443\u0449\u0435\u043d\u043a\u0430\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043f\u043e \u043c\u0430\u043a\u0438\u044f\u0436\u0443: \u0418\u0440\u0430 \u0413\u0440\u0430\u0447\u0435\u0432\u0430\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043f\u043e \u0432\u043e\u043b\u043e\u0441\u0430\u043c: \u0414\u0438\u043c\u0430 \u0410\u0431\u0440\u0430\u043c\u043e\u0432\u0438\u0447\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043f\u043e \u043a\u043e\u0441\u0442\u044e\u043c\u0430\u043c: \u041b\u0438\u0437\u0430 \u0414\u0435\u0440\u0435\u0432\u044f\u0433\u0438\u043d\u0430\n\u0421\u0443\u043f\u0435\u0440\u0432\u0430\u0439\u0437\u0435\u0440 \u043f\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430\u043c: \u0417\u0430\u0443\u0440\u0447\u0438\u043a\n\n\u0420\u0435\u0436\u0438\u0441\u0441\u0435\u0440 \u043c\u043e\u043d\u0442\u0430\u0436\u0430: \u0412\u043b\u0430\u0434 \u0427\u0438\u043a\u0430\u0440\u0435\u0432\u0441\u043a\u0438\u0439\n\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043c\u043e\u043d\u0442\u0430\u0436: aaktor\n\u0426\u0432\u0435\u0442\u043e\u043a\u043e\u0440\u0440\u0435\u043a\u0446\u0438\u044f: \u0412\u043b\u0430\u0434 \u0421\u0430\u0432\u0435\u0434\u0435\u0440\u043a\u0438\u043d\n\n\u041b\u0438\u0434 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: SHULYA\n\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: \u041d\u0438\u043a\u0438\u0442\u0430 \u0413\u0440\u043e\u043c\u043e\u0432\n\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: \u0410\u0440\u0441\u0435\u043d\u0438\u0439 \u0416\u043c\u0443\u0440\u043e\u0432 (P4TK)\n\u041c\u043e\u0443\u0448\u043d-\u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: aaktor\n\n\u0410\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u044f \u043c\u0443\u0437\u044b\u043a\u0438 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0430\u043a\u0448\u043d: 1a1e\n\u041b\u0438\u0434 \u0441\u0430\u0443\u043d\u0434-\u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: \u0418\u0432\u0430\u043d \u0416\u0435\u0440\u0431\u0438\u043d (Djeanzh)\nUI \u0441\u0430\u0443\u043d\u0434-\u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440: \u0410\u043d\u044f \u041f\u0440\u0430\u0432\u0434\u0430\n\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u043a\u043e\u043c\u0438\u043a\u0441\u043e\u0432: \u0422\u0430\u0438\u0441\u0438\u044f \u0413\u043e\u0440\u044b\u043d\u044f\n\u0425\u0443\u0434\u043e\u0436\u043d\u0438\u043a \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043a\u043e\u043c\u0438\u043a\u0441\u043e\u0432: \u0415\u0432\u0433\u0435\u043d\u0438\u0439 \u0417\u0430\u0440\u0443\u0434\u043d\u044f\u043a \n\n\u041c\u0435\u043d\u0435\u0434\u0436\u043c\u0435\u043d\u0442 \u0430\u0440\u0442\u0438\u0441\u0442\u0430: \u0412\u0438\u0442\u0430\u043b\u0438\u0439 \u0411\u0435\u043b\u043e\u0432, \u0412\u0430\u043b\u0435\u0440\u0438\u044f \u0414\u044b\u043a\u0438\u043d\u0430"}}}