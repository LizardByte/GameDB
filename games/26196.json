", "uid": "731490", "url": "https://store.steampowered.com/app/731490", "external_game_source": {"id": 1, "name": "Steam"}}], "franchises": [{"id": 1351, "name": "Crash Bandicoot"}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 8, "name": "Platform"}, {"id": 31, "name": "Adventure"}], "involved_companies": [{"id": 63307, "company": {"id": 741, "name": "Toys for Bob"}, "developer": false}, {"id": 63305, "company": {"id": 66, "name": "Activision"}, "developer": false}, {"id": 261187, "company": {"id": 72, "name": "Vicarious Visions"}, "developer": true}], "name": "Crash Bandicoot N. Sane Trilogy", "platforms": [48, 6, 49, 130], "player_perspectives": [{"id": 2, "name": "Third person"}], "rating": 81.75916344618342, "release_dates": [{"id": 102272, "date": 1498780800, "platform": 48, "y": 2017, "release_region": {"id": 1, "region": "europe"}}, {"id": 116997, "date": 1501718400, "platform": 48, "y": 2017, "release_region": {"id": 5, "region": "japan"}}, {"id": 102271, "date": 1498780800, "platform": 48, "y": 2017, "release_region": {"id": 2, "region": "north_america"}}, {"id": 152363, "date": 1530230400, "platform": 6, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 580902, "date": 1530230400, "platform": 130, "y": 2018, "release_region": {"id": 1, "region": "europe"}}, {"id": 580901, "date": 1530230400, "platform": 130, "y": 2018, "release_region": {"id": 2, "region": "north_america"}}, {"id": 580903, "date": 1539820800, "platform": 130, "y": 2018, "release_region": {"id": 5, "region": "japan"}}, {"id": 152364, "date": 1530230400, "platform": 49, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1286526, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scrkou.jpg"}, {"id": 1286527, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scrkov.jpg"}, {"id": 1290394, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scrnoa.jpg"}, {"id": 1286528, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scrkow.jpg"}, {"id": 1290393, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scrno9.jpg"}], "slug": "crash-bandicoot-n-sane-trilogy", "storyline": "Crash Bandicoot, an anthropomorphic marsupial, faces off against the villainous Doctor Neo Cortex and his henchmen across three adventures. In the first game, Crash must rescue his girlfriend Tawna from Cortex's island fortress. In the sequel, Cortex manipulates Crash into collecting crystals under false pretenses, and in the third, Crash and his sister Coco travel through time to gather powerful crystals before Cortex can use them to dominate the world.", "summary": "Crash Bandicoot N. Sane Trilogy is a platform game compilation that remasters the first three entries in the Crash Bandicoot series: Crash Bandicoot (1996), Cortex Strikes Back (1997), and Warped (1998). Players control Crash or his sister Coco through linear 3D levels, spinning to defeat enemies, jumping across platforms, and breaking crates to collect Wumpa Fruit. The compilation features completely rebuilt visuals with enhanced lighting and textures, a re-orchestrated soundtrack, time trials with online leaderboards, and a unified save system across all three games. Originally developed without access to the original source code, the games were reconstructed nearly from scratch using polygon meshes and cross-referencing video footage of the originals.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 22, "name": "Historical"}], "url": "https://www.igdb.com/games/crash-bandicoot-n-sane-trilogy", "videos": [{"id": 14641, "name": "E3 2017 Launch Trailer", "video_id": "AvK197_CP0Q", "url": "https://www.youtube.com/watch?v=AvK197_CP0Q", "title": "Crash Bandicoot N. Sane Trilogy - E3 2017 Launch Trailer (Official)", "thumb": "https://i.ytimg.com/vi/AvK197_CP0Q/maxresdefault.jpg"}, {"id": 11148, "name": "Trailer", "video_id": "F7G91RjVmvk", "url": "https://www.youtube.com/watch?v=F7G91RjVmvk", "title": "Crash Bandicoot N. Sane Trilogy - PlayStation Experience 2016: The Come Back Trailer | PS4", "thumb": "https://i.ytimg.com/vi/F7G91RjVmvk/maxresdefault.jpg"}, {"id": 20898, "name": "Trailer", "video_id": "53L6P1XB_GU", "url": "https://www.youtube.com/watch?v=53L6P1XB_GU", "title": "Nintendo Switch Launch Trailer | Crash Bandicoot N. Sane Trilogy", "thumb": "https://i.ytimg.com/vi/53L6P1XB_GU/maxresdefault.jpg"}]}