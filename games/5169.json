: {"id": 3, "region": "australia"}}, {"id": 946701, "date": 1227139200, "platform": 12, "y": 2008, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 173262, "url": "//images.igdb.com/igdb/image/upload/t_thumb/gutdg1wyavytpzatxecd.jpg"}, {"id": 173263, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dups1f6syfawran5chdu.jpg"}, {"id": 173261, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mzl5ppz8az1el5wd5pkh.jpg"}, {"id": 173260, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ux5yvtduv8jydqp7vgg0.jpg"}, {"id": 173257, "url": "//images.igdb.com/igdb/image/upload/t_thumb/g2c8ak7iqzpjoj0vnfoj.jpg"}, {"id": 26699, "url": "//images.igdb.com/igdb/image/upload/t_thumb/uueqhjieekguhjxw6mnb.jpg"}, {"id": 173259, "url": "//images.igdb.com/igdb/image/upload/t_thumb/wrwzu9c1p4qv9eeqqo4z.jpg"}, {"id": 173258, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cvql2coskbhvbu4sj1pt.jpg"}], "slug": "sonic-unleashed", "storyline": "An installment in the long-running Sonic the Hedgehog series, Sonic Unleashed opens with the hero's archenemy, Doctor Eggman, springing an elaborate trap. Using a powerful laser, Eggman shatters the very planet into pieces and awakens Dark Gaia, an ancient evil that has slumbered at the world's core since time immemorial. The catastrophe leaves its mark on Sonic himself, afflicting him with a strange new condition that transforms him into a hulking, werewolf-like Werehog whenever night falls. Determined to undo the damage and stop Eggman's scheme, Sonic sets out to restore the broken world piece by piece. His journey carries him across a series of continents inspired by real-world locales, where by day he races through levels at his trademark blistering speed, and by night he battles the creatures spawned by Dark Gaia using the Werehog's raw strength. Torn between his two forms, Sonic must piece the planet back together before the awakened darkness consumes it entirely.", "summary": "Gameplay in Sonic Unleashed focuses on two modes of platforming play: fast-paced levels that take place during daytime, showcasing Sonic's trademark speed as seen in previous games in the series, and slower, night-time levels, during which Sonic's Werehog form emerges, and gameplay switches to an action-based, brawler style of play, in which Sonic battles Gaia enemies", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/sonic-unleashed", "videos": [{"id": 173399, "name": "Gameplay Trailer", "video_id": "08jRnqxm9vw", "url": "https://www.youtube.com/watch?v=08jRnqxm9vw", "title": "Sonic Unleashed Gameplay Trailer #1", "thumb": "https://i.ytimg.com/vi/08jRnqxm9vw/hqdefault.jpg"}, {"id": 181925, "name": "Gameplay Trailer", "video_id": "sIDvXPr_N9g", "url": "https://www.youtube.com/watch?v=sIDvXPr_N9g", "title": "Sonic Unleashed", "thumb": "https://i.ytimg.com/vi/sIDvXPr_N9g/hqdefault.jpg"}, {"id": 181928, "name": "Trailer", "video_id": "UNwVpxjMRQc", "url": "https://www.youtube.com/watch?v=UNwVpxjMRQc", "title": "Sonic Unleashed Day/Night", "thumb": "https://i.ytimg.com/vi/UNwVpxjMRQc/hqdefault.jpg"}, {"id": 182027, "name": "Teaser", "video_id": "KIAOd3Y34Pw"}, {"id": 181926, "name": "Gameplay Trailer", "video_id": "m9een030mWc", "url": "https://www.youtube.com/watch?v=m9een030mWc", "title": "Sonic Unleashed - Gameplay Trailer #3", "thumb": "https://i.ytimg.com/vi/m9een030mWc/hqdefault.jpg"}, {"id": 181927, "name": "Launch Trailer", "video_id": "lgXxz4C-Kuo", "url": "https://www.youtube.com/watch?v=lgXxz4C-Kuo", "title": "Sonic Unleashed - Next Gen - Launch Trailer", "thumb": "https://i.ytimg.com/vi/lgXxz4C-Kuo/hqdefault.jpg"}, {"id": 181929, "name": "Gameplay Trailer", "video_id": "XXRMpsKJAZ8", "url": "https://www.youtube.com/watch?v=XXRMpsKJAZ8", "title": "Sonic Unleashed - Next-Gen - Mazuri", "thumb": "https://i.ytimg.com/vi/XXRMpsKJAZ8/hqdefault.jpg"}, {"id": 181930, "name": "Gameplay Trailer", "video_id": "7uoWG66YIBE", "url": "https:/