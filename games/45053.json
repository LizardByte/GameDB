n"}, {"id": 22, "name": "Historical"}], "url": "https://www.igdb.com/games/samurai-shodown-warriors-rage", "videos": [{"id": 151930, "name": "Gameplay Video", "video_id": "bVhax6NOuxo", "url": "https://www.youtube.com/watch?v=bVhax6NOuxo", "title": "PSX Longplay [266] Samurai Shodown: Warriors Rage", "thumb": "https://i.ytimg.com/vi/bVhax6NOuxo/sddefault.jpg"}], "collections": [{"id": 2223, "name": "Samurai Shodown"}]}