ch the prosecutor presents his theory of the case as a song. Players hear testimony one line at a time, probe the statements, rebut them with evidence, and fill in the blanks of the Record with words gathered in court. Each completed line becomes a lyric, and the defense reworks the prosecutor's lyrics into its own deduction and sings it. The story is told in episodes, each one a single case.", "themes": [{"id": 27, "name": "Comedy"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/singing-attorney-verdict-by-midnight", "videos": [{"id": 202882, "name": "Trailer", "video_id": "qDVyhAR9EKA", "url": "https://www.youtube.com/watch?v=qDVyhAR9EKA", "title": "Singing Attorney: Verdict by Midnight \u2013 Trailer (85s) | Musical courtroom mystery adventure", "thumb": "https://i.ytimg.com/vi/qDVyhAR9EKA/maxresdefault.jpg"}, {"id": 202883, "name": "Teaser", "video_id": "BPMI8Jxmx3A", "url": "https://www.youtube.com/watch?v=BPMI8Jxmx3A", "title": "Singing Attorney: Verdict by Midnight \u2013 Trailer (32s) | Musical courtroom mystery adventure", "thumb": "https://i.ytimg.com/vi/BPMI8Jxmx3A/maxresdefault.jpg"}], "game_localizations": [{"id": 64020, "cover": {"id": 626806, "url": "//images.igdb.com/igdb/image/upload/t_thumb/codfna.jpg"}, "region": {"id": 2, "name": "Korea", "category": "locale", "identifier": "ko-KR"}}, {"id": 64019, "cover": {"id": 626805, "url": "//images.igdb.com/igdb/image/upload/t_thumb/codfn9.jpg"}, "region": {"id": 3, "name": "Japan", "category": "locale", "identifier": "ja-JP"}}]}