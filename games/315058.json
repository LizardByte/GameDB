: {"id": 8, "region": "worldwide"}}, {"id": 901598, "date": 1763424000, "platform": 167, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1389552, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6o.jpg"}, {"id": 1389553, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6p.jpg"}, {"id": 1389554, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6q.jpg"}, {"id": 1389556, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6s.jpg"}, {"id": 1389557, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6t.jpg"}, {"id": 1389555, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scts6r.jpg"}], "slug": "mysims-cozy-bundle", "storyline": "MySims: Cozy Bundle brings together the stories of *MySims* and *MySims Kingdom*, each centred on restoring and improving communities through creativity and exploration.\n\nIn MySims, the player arrives in a struggling town and works to rebuild it by constructing buildings, attracting new residents, and fulfilling requests from its inhabitants. As the town develops, new areas, characters, and activities become available, gradually transforming it into a thriving community.\n\nIn MySims Kingdom, the player travels across a series of regions within a magical land, assisting various characters with local problems. By completing tasks and solving environmental challenges, the player helps restore order and improve each location. Across both stories, progression is driven by interacting with characters, completing objectives, and expanding the world through construction and customization.", "summary": "A bundle containing MySims and MySims Kingdom.", "themes": [{"id": 35, "name": "Kids"}], "url": "https://www.igdb.com/games/mysims-cozy-bundle", "videos": [{"id": 124659, "name": "Trailer", "video_id": "CDT5kxDL15U", "url": "https://www.youtube.com/watch?v=CDT5kxDL15U", "title": "MySims \u2013 Cozy Bundle Trailer \u2013 Nintendo Switch", "thumb": "https://i.ytimg.com/vi/CDT5kxDL15U/maxresdefault.jpg"}, {"id": 168854, "name": "Launch Trailer", "video_id": "J-anrfo-870", "url": "https://www.youtube.com/watch?v=J-anrfo-870", "title": "MySims: Cozy Bundle - Launch Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/J-anrfo-870/maxresdefault.jpg"}]}