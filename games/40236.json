 [{"id": 1834107, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13b7f.jpg"}, {"id": 1834108, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13b7g.jpg"}, {"id": 1834109, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13b7h.jpg"}, {"id": 1834106, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13b7e.jpg"}], "slug": "kitten-kaboodle", "summary": "Kitten Kaboodle was produced by Konami in 1988.\n\nThe game lets the player control a cat as it searches each stage trying to find four hidden keys. The stages are filled with enemies that can be defeated by pushing blocks into them. Blocks can also be jumped over if they get in the way. There are also special blocks that when three of the same kind are lined up it will cause an effect to happen such as clearing the screen of every enemy on it or giving the player temporary invulnerability. Enemies can drop valuables which increase the players points and in turn these points can be spent at a shop which sells various items like running shoes and bombs.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/kitten-kaboodle"}