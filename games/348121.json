, "slug": "lord-of-metal--1", "summary": "Lord of Metal is a single player story-driven management simulator game about organizing Rock music festivals bringing a dystopian world back to life. Gather your crew, book bands, sign sponsors, claim festival grounds and bring some Rock to the masses!\n\nIn Lord of Metal, you're a disciple of the almighty Metal God, tasked with reviving the world's passion for hard rock and metal. To achieve your goal, you need to host festivals going from small roadside gigs to mega events for thousands of fans.\n\nGet \u2018under the hood\u2019 of heavy music industry: gather your crew, book bands, land sponsors, build & manage fests and make decisions that matter. Travel the vibrant world of the game and enjoy the stories and mechanics based on real music industry experience brought to you by pros.", "themes": [{"id": 28, "name": "Business"}], "url": "https://www.igdb.com/games/lord-of-metal--1", "videos": [{"id": 153062, "name": "Trailer", "video_id": "dqx6aZmjd18", "url": "https://www.youtube.com/watch?v=dqx6aZmjd18", "title": "Lord of Metal: Lord of Metal: A Deep Dive into the World of the Game", "thumb": "https://i.ytimg.com/vi/dqx6aZmjd18/maxresdefault.jpg"}]}