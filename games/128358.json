{"id": 128358, "artworks": [{"id": 297395, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6dgz.jpg"}], "cover": {"id": 588945, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cocmfl.jpg"}, "external_games": [{"id": 1869566, "name": "Warblade", "uid": "6580", "url": "https://www.twitch.tv/directory/game/Warblade", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 150475, "name": "Warblade", "uid": "7199", "url": "https://www.giantbomb.com/games/3030-7199/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 5, "name": "Shooter"}, {"id": 33, "name": "Arcade"}], "involved_companies": [{"id": 90376, "company": {"id": 23409, "name": "EMV Software"}, "developer": true}], "multiplayer_modes": [{"id": 43654, "campaigncoop": false, "dropin": false, "game": 128358, "lancoop": false, "offlinecoop": true, "offlinecoopmax": 2, "onlinecoop": false, "platform": 6, "splitscreen": false, "checksum": "f2747b3c-872c-98f9-30f1-f993154cdd74"}], "name": "Warblade", "platforms": [6, 39, 14], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 185185, "date": 1270598400, "platform": 14, "y": 2010, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 185186, "date": 1276214400, "platform": 39, "y": 2010, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 947643, "date": 1071187200, "platform": 6, "y": 2003, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 351957, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jkl.jpg"}, {"id": 351959, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jkn.jpg"}, {"id": 351961, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jkp.jpg"}, {"id": 351956, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jkk.jpg"}, {"id": 351960, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jko.jpg"}, {"id": 351958, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7jkm.jpg"}], "slug": "warblade", "storyline": "Guide your ship through waves of alien attackers. Shoot and destroy all enemies. Look out for kamikaze attackers and meteor storms.\n\nGet extra weapons for a better ship and a higher score.\n\nLook out for enemy secrets and try and find all the hidden bonuses.", "summary": "Warblade is a shareware computer game for Microsoft Windows and OS X, written by Norwegian developer Edgar M. Vigdal. The Windows version runs well on Linux under Wine. It is also available for retail in the App Store for iOS devices (in iPhone/iPod Touch and iPad versions). The game is a 2D space shooter in the vein of the perennial classic Galaga. It is a rewrite and modernization of a popular Amiga shareware game, Deluxe Galaga, which was written by the same author back in the mid-1990s. Where technically possible, the graphics and sounds are respectful to their Amiga origins.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/warblade", "videos": [{"id": 33015, "name": "Gameplay video", "video_id": "omeG8wamu3w", "url": "https://www.youtube.com/watch?v=omeG8wamu3w", "title": "Warblade - Full Gameplay (100 Levels) On Normal [With Profile & Secrets]", "thumb": "https://i.ytimg.com/vi/omeG8wamu3w/maxresdefault.jpg"}]}