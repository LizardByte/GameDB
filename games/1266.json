 1353628800, "platform": 6, "y": 2012, "release_region": {"id": 1, "region": "europe"}}, {"id": 68649, "date": 1356048000, "platform": 6, "y": 2012, "release_region": {"id": 5, "region": "japan"}}, {"id": 107340, "date": 1351641600, "platform": 9, "y": 2012, "release_region": {"id": 1, "region": "europe"}}, {"id": 107339, "date": 1351555200, "platform": 9, "y": 2012, "release_region": {"id": 2, "region": "north_america"}}, {"id": 68643, "date": 1354924800, "platform": 41, "y": 2012, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 1336, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mazwxafpn4trr1egmj7j.jpg"}, {"id": 1335, "url": "//images.igdb.com/igdb/image/upload/t_thumb/fjsea0ufemtie04czf9m.jpg"}, {"id": 1337, "url": "//images.igdb.com/igdb/image/upload/t_thumb/nyy6injtxg9grtmuoa1m.jpg"}, {"id": 1339, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ccfvfvn8w5ucmtaw9uu2.jpg"}, {"id": 5358, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lwbc2mifimzfmyxt6r56.jpg"}, {"id": 152242, "url": "//images.igdb.com/igdb/image/upload/t_thumb/okyz7qmbwrbqr7s3yxsh.jpg"}, {"id": 152245, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tjocflec2doowuhlgt3b.jpg"}, {"id": 152248, "url": "//images.igdb.com/igdb/image/upload/t_thumb/umu9a0ptzj84rdzc5wa0.jpg"}, {"id": 152244, "url": "//images.igdb.com/igdb/image/upload/t_thumb/aghxxmr2mpygyq5ftldb.jpg"}, {"id": 152247, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mlynnq49vemvljigsx79.jpg"}, {"id": 152246, "url": "//images.igdb.com/igdb/image/upload/t_thumb/jmyedumbxkdyfudgzaay.jpg"}, {"id": 152243, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ok2u0qqlarohz7rx8eo7.jpg"}], "slug": "assassin-s-creed-iii", "storyline": "In 1754, British Templar Haytham Kenway travels to the American colonies to locate an ancient temple for his Order. He recruits allies and falls in love with a Mohawk woman named Kaniehti:io while eliminating a rogue associate. Years later, their son Ratonhnhak\u00e9:ton witnesses his mother's death during an attack on their village and grows up to become the Assassin known as Connor, trained by the retired Assassin Achilles Davenport. Connor is drawn into the American Revolution as he hunts down the Colonial Templars, who include his own father. Over the course of two decades, Connor eliminates Haytham's allies, uncovers that his mother's death was ordered by George Washington rather than the Templars, and is eventually forced to confront and kill Haytham himself. In the modern day, Desmond Miles uses Connor's memories to locate a key that opens the inner chambers of a precursor temple, ultimately sacrificing himself to activate a device that protects Earth from a catastrophic solar flare.", "summary": "Assassin's Creed III is an open-world action-adventure game set primarily in 18th-century Colonial America during the American Revolution. Players control two characters across the story: Haytham Kenway, a British Templar operating during the French and Indian War, and his half-Mohawk son Ratonhnhak\u00e9:ton (also known as Connor), who becomes an Assassin. Gameplay takes place across Boston, New York City, and a large wilderness frontier, with free-running, stealth, and combat using weapons including tomahawks, muskets, bows, and the series' signature Hidden Blades. The game introduces naval combat through Connor's captaining of a warship, as well as hunting, a homestead economy system, and seasonal weather that affects gameplay. A modern-day framing narrative follows Desmond Miles using the Animus to relive his ancestors' memories.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 22, "name": "Historical"}, {"id": 23, "name": "Stealth"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/assassin-s-creed-iii", "videos": [{"id": 3084, "name": "Connor Story Trailer", "video_id": "ls-J1pbTKyQ", "url": "https://www.youtube.com/watch?v=ls-J1pbTKyQ", "title": "Assassin's Creed III - Connor Story Trailer (Official)", "thumb": "https://i.ytimg.com/vi/ls-J1pbTKyQ/maxresdefault.jpg"}, {"id": 3085, "name": "E3 Trailer", "video_id": "GdSmH0CxJ4o", "url": "https://www.youtube.com/watch?v=GdSmH0CxJ4o", "title": "Assassin's Creed III - E3 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/GdSmH0CxJ4o/maxresdefault.jpg"}, {"id": 3086, "name": "Launch Trailer", "video_id": "19rfT-6aI8k", "url": "https://www.youtube.com/watch?v=19rfT-6aI8k", "title": "Assassin's Creed III - Launch Trailer (Official)", "thumb": "https://i.ytimg.com/vi/19rfT-6aI8k/maxresdefault.jpg"}, {"id": 119990, "name": "Gameplay Demo", "video_id": "TpBL-g9-Ss4", "url": "https://www.youtube.com/watch?v=TpBL-g9-Ss4", "title": "Assassin's Creed 3 Naval Warfare Gameplay - Sony E3 2012 Press Conference", "thumb": "https://i.ytimg.com/vi/TpBL-g9-Ss4/sddefault.jpg"}], "collections": [{"id": 18, "name": "Assassin's Creed"}]}