t_thumb/sc15fz8.jpg"}, {"id": 1933605, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fz9.jpg"}, {"id": 1933615, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzj.jpg"}, {"id": 1933606, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fza.jpg"}, {"id": 1933607, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzb.jpg"}, {"id": 1933608, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzc.jpg"}, {"id": 1933609, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzd.jpg"}, {"id": 1933610, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fze.jpg"}, {"id": 1933611, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzf.jpg"}, {"id": 1933612, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzg.jpg"}, {"id": 1933613, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzh.jpg"}, {"id": 1933614, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzi.jpg"}, {"id": 1933616, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzk.jpg"}, {"id": 1933617, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzl.jpg"}, {"id": 1933618, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15fzm.jpg"}], "slug": "fatenames", "summary": "Fatenames is a team-based word deduction party game played online. Two teams, Red and Blue, race to find their own words on a shared board of cards. Each team has a Fateweaver, who sees the board's key and gives one-word clues with a number, and Seekers, who talk each clue over, point at cards and reveal the ones they believe belong to their team. Every board also hides a disaster card, the eclipse, and the team that reveals it loses on the spot.\n\nLobbies are joined with a code and hold up to 30 players, with 4x4, 5x5 or 6x6 boards, several word packs or a custom word list, and adjustable turn timers. Matches earn XP toward 100 levels that unlock cosmetics such as name colors, avatar auras and frames, animated profile cards and card backs. Every finished match is saved with a step-by-step replay, players are ranked on a global leaderboard, and the interface is available in English, Spanish, French, Chinese and Hindi.", "themes": [{"id": 40, "name": "Party"}], "url": "https://www.igdb.com/games/fatenames", "videos": [{"id": 197793, "name": "Trailer", "video_id": "-xjHeExaokI", "url": "https://www.youtube.com/watch?v=-xjHeExaokI", "title": "Fatenames | Official Trailer", "thumb": "https://i.ytimg.com/vi/-xjHeExaokI/maxresdefault.jpg"}]}