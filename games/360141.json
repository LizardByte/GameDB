}, {"id": 783012, "date": 1754524800, "platform": 48, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 783014, "date": 1754524800, "platform": 49, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 783013, "date": 1754524800, "platform": 167, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 783015, "date": 1754524800, "platform": 169, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1607102, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1q.jpg"}, {"id": 1607103, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1r.jpg"}, {"id": 1607104, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1s.jpg"}, {"id": 1607105, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1t.jpg"}, {"id": 1607106, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1u.jpg"}, {"id": 1607107, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1v.jpg"}, {"id": 1607108, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1w.jpg"}, {"id": 1607109, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1x.jpg"}, {"id": 1607110, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyg1y.jpg"}], "slug": "heretic-plus-hexen", "storyline": "Step into the definitive re-release of two dark spell-casting shooters that shaped the genre.\n\nForged by Raven Software on a modified DOOM engine, Heretic and Hexen were released in 1994 and 1995, pushing first person shooters into bold new territory. These innovative cult classics introduced groundbreaking features like inventory systems, vertical aiming, and distinct character classes, reshaping first person action games for generations to come. This enhanced restoration makes Heretic Hexen available to new audiences and long-time fans with expanded accessibility across more platforms and languages than ever before. Whether you're returning to these shadowy realms or discovering them for the first time, an epic legacy awaits.", "summary": "Heretic + Hexen is a remastered version of the games Heretic: Shadow of the Serpent Riders, Hexen: Beyond Heretic and Deathkings of the Dark Citadel. It includes quality of life improvements (native widescreen, engine fixes, interface tweaks...), reworked local and online multiplayer, as well as new episodes - Heretic: Faith Renewed and Hexen: Vestiges of Grandeur.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/heretic-plus-hexen", "videos": [{"id": 158426, "name": "Launch Trailer", "video_id": "jnzow2f3Rt4", "url": "https://www.youtube.com/watch?v=jnzow2f3Rt4", "title": "Heretic + Hexen Official Launch Trailer (4K) | Now Available", "thumb": "https://i.ytimg.com/vi/jnzow2f3Rt4/maxresdefault.jpg"}], "collections": [{"id": 176, "name": "Heretic"}, {"id": 6002, "name": "Hexen"}]}