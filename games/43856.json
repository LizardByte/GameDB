{"id": 43856, "age_ratings": [{"id": 15429, "organization": {"id": 1, "name": "ESRB"}, "rating_category": {"id": 3, "rating": "E"}}], "artworks": [{"id": 258013, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j31.jpg"}, {"id": 258010, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j2y.jpg"}, {"id": 258011, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j2z.jpg"}], "cover": {"id": 547956, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cobqt0.jpg"}, "external_games": [{"id": 1901832, "name": "Bottom of the 9th '99", "uid": "461547", "url": "https://www.twitch.tv/directory/game/Bottom%20of%20the%209th%20'99", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 113620, "name": "Bottom of the 9th '99", "uid": "47500", "url": "https://www.giantbomb.com/games/3030-47500/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "franchises": [{"id": 325, "name": "MLB"}, {"id": 5567, "name": "MLBPA"}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}, {"id": 4, "name": "Split screen"}], "genres": [{"id": 14, "name": "Sport"}], "involved_companies": [{"id": 375837, "company": {"id": 129, "name": "Konami"}, "developer": false}, {"id": 375838, "company": {"id": 42167, "name": "Konami Computer Entertainment Chicago"}, "developer": true}], "multiplayer_modes": [{"id": 40008, "campaigncoop": false, "dropin": false, "game": 43856, "lancoop": false, "offlinecoop": false, "offlinemax": 2, "onlinecoop": false, "splitscreen": true, "checksum": "003284fb-2007-d59d-a8d5-53d47f28abe9"}], "name": "Bottom of the 9th '99", "platforms": [7], "player_perspectives": [{"id": 2, "name": "Third person"}, {"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 887866, "date": 904521600, "platform": 7, "y": 1998, "release_region": {"id": 2, "region": "north_america"}}, {"id": 887867, "date": 906940800, "platform": 7, "y": 1998, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 887868, "date": 907804800, "platform": 7, "y": 1998, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 1798309, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12jl1.jpg"}], "slug": "bottom-of-the-9th-99", "summary": "BOTTOM OF THE 9TH \u201899 brings all of the action and excitement of professional baseball to the PlayStation. With an MLBPA license, over 700 major league players are included with updated stats, and motion capture technology recreates the nuances of every single player. Get a quick baseball fix by putting your team on the field of 30 stadiums in the Exhibition or Training modes; or discover the pressure being on the mound, up by one run with one out and a man on third, in the Scenario mode. For the most realistic experience, tackle the ups and downs of a season, the playoffs, or a championship series. With the innovative cursor system for batting and pitching, the challenges of hitting a 100 mph fastball are faithfully recreated. The action of BOTTOM OF THE 9TH '99 brings professional baseball to you without having to pay for admission.", "themes": [{"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/bottom-of-the-9th-99", "videos": [{"id": 178374, "name": "Gameplay Video", "video_id": "o6Am1VWkfD0", "url": "https://www.youtube.com/watch?v=o6Am1VWkfD0", "title": "Bottom of the 9th '99 (PlayStation) - Boston Red Sox vs. Atlanta Braves", "thumb": "https://i.ytimg.com/vi/o6Am1VWkfD0/hqdefault.jpg"}], "collections": [{"id": 4133, "name": "Bottom of the 9th"}]}