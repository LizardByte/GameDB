": 163029, "url": "//images.igdb.com/igdb/image/upload/t_thumb/q3pxffjzsj9fvxczxyfo.jpg"}, {"id": 163032, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yvwjpue51htvwwbe8he6.jpg"}, {"id": 163033, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zbi9nyejbtqchclbc07y.jpg"}, {"id": 163034, "url": "//images.igdb.com/igdb/image/upload/t_thumb/kgslhdzszcaouslxpeno.jpg"}, {"id": 24449, "url": "//images.igdb.com/igdb/image/upload/t_thumb/iz1nsuxcxwaddlupx3r0.jpg"}, {"id": 24446, "url": "//images.igdb.com/igdb/image/upload/t_thumb/f9hjabr7gc1njhs65fbw.jpg"}, {"id": 24450, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zrjvtf0pbh6wypvtt9ww.jpg"}, {"id": 24447, "url": "//images.igdb.com/igdb/image/upload/t_thumb/fueeofgqn2a8e0lucmt5.jpg"}], "slug": "kirby-triple-deluxe", "storyline": "One night while Kirby sleeps, a mysterious giant seed falls from the sky and grows into an enormous vine called the Dreamstalk, lifting Kirby's house, Castle Dedede, and much of Dream Land high into the clouds. Waking to the chaos, Kirby heads to the castle only to witness a spidery being named Taranza sweep in and abduct King Dedede, carrying him up into the sky kingdom of Floralia. Kirby gives chase, climbing through six vibrant worlds and battling Taranza's minions to rescue the king and uncover who is truly behind the invasion of Dream Land.", "summary": "A side-scrolling installment in the beloved Kirby series, Kirby: Triple Deluxe uses the 3D features of the Nintendo 3DS to allow Kirby to move not only from left to right, but also from the foreground to the background. Kirby also gets an \u201cinhale everything\u201d ability that can be used in specific parts of each stage to help him clear anything blocking his path. As always, Kirby has the power to inhale his enemies and take on their abilities. Each copy ability can let him do a variety of actions and moves, depending on which buttons are pressed.\n\nKirby: Triple Deluxe includes a huge number of collectibles for players to find, from hidden 8-bit keychains to Sun Stones. The game takes advantage of 3DS StreetPass feature to deliver bonus items to players", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/kirby-triple-deluxe", "videos": [{"id": 1927, "name": "Trailer", "video_id": "rG-FfvIS-kI", "url": "https://www.youtube.com/watch?v=rG-FfvIS-kI", "title": "Kirby Triple Deluxe - Trailer", "thumb": "https://i.ytimg.com/vi/rG-FfvIS-kI/hqdefault.jpg"}], "collections": [{"id": 244, "name": "Kirby"}], "characters": [{"id": 1897, "name": "Voice"}]}