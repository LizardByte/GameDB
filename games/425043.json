{"id": 425043, "artworks": [{"id": 321417, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6w09.jpg"}, {"id": 321418, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6w0a.jpg"}], "cover": {"id": 615853, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cod771.jpg"}, "external_games": [{"id": 3242857, "name": "Dicebloom", "uid": "1731020792", "url": "https://www.twitch.tv/directory/game/Dicebloom", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 3227225, "name": "Dicebloom", "uid": "5391740", "url": "https://store.steampowered.com/app/5391740", "external_game_source": {"id": 1, "name": "Steam"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 15, "name": "Strategy"}, {"id": 16, "name": "Turn-based strategy (TBS)"}, {"id": 32, "name": "Indie"}, {"id": 35, "name": "Card & Board Game"}], "name": "Dicebloom", "screenshots": [{"id": 1961208, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a0.jpg"}, {"id": 1961207, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1619z.jpg"}, {"id": 1961209, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a1.jpg"}, {"id": 1961214, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a6.jpg"}, {"id": 1961210, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a2.jpg"}, {"id": 1961211, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a3.jpg"}, {"id": 1961212, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a4.jpg"}, {"id": 1961213, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc161a5.jpg"}], "slug": "dicebloom", "summary": "Dicebloom is a dice roguelite set in a small garden at twilight. Each roll wakes every plant that carries the face that lands, and a plant that wakes can wake its neighbours: bees fly, seeds land and multipliers grow, so a single roll can ripple across the whole garden. Between days the player buys plants, garden gear and new land at the night market and arranges and rotates them on the field. A run lasts a year of four months with three weeks each; every week ends with a rising debt to pay, and the last week of each month is a challenge with its own rules. The game has 100 plants in 10 categories and 85 pieces of garden gear.", "url": "https://www.igdb.com/games/dicebloom", "videos": [{"id": 200648, "name": "Gameplay Trailer", "video_id": "tG6Al22Rzvk", "url": "https://www.youtube.com/watch?v=tG6Al22Rzvk", "title": "Dicebloom \u2014 Official Trailer | Cozy Dice Roguelite", "thumb": "https://i.ytimg.com/vi/tG6Al22Rzvk/maxresdefault.jpg"}]}