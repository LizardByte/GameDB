{"id": 664741, "date": 1703721600, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 664740, "date": 1703721600, "platform": 3, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 932643, "date": 1798675200, "platform": 167, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 932644, "date": 1798675200, "platform": 130, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1213726, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq0im.jpg"}, {"id": 1213727, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq0in.jpg"}, {"id": 1213728, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq0io.jpg"}, {"id": 1213729, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq0ip.jpg"}, {"id": 1213725, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq0il.jpg"}], "slug": "buckshot-roulette", "storyline": "Set in an underground nightclub in 1998, the player enters a back room where a mysterious entity known as \"The Dealer\" awaits. After signing a General Release of Liability waiver, the two engage in a deadly game of modified Russian roulette using a pump-action shotgun loaded with a mix of live rounds and blanks. As the rounds escalate and items are introduced to shift the odds, a bloody contract surfaces bearing the name \"GOD,\" mirroring the waiver the player signed moments earlier. The stakes grow higher with each round, and in the final confrontation, there are no second chances.", "summary": "Buckshot Roulette is an indie tabletop horror game that reimagines Russian roulette using a pump-action shotgun instead of a revolver. The player faces off against a computer-controlled opponent called \"The Dealer\" across three rounds, with consumable items introduced in later rounds that add strategic depth. The game features a single-player campaign and a multiplayer mode for up to four players.", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/buckshot-roulette", "videos": [{"id": 108104, "name": "Gameplay Video", "video_id": "1yLgIjT9ITo", "url": "https://www.youtube.com/watch?v=1yLgIjT9ITo", "title": "Buckshot Roulette - Play Russian Roulette against a crooked AI dealer in an underground nightclub!", "thumb": "https://i.ytimg.com/vi/1yLgIjT9ITo/maxresdefault.jpg"}, {"id": 109237, "name": "Release Date Trailer", "video_id": "w_JupwzjKLU", "url": "https://www.youtube.com/watch?v=w_JupwzjKLU", "title": "Buckshot Roulette - Official Steam Release Date Trailer", "thumb": "https://i.ytimg.com/vi/w_JupwzjKLU/maxresdefault.jpg"}, {"id": 109277, "name": "Steam Trailer", "video_id": "G3Ge9_RKrkw", "url": "https://www.youtube.com/watch?v=G3Ge9_RKrkw", "title": "Buckshot Roulette - Official Steam Trailer | The MIX x Kinda Funny Spring Showcase 2024", "thumb": "https://i.ytimg.com/vi/G3Ge9_RKrkw/maxresdefault.jpg"}, {"id": 107573, "name": "Launch Trailer", "video_id": "FOBnx1exVeY", "url": "https://www.youtube.com/watch?v=FOBnx1exVeY", "title": "Buckshot Roulette - Release Trailer", "thumb": "https://i.ytimg.com/vi/FOBnx1exVeY/maxresdefault.jpg"}, {"id": 141264, "name": "Trailer", "video_id": "GiCH_b6LqdU", "url": "https://www.youtube.com/watch?v=GiCH_b6LqdU", "title": "Buckshot Roulette \u2013 Coming Soon to XBOX GamePass", "thumb": "https://i.ytimg.com/vi/GiCH_b6LqdU/maxresdefault.jpg"}, {"id": 132739, "name": "Trailer", "video_id": "FsXlvCki7k8", "url": "https://www.youtube.com/watch?v=FsXlvCki7k8", "title": "Buckshot Roulette | Horror Game Awards October Showcase Trailer 2024", "thumb": "https://i.ytimg.com/vi/FsXlvCki7k8/maxresdefault.jpg"}]}