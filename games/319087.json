nipulation: the premise remains a 12-day plague crisis, but the Bachelor can revisit and alter key events, reflecting his obsession with control, causality, and conquering death.", "themes": [{"id": 19, "name": "Horror"}, {"id": 20, "name": "Thriller"}, {"id": 21, "name": "Survival"}, {"id": 31, "name": "Drama"}, {"id": 38, "name": "Open world"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/pathologic-3", "videos": [{"id": 129138, "name": "Trailer", "video_id": "Bcqbg8tW9kU", "url": "https://www.youtube.com/watch?v=Bcqbg8tW9kU", "title": "Pathologic 3 Announce Trailer", "thumb": "https://i.ytimg.com/vi/Bcqbg8tW9kU/maxresdefault.jpg"}, {"id": 152438, "name": "Trailer", "video_id": "HIbnfoY_1Pg", "url": "https://www.youtube.com/watch?v=HIbnfoY_1Pg", "title": "Pathologic 3 Amalgama Trailer", "thumb": "https://i.ytimg.com/vi/HIbnfoY_1Pg/sddefault.jpg"}, {"id": 165109, "name": "Release Date Trailer", "video_id": "XcgH-s7vgAY", "url": "https://www.youtube.com/watch?v=XcgH-s7vgAY", "title": "Pathologic 3: Politician Trailer", "thumb": "https://i.ytimg.com/vi/XcgH-s7vgAY/maxresdefault.jpg"}, {"id": 172666, "name": "Launch Trailer", "video_id": "eTwFOpkncsI", "url": "https://www.youtube.com/watch?v=eTwFOpkncsI", "title": "Pathologic 3 - Launch Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/eTwFOpkncsI/maxresdefault.jpg"}], "collections": [{"id": 2069, "name": "Pathologic"}]}