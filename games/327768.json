{"id": 327768, "artworks": [{"id": 277831, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5ydj.jpg"}, {"id": 277832, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5ydk.jpg"}], "cover": {"id": 566226, "url": "//images.igdb.com/igdb/image/upload/t_thumb/coc4wi.jpg"}, "external_games": [{"id": 2947071, "name": "Puck", "uid": "2994020", "url": "https://store.steampowered.com/app/2994020", "external_game_source": {"id": 1, "name": "Steam"}}, {"id": 2973825, "name": "Puck", "uid": "1208208142", "url": "https://www.twitch.tv/directory/game/Puck", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}], "genres": [{"id": 11, "name": "Real Time Strategy (RTS)"}, {"id": 13, "name": "Simulator"}, {"id": 14, "name": "Sport"}, {"id": 15, "name": "Strategy"}], "involved_companies": [{"id": 302623, "company": {"id": 49421, "name": "Nils Asejevs"}, "developer": true}], "multiplayer_modes": [{"id": 32012, "campaigncoop": false, "dropin": false, "game": 327768, "lancoop": false, "offlinecoop": false, "onlinecoop": false, "platform": 6, "splitscreen": false, "checksum": "26041ffa-4fc8-3272-8c0f-e2d4edc37d75"}], "name": "Puck", "platforms": [6], "player_perspectives": [{"id": 1, "name": "First person"}], "rating": 69.02200477649468, "release_dates": [{"id": 688794, "date": 1735948800, "platform": 6, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1446955, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scv0h7.jpg"}, {"id": 1446956, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scv0h8.jpg"}, {"id": 1446957, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scv0h9.jpg"}, {"id": 1446958, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scv0ha.jpg"}, {"id": 1446959, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scv0hb.jpg"}], "slug": "puck", "summary": "Puck is a multiplayer hockey game that trusts the player to do the hard work. The puck has weight and momentum, so plays are never automatic. A pass that looks perfect can skid wide if you misjudge speed or angle, and a shot that seems routine can bounce off the post in a heartbeat. That unpredictability is the point. It makes every successful play feel earned and every mistake teachable.\n\nControls are deliberately precise rather than flashy. Small adjustments to stick angle and body position change outcomes in meaningful ways. You learn to read the ice, to nudge the puck into space, to sell a fake with your shoulders and then thread a pass through a seam. Goaltending is its own discipline. Good goalies win games by staying calm, cutting angles, and trusting timing instead of spamming saves.", "url": "https://www.igdb.com/games/puck", "videos": [{"id": 185267, "name": "Trailer", "video_id": "GA2iLu3Heek", "url": "https://www.youtube.com/watch?v=GA2iLu3Heek", "title": "Puck Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/GA2iLu3Heek/sddefault.jpg"}]}