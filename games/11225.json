xSU6Knw", "url": "https://www.youtube.com/watch?v=dVzoxSU6Knw", "title": "Typoman - Official Launch Trailer (Wii U)", "thumb": "https://i.ytimg.com/vi/dVzoxSU6Knw/sddefault.jpg"}, {"id": 6606, "name": "Trailer", "video_id": "PH9F_423F6U", "url": "https://www.youtube.com/watch?v=PH9F_423F6U", "title": "Nintendo eShop - Typoman Nindies@Home E3 Trailer", "thumb": "https://i.ytimg.com/vi/PH9F_423F6U/maxresdefault.jpg"}]}