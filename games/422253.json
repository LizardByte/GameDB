15mgg.jpg"}, {"id": 1942002, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgi.jpg"}, {"id": 1942003, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgj.jpg"}, {"id": 1942004, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgk.jpg"}, {"id": 1942005, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgl.jpg"}, {"id": 1942006, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgm.jpg"}, {"id": 1942007, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15mgn.jpg"}, {"id": 1945643, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15p9n.jpg"}], "slug": "gamble-hunters", "storyline": "The players owe a huge sum of money to Captain Gold, a ruthless pirate captain who forces his debtors to join his crew, the Gamble Hunters. Under his command they hunt space monsters for Rupees, then are made to gamble those Rupees at the casino to earn the money they owe him. Every win brings them closer to freedom, and every loss sinks the whole crew deeper into debt.", "summary": "A first-person casino action roguelite for 1-4 players. One wallet, four hunters, zero trust. Hunt monsters for 60 seconds to fill the shared pot, then race your friends to gamble it into your own Gold. Upgrade guns, mix traits and artifacts, beat bosses, and pay off the shared debt or go bust.", "themes": [{"id": 1, "name": "Action"}, {"id": 27, "name": "Comedy"}, {"id": 40, "name": "Party"}], "url": "https://www.igdb.com/games/gamble-hunters", "videos": [{"id": 198989, "name": "Trailer", "video_id": "Hc-PwiV_MIc", "url": "https://www.youtube.com/watch?v=Hc-PwiV_MIc", "title": "4 Friends. 1 Wallet. 999,999,999 in Debt. | Gamble Hunters - Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/Hc-PwiV_MIc/maxresdefault.jpg"}, {"id": 198990, "name": "Gameplay Video", "video_id": "lD5TXCKaR-o", "url": "https://www.youtube.com/watch?v=lD5TXCKaR-o", "title": "What Happens When 4 Players Share 1 Wallet? | Gamble Hunters - Gameplay Overview", "thumb": "https://i.ytimg.com/v