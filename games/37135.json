mages.igdb.com/igdb/image/upload/t_thumb/asprqhdobebphdin49f1.jpg"}, {"id": 179087, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qheruwvbnbupoixr6ats.jpg"}, {"id": 179095, "url": "//images.igdb.com/igdb/image/upload/t_thumb/r2cl5ieqqmmvmy7wkbha.jpg"}, {"id": 44467, "url": "//images.igdb.com/igdb/image/upload/t_thumb/q3hxjnaqzi5blscykkhu.jpg"}, {"id": 44468, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qjpzw8o3pznskacllpex.jpg"}, {"id": 179086, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ttlg4zb8jrwhjxew9erk.jpg"}, {"id": 179091, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tfkug7pmju4f4p69odex.jpg"}, {"id": 179090, "url": "//images.igdb.com/igdb/image/upload/t_thumb/v1eomgkk4vy3wqqecjd1.jpg"}], "slug": "yoshis-crafted-world", "storyline": "Yoshi's Crafted World is a charming side-scrolling platformer set in a handcrafted world built from cardboard, paper, and household odds and ends. At the heart of the tale is the Sundream Stone, a wondrous artifact adorned with gems said to grant any wish to those who possess it. The peaceful Yoshis treasure the stone, but their tranquility is shattered when the mischievous magician Kamek and the bratty Baby Bowser arrive with designs on its power for themselves. In the ensuing scuffle over the artifact, the Sundream Stone's precious gems are knocked loose and scattered far and wide across the crafted land. Now the Yoshis must set off on a colorful journey through its many diorama-like stages, gobbling enemies, hurling eggs, and exploring both the front and back of each papercraft scene, all in a race to recover the missing gems and restore the Sundream Stone before their scheming rivals can claim its wish-granting magic.", "summary": "Lead Yoshi on a brand new adventure that will turn everything you've come to expect from side-scrolling games upside down! Explore a great, big world decorated like a miniature diorama in a new art style for the franchise, where each side-scrolling stage has the traditional front side as well as a flip side with different views and surprises. Look for items throughout the stage as Yoshi makes his way to the goal. You can even join up with a friend!", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/yoshis-crafted-world", "videos": [{"id": 25983, "name": "Launch Trailer", "video_id": "k9xHZXiLvLY", "url": "https://www.youtube.com/watch?v=k9xHZXiLvLY", "title": "Yoshi's Crafted World - Launch trailer (Nintendo Switch)", "thumb": "https://i.ytimg.com/vi/k9xHZXiLvLY/maxresdefault.jpg"}, {"id": 14347, "name": "Trailer", "video_id": "sx_C9jJ0AlA", "url": "https://www.youtube.com/watch?v=sx_C9jJ0AlA", "title": "Yoshi for Nintendo Switch - Official Game Trailer - Nintendo E3 2017", "thumb": "https://i.ytimg.com/vi/sx_C9jJ0AlA/maxresdefault.jpg"}, {"id": 24077, "name": "Trailer", "video_id": "dcndZNVUxFM", "url": "https://www.youtube.com/watch?v=dcndZNVUxFM", "title": "Yoshi\u2019s Crafted World - Story Trailer - Nintendo Switch", "thumb": "https://i.ytimg.com/vi/dcndZNVUxFM/maxresdefault.jpg"}, {"id": 25336, "name": "Trailer", "video_id": "WPrrY7mgPQM", "url": "https://www.youtube.com/watch?v=WPrrY7mgPQM", "title": "\u30e8\u30c3\u30b7\u30fc\u30af\u30e9\u30d5\u30c8\u30ef\u30fc\u30eb\u30c9 \u7d39\u4ecb\u6620\u50cf", "thumb": "https://i.ytimg.com/vi/WPrrY7mgPQM/maxresdefault.jpg"}], "collections": [{"id": 7158, "name": "Yoshi's Island"}, {"id": 582, "name": "Yoshi"}], "characters": [{"id": 1897, "name": "Voice"}]}