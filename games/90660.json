ds\n\u2022 50 Extra Vault Inventory Slots", "themes": [{"id": 1, "name": "Action"}, {"id": 21, "name": "Survival"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/fortnite-deluxe-founders-pack"}