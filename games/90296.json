es": [{"id": 1, "name": "Action"}, {"id": 21, "name": "Survival"}], "url": "https://www.igdb.com/games/we-happy-few-deluxe-edition", "videos": [{"id": 146099, "name": "Trailer", "video_id": "GvcvV9PjW7k", "url": "https://www.youtube.com/watch?v=GvcvV9PjW7k", "title": "We Happy Few - Release Trailer", "thumb": "https://i.ytimg.com/vi/GvcvV9PjW7k/maxresdefault.jpg"}]}