 "worldwide"}}, {"id": 652238, "date": 1675987200, "platform": 169, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652233, "date": 1683244800, "platform": 48, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652240, "date": 1675987200, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652237, "date": 1675728000, "platform": 169, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652239, "date": 1675728000, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652236, "date": 1675987200, "platform": 167, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652234, "date": 1683244800, "platform": 49, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652232, "date": 1699920000, "platform": 130, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 652235, "date": 1675728000, "platform": 167, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1010922, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo16.jpg"}, {"id": 1010916, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo10.jpg"}, {"id": 1010917, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo11.jpg"}, {"id": 1010919, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo13.jpg"}, {"id": 1010921, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo15.jpg"}, {"id": 1010920, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo14.jpg"}, {"id": 1010923, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo17.jpg"}, {"id": 1010915, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo0z.jpg"}, {"id": 1010918, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclo12.jpg"}], "slug": "hogwarts-legacy", "storyline": "Experience Hogwarts in the 1800s. Your character is a student who holds the key to an ancient secret that threatens to tear the wizarding world apart. You have received a late acceptance to the Hogwarts School of Witchcraft and Wizardry and soon discover that you are no ordinary student: you possess an unusual ability to perceive and master Ancient Magic. Only you can decide if you will protect this secret for the good of all, or yield to the temptation of more sinister magic.", "summary": "Hogwarts Legacy is an immersive, open-world action RPG set in the world first introduced in the Harry Potter books. Now you can take control of the action and be at the center of your own adventure in the wizarding world. Embark on a journey through familiar and new locations as you explore and discover fantastic beasts, customize your character and craft potions, master spell casting, upgrade talents, and become the wizard you want to be. Discover the feeling of living at Hogwarts as you make allies, battle Dark wizards, and ultimately decide the fate of the wizarding world. Your legacy is what you make of it.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/hogwarts-legacy", "videos": [{"id": 40696, "name": "Announcement Trailer", "video_id": "BsC-Rl9GYy0", "url": "https://www.youtube.com/watch?v=BsC-Rl9GYy0", "title": "Hogwarts Legacy \u2013 Official 4K Reveal Trailer", "thumb": "https://i.ytimg.com/vi/BsC-Rl9GYy0/maxresdefault.jpg"}, {"id": 65536, "name": "Gameplay Trailer", "video_id": "2AZmuZNu5LA", "url": "https://www.youtube.com/watch?v=2AZmuZNu5LA", "title": "Hogwarts Legacy - State of Play Official Gameplay Reveal | PS5, PS4", "thumb": "https://i.ytimg.com/vi/2AZmuZNu5LA/maxresdefault.jpg"}, {"id": 73713, "name": "Trailer", "video_id": "lutoaYeUVhw", "url": "https://www.youtube.com/watch?v=lutoaYeUVhw", "title": "Hogwarts Legacy World Premiere Trailer | gamescom Opening Night LIVE 2022", "thumb": "https://i.ytimg.com/vi/lutoaYeUVhw/maxresdefault.jpg"}, {"id": 74687, "name": "Trailer", "video_id": "TFp1vsPz2H4", "url": "https://www.youtube.com/watch?v=TFp1vsPz2H4", "title": "Hogwarts Legacy Haunted Hogsmeade Shop Quest Trailer | State of Play September 2022", "thumb": "https://i.ytimg.com/vi/TFp1vsPz2H4/maxresdefault.jpg"}, {"id": 80863, "name": "Dev Diary", "video_id": "WS4qPq20aVo", "url": "https://www.youtube.com/watch?v=WS4qPq20aVo", "title": "Hogwarts Legacy - Gameplay Showcase II", "thumb": "https://i.ytimg.com/vi/WS4qPq20aVo/maxresdefault.jpg"}, {"id": 145051, "name": "Trailer", "video_id": "64gYTiV-LAk", "url": "https://www.youtube.com/watch?v=64gYTiV-LAk", "title": "Hogwarts Legacy - Nintendo Switch 2 Trailer | Nintendo Direct", "thumb": "https://i.ytimg.com/vi/64gYTiV-LAk/maxresdefault.jpg"}]}