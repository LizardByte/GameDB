pg"}, {"id": 1749869, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11i7h.jpg"}], "slug": "coneys", "storyline": "It's time for your first day of work at Coney\u2019s! An ice cream parlor that specializes in cones! You work the closing shift and will serve walk-in and drive thru customers looking to pick up a late night snack and wind down after a long, long day. After everyone has had their ice cream, it's time sweep the floors, wipe the tables, clean the bathroom, and any other closing tasks that will leave the store nice and clean for the morning crew!\n\nOne thing you will not be at Coney's is bored! All kinds of wonderful characters will come by for that sweet, sweet dream, that's Coney\u2019s Ice Cream! They can choose 1 of 3 different cones, up to 2 scoops of 10 different flavors, and have 10 different toppings to chose from! All scooped up, by you, with a smile!", "summary": "Coney's is a 1 or 2 player online co-op game where you work at an ice cream parlor that specializes in cones! Bake cones! Scoop ice cream! Serve with a smile! And at the end of your shift, don\u2019t forget to clean up the store before you head home! Nothing bad will happen!", "themes": [{"id": 19, "name": "Horror"}, {"id": 28, "name": "Business"}], "url": "https://www.igdb.com/games/coneys", "videos": [{"id": 174309, "name": "Announcement Trailer", "video_id": "-cmHErkuDUE", "url": "https://www.youtube.com/watch?v=-cmHErkuDUE", "title": "Coney's | Official Trailer", "thumb": "https://i.ytimg.com/vi/-cmHErkuDUE/maxresdefault.jpg"}]}