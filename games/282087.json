{"id": 282087, "artworks": [{"id": 162461, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3hct.jpg"}], "cover": {"id": 354501, "url": "//images.igdb.com/igdb/image/upload/t_thumb/co7lj9.jpg"}, "external_games": [{"id": 2877752, "name": "A Mallard's Song", "uid": "569076733", "url": "https://www.twitch.tv/directory/game/A%20Mallard%27s%20Song", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 3003713, "name": "A Mallard's Song", "uid": "1861312", "url": "https://ducky-elford.itch.io/a-mallards-song", "external_game_source": {"id": 30, "name": "Itchio"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 31, "name": "Adventure"}, {"id": 34, "name": "Visual Novel"}], "involved_companies": [{"id": 298990, "company": {"id": 60302, "name": "Ducky Elford"}, "developer": true}], "name": "A Mallard's Song", "platforms": [6], "player_perspectives": [{"id": 1, "name": "First person"}], "release_dates": [{"id": 551082, "date": 1672704000, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1514679, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwgqf.jpg"}, {"id": 1514680, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwgqg.jpg"}, {"id": 1514681, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwgqh.jpg"}, {"id": 1514682, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwgqi.jpg"}], "slug": "a-mallards-song", "summary": "The game\u2019s main mechanic makes use of a timer. This allows the player 60 seconds to find the level exit. If the player fails this task, the landscape becomes consumed with glitching visuals and strange folkloric characters, telling stories of England\u2019s dark underbelly.\n\nThe game questions the English nationalistic love affair with politicized traditionalism and the toxic side effects this has had on individuals and marginalized groups.\n\nThrough storytelling and allegorical visual narratives, I wanted to explore my difficult past experiences of English nationalism and identity and the history and legacy of English environments and folklore.", "themes": [{"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/a-mallards-song", "videos": [{"id": 147221, "video_id": "nI-ryUSaMsQ", "url": "https://www.youtube.com/watch?v=nI-ryUSaMsQ", "title": "A Mallard's Song", "thumb": "https://i.ytimg.com/vi/nI-ryUSaMsQ/maxresdefault.jpg"}]}