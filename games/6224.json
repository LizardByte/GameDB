"screenshots": [{"id": 1221535, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq6jj.jpg"}, {"id": 1221536, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq6jk.jpg"}, {"id": 1698619, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10env.jpg"}, {"id": 1698620, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10enw.jpg"}, {"id": 1221537, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq6jl.jpg"}, {"id": 1221538, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq6jm.jpg"}], "slug": "need-for-speed-v-rally-2--1", "storyline": "In V-Rally 2, you play as a rising rally driver, always accompanied by your navigator. Your journey takes you through 84 global tracks and 16 different cars. You begin by racing against the clock in Arcade Mode, then advance to the V-Rally Trophy, which includes the Euro, World, and Expert trophies. Finally, you enter Championship Mode, where eight competitors race against time and only the top six earn points. At the end of the final round, the driver with the highest score becomes the European, World, or Expert Champion.", "summary": "Need for Speed: V-Rally 2 is a racing video game developed by Eden Studios and released in 1999, the second mainline entry in the V-Rally series. Similar to its predecessor, here, the player drive rally cars through a series of stages, with the game placing emphasis on replicating the behavior physics of real cars. The game includes various game modes, and can be played as single player, or up to four simultaneous players.", "themes": [{"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/need-for-speed-v-rally-2--1", "videos": [{"id": 59202, "name": "Trailer", "video_id": "YnlJu553sPk", "url": "https://www.youtube.com/watch?v=YnlJu553sPk", "title": "V-Rally: Championship Edition 2 (PSX)", "thumb": "https://i.ytimg.com/vi/YnlJu553sPk/sddefault.jpg"}, {"id": 168453, "name": "Game Intro", "video_id": "Ca1-3FUlluw", "url": "https://www.youtube.com/watch?v=Ca1-3FUlluw", "title": "V-Rally 2: Need for Speed (PSX) - Intro", "thumb": "https://i.ytimg.com/vi/Ca1-3FUlluw/maxresdefault.jpg"}], "collections": [{"id": 688, "name": "V-Rally"}]}