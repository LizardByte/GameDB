fflinecoop": false, "onlinecoop": false, "onlinemax": 8, "platform": 39, "splitscreen": false, "checksum": "ce76ea87-04c0-cbbb-3c1f-9048e6e2daea"}], "name": "Orbit Dash", "platforms": [82, 34, 39], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 991467, "date": 1794182400, "platform": 39, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 987761, "date": 1788048000, "platform": 34, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1983378, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16idu.jpg"}, {"id": 1983380, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16idw.jpg"}, {"id": 1983381, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16idx.jpg"}, {"id": 1983377, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16idt.jpg"}, {"id": 1983379, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16idv.jpg"}, {"id": 1985790, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16k8u.jpg"}, {"id": 1985792, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16k8w.jpg"}, {"id": 1985793, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16k8x.jpg"}, {"id": 1985789, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16k8t.jpg"}, {"id": 1985791, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16k8v.jpg"}, {"id": 2002700, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16xak.jpg"}, {"id": 2002701, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16xal.jpg"}], "slug": "orbit-dash", "summary": "Orbit Dash is a one-tap rhythm game for Android, iPhone, iPad and the web browser. Your ball circles neon orbits on its own: tap to jump between rings, dodge the spikes and grab the gems, with every move landing on the beat. The game has 19 music levels, each built on its own original track with its own camera direction, from the calm FIRST LIGHT to the DEMON levels THE LAST TOCCATA, driven by a gothic organ, and THE FABULOUS, a descent through the eight circles of hell played across four rings. Two SPECIAL levels have their own mechanics: in HYPNOTIC the ball jumps through portals to another ring on the beat, and some of the portals are fakes; in ABRACADABRA the orbits change shape on the beat, from an ellipse to a triangle, a square and a star. In VERSUS LIVE up to 8 players race on one track with the same spikes and no upgrades, so only the taps decide: join an open room, invite friends with a link or room code, or race a random opponent, in the endless mode or on a music level. There is also an endless mode with combos and boosters, weekly leaderboards by country and worldwide, unlockable ball trails and skins, daily missions, and 82 languages.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/orbit-dash", "videos": [{"id": 202542, "name": "Trailer", "video_id": "6XHNGb8c9_s", "url": "https://www.youtube.com/watch?v=6XHNGb8c9_s", "title": "Orbit Dash 2.0 \u2014 10 Ball Trails | Rhythm Tap Game Trailer", "thumb": "https://i.ytimg.com/vi/6XHNGb8c9_s/maxresdefault.jpg"}, {"id": 202795, "name": "Trailer", "video_id": "epIUbY0Hq-A", "url": "https://www.youtube.com/watch?v=epIUbY0Hq-A", "title": "Orbit Dash: Update 3.0 | Online VERSUS, 4 New Levels and Our First DEMON", "thumb": "https://i.ytimg.com/vi/epIUbY0Hq-A/maxresdefault.jpg"}, {"id": 203722, "name": "Trailer", "video_id": "kP_LQCMUOFA", "url": "https://www.youtube.com/watch?v=kP_LQCMUOFA", "title": "Orbit Dash: 2 New Levels | SOUL ACOUSTIC and LUDOVIVO, From Chill to DEMON", "thumb": "https://i.ytimg.com/vi/kP_LQCMUOFA/maxresdefault.jpg"}, {"id": 204195, "name": "Trailer", "video_id": "pZHvAZ3sOb8", "url": "https://www.youtube.com/watch?v=pZHvAZ3sOb8", "title": "Orbit Dash: Update 4.0.0 | 3 New Levels and VERSUS Online (THE FABULOUS, CHROMA, SUNSHINE)", "thumb": "https://i.ytimg.com/vi/pZHvAZ3sOb8/maxresdefault.jpg"}, {"id": 204620, "name": "Trailer", "video_id": "Pk3LJ2ZYDeM", "url": "https://www.youtube.com/w