elease_dates": [{"id": 768859, "date": 1603929600, "platform": 3, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 768860, "date": 1603929600, "platform": 14, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 768861, "date": 1603929600, "platform": 6, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 409190, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8rqe.jpg"}, {"id": 409192, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8rqg.jpg"}, {"id": 409191, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8rqf.jpg"}, {"id": 409189, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8rqd.jpg"}], "slug": "the-annual-ghost-town-pumpkin-festival", "storyline": "Welcome to Scenic Ghost Town! There's nobody here.\n\n...And that's why we need you! Mayor Bones invites you, your friends, your relatives, and literally anyone else you can drag along to come and take part in the celebration!\n\nCarve pumpkins!\n\nThere's a frightening lack of jack-o-lanterns this year, and that's why we're recruiting you to make some!\n\nShow them off on the World Wide Web!\n\nOnce you've finished your creation, bring it to the festival and share it with the world!\n\nAttract ghosts!\n\nIt wouldn't be a ghost town without ghosts! Maybe if we get enough pumpkins, we can get this festival really haunted!\n\nSpooky regards,\nMayor Bones", "summary": "Carve a lil pal and share it with the world.\nCreate a ghostly avatar, carve pumpkins, and show them off at the festival. Interact with your fellow ghosts and explore Ghost Town!\n\nServers are live for a limited time around Halloween each year.", "themes": [{"id": 19, "name": "Horror"}, {"id": 33, "name": "Sandbox"}], "url": "https://www.igdb.com/games/the-annual-ghost-town-pumpkin-festival", "videos": [{"id": 99819, "name": "Trailer", "video_id": "TErDsxrq5DY", "url": "https://www.youtube.com/watch?v=TErDsxrq5DY", "title": "Mayor Bones' Pumpkin Festiva