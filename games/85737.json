": 1123200000, "platform": 6, "y": 2005, "release_region": {"id": 5, "region": "japan"}}, {"id": 730926, "date": 725760000, "platform": 13, "y": 1992, "release_region": {"id": 1, "region": "europe"}}, {"id": 730927, "date": 694137600, "platform": 18, "y": 1991, "release_region": {"id": 2, "region": "north_america"}}, {"id": 730031, "date": 631065600, "platform": 18, "y": 1989, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 1510247, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwdbb.jpg"}, {"id": 1510248, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwdbc.jpg"}, {"id": 1510249, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwdbd.jpg"}, {"id": 1510250, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwdbe.jpg"}, {"id": 1510246, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwdba.jpg"}], "slug": "lempereur", "summary": "L'Empereur is a turn-based strategy video game for the Nintendo Entertainment System released by the Koei company in 1989.\n\nThe user controls Napoleon Bonaparte during the Napoleonic Wars of the late 18th and early 19th Centuries. The goal is to conquer Europe. The game begins with Napoleon as an army officer, but with victories in combat, the user may get promoted to Commander-in-Chief, First Consul, and finally Emperor of the French, with more powers and actions available at each level. As Emperor, the user also controls Napoleon's brothers, Louis, J\u00e9r\u00f4me, Lucien, and Joseph, as well as Napoleon's stepson, Eugene Beauharnais. The game has both military and civilian aspects. The user can lead armies, act as mayor of cities, and depending on the level achieved, engage in diplomacy with other nations. This historically accurate game reproduces many historical figures and the militaries of Europe with great detail.", "themes": [{"id": 1, "name": "Action"}, {"id": 22, "name": "Historical"}, {"id": 39, "name": "Warfare"}], "url": "https://www.igdb.com/games/lempereur", "videos"