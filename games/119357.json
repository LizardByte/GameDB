orm": 6, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 210480, "date": 1606953600, "platform": 170, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 339567, "date": 1606867200, "platform": 130, "y": 2020, "release_region": {"id": 1, "region": "europe"}}, {"id": 209943, "date": 1606953600, "platform": 49, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 314162, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6qeq.jpg"}, {"id": 398336, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8jcw.jpg"}, {"id": 314163, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6qer.jpg"}, {"id": 314164, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6qes.jpg"}, {"id": 314161, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6qep.jpg"}, {"id": 1380577, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctl9d.jpg"}, {"id": 398334, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8jcu.jpg"}, {"id": 398333, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8jct.jpg"}, {"id": 314160, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6qeo.jpg"}, {"id": 398335, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8jcv.jpg"}], "slug": "immortals-fenyx-rising", "storyline": "When the monstrous Titan Typhon escapes his ancient imprisonment beneath a mountain, he strips the Olympian gods of their powers and sets out to remake the world in his own image, turning much of humanity to stone. Fenyx, a young Greek shield-bearer who survives a shipwreck on the mythic Golden Isle, awakens to find the crew and islanders petrified and the gods laid low. Guided by a prophecy and aided by a fledgling firebird named Phosphor, Fenyx sets out across the seven regions of the Golden Isle to restore the fallen Olympians and rescue a captured loved one. Framed as a tale told by the trickster Titan Prometheus to a chastened Zeus, Fenyx's quest becomes the last hope of standing against Typhon and saving both gods and mortals.", "summary": "From the creators of Assassin\u2019s Creed Odyssey comes a storybook adventure about a forgotten hero on a quest to save the Greek gods.\n\nEmbark on a journey to the Isle of the Blessed, taken over by dangerous creatures of mythology. Prove your legendary heroism by taking on their leader, Typhon, the deadliest monster in all of mythology in a face-off for the ages.\nExplore a beautiful fantasy world where tricky puzzles, mysterious dungeons and heroic feats await. The journey will be as challenging and rewarding as the final destination.\nWill you be the Hero of the legends foretold?", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/immortals-fenyx-rising", "videos": [{"id": 40416, "name": "Trailer", "video_id": "WQ6m8jbtsZI", "url": "https://www.youtube.com/watch?v=WQ6m8jbtsZI", "title": "Immortals Fenyx Rising: World Premiere Trailer", "thumb": "https://i.ytimg.com/vi/WQ6m8jbtsZI/maxresdefault.jpg"}, {"id": 40417, "name": "Gameplay Trailer", "video_id": "phpm8v_uRWs", "url": "https://www.youtube.com/watch?v=phpm8v_uRWs", "title": "Immortals Fenyx Rising: Gameplay Overview", "thumb": "https://i.ytimg.com/vi/phpm8v_uRWs/maxresdefault.jpg"}, {"id": 121342, "name": "Cinematic Trailer", "video_id": "Egzb6_HCqQw", "url": "https://www.youtube.com/watch?v=Egzb6_HCqQw", "title": "Gods & Monsters: E3 2019 Official World Premiere Cinematic Trailer | Ubisoft [NA]", "thumb": "https://i.ytimg.com/vi/Egzb6_HCqQw/maxresdefault.jpg"}]}