, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15alq.jpg"}, {"id": 1926632, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15alk.jpg"}, {"id": 1926633, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15all.jpg"}, {"id": 1926636, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15alo.jpg"}, {"id": 1926639, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15alr.jpg"}, {"id": 1926637, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15alp.jpg"}], "slug": "coup-de-koala", "storyline": "Coup de Koala is a cute pixel art bullet hell roguelite focused on building synergies between spell cards and weapons to create devastating combos against enemies. Play as an exiled koala king sworn to expel the foreign usurpers of your country. Gameplay is focused around the traditional shoot and slash of bullet hell games like Enter the Gungeon and Risk of Rain, but with an additional layer of building unique card-weapon pairings that will be critical for progressing. Dying is expected. Upgrade your character after each run, rise from the rubble again, and fight till you finally free your people.", "summary": "Seize back the crown in Coup de Koala, a cute bullet hell roguelite of furious rebellion. As an exiled koala king, unleash spells and steel against relentless undead legions to reclaim your throne. Build your deck of cards, die, upgrade your character, repeat.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/coup-de-koala", "videos": [{"id": 190611, "name": "Gameplay Trailer", "video_id": "xaXTSelZlMM", "url": "https://www.youtube.com/watch?v=xaXTSelZlMM", "title": "Coup de Koala Trailer v2", "thumb": "https://i.ytimg.com/vi/xaXTSelZlMM/fhddefault.jpg"}, {"id": 196914, "name": "Trailer", "video_id": "Ws9Mxu5380k", "url": "https://www.youtube.com/watch?v=Ws9Mxu5380k", "title": "Coup de Koala Trailer v3", "thumb": "https://i.ytimg.com/vi/Ws9Mxu5380k/fhddefault.jpg"}, {"id": 178571, "name": "Trailer", "video_id": "B_Ui