urope"}}, {"id": 880297, "date": 1490918400, "platform": 52, "y": 2017, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1789717, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12cyd.jpg"}, {"id": 1789715, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12cyb.jpg"}, {"id": 1789716, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12cyc.jpg"}], "slug": "f355-challenge-2-international-course-edition", "summary": "F355 Challenge 2: International Course Edition is the sequel to F355 Challenge. It was released for Sega NAOMI arcade hardware in 2001 and has not seen any home ports. As the name suggests, it uses digitized versions of real-life courses from around the world, all of which were featured in the home port of the first game. It improved the driving physics and added Two Music Tracks, while also removing Alan J as the radio DJ.\n\nSega Logistics Service announced it would end service on the arcade machines on March 31, 2017.", "themes": [{"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/f355-challenge-2-international-course-edition", "videos": [{"id": 176987, "name": "Gameplay Video", "video_id": "4vfP2AktHVw", "url": "https://www.youtube.com/watch?v=4vfP2AktHVw", "title": "F355 Challenge 2: International Course Edition Arcade", "thumb": "https://i.ytimg.com/vi/4vfP2AktHVw/maxresdefault.jpg"}]}