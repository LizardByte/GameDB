t_thumb/sc12jka.jpg"}, {"id": 1798283, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12jkb.jpg"}], "slug": "haunted-ps1-madvent-calendar-2020", "storyline": "Looking for shelter from the harsh Winter weather, you approach the abandoned cabin out in the woods. As you reach for the doorknob, a gust of icy wind throws the door open, pushing you in. The fireplace lights ablaze and you close the door behind you. In the center of the room, you see it...that festive amalgam of 24 doors: The Madvent Calendar. Each door will lead you to a different strange world of horror and delight, but may only be opened if that day has arrived!", "summary": "A Merry and Scary Collection of 24 weird and spooky games to play over the course of December. It's an advent calendar you can play, every day!\nThe Madvent series began in 2020 and has continued ever year, put together by the HauntedPS1 Community!", "themes": [{"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/haunted-ps1-madvent-calendar-2020", "videos": [{"id": 80815, "name": "Trailer", "video_id": "NWaonPt6JGc", "url": "https://www.youtube.com/watch?v=NWaonPt6JGc", "title": "Haunted PS1 Madvent Calendar 2020 Trailer", "thumb": "https://i.ytimg.com/vi/NWaonPt6JGc/maxresdefault.jpg"}, {"id": 80816, "name": "Trailer", "video_id": "lMz9dltQHAk", "url": "https://www.youtube.com/watch?v=lMz9dltQHAk", "title": "Haunted PS1 Madvent Calendar 2021 Trailer", "thumb": "https://i.ytimg.com/vi/lMz9dltQHAk/maxresdefault.jpg"}, {"id": 80817, "name": "Trailer", "video_id": "vC7XSpmHkK0", "url": "https://www.youtube.com/watch?v=vC7XSpmHkK0", "title": "Madvent Calendar 3 : Necrosis - Trailer", "thumb": "https://i.ytimg.com/vi/vC7XSpmHkK0/maxresdefault.jpg"}], "collections": [{"id": 13813, "name": "Madvent Calendar"}]}