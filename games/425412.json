, {"id": 1964600, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc163w8.jpg"}, {"id": 1964599, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc163w7.jpg"}, {"id": 1964595, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc163w3.jpg"}, {"id": 1964598, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc163w6.jpg"}, {"id": 1964605, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc163wd.jpg"}], "slug": "what-the-buck", "summary": "What the Buck?! is an incremental game about destroying money. Swipe a credit card through an ATM, bills land on a table, and the breaker shreds them for money. Electric bills arc to the bills next to them, explosive bills blow up the stack around them, and burning bills set their neighbours on fire. Over 240 upgrades are spread across upgrade panels, a skill tree and a prestige tree. Ending a shift turns the money destroyed into Prestige Points for permanent upgrades, so the next shift starts stronger. Mr. Buck, the player's boss, calls in with instructions and opinions.", "themes": [{"id": 27, "name": "Comedy"}, {"id": 28, "name": "Business"}], "url": "https://www.igdb.com/games/what-the-buck", "videos": [{"id": 200819, "name": "Release Date Trailer", "video_id": "6ja3T3vFFpI", "url": "https://www.youtube.com/watch?v=6ja3T3vFFpI", "title": "What the Buck?! - Official Release Date Announcement Trailer", "thumb": "https://i.ytimg.com/vi/6ja3T3vFFpI/uhddefault.jpg"}]}