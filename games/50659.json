th fun and motivating statistics.", "themes": [{"id": 32, "name": "Non-fiction"}, {"id": 34, "name": "Educational"}], "url": "https://www.igdb.com/games/fit-in-six-six-ways-to-get-in-shape", "videos": [{"id": 113312, "name": "Launch Trailer", "video_id": "b6rrOzHKi4w", "url": "https://www.youtube.com/watch?v=b6rrOzHKi4w", "title": "Fit in Six: Official Launch Trailer", "thumb": "https://i.ytimg.com/vi/b6rrOzHKi4w/maxresdefault.jpg"}], "collections": [{"id": 3562, "name": "My Fitness Coach"}]}