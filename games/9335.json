ase_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 102170, "url": "//images.igdb.com/igdb/image/upload/t_thumb/s9lgd6qo7znwogootoku.jpg"}, {"id": 102171, "url": "//images.igdb.com/igdb/image/upload/t_thumb/aq7hed90e5bc9rfjilpo.jpg"}, {"id": 102172, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dw2dmgvnta71bbvv5hd4.jpg"}, {"id": 102173, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hzlseavrczpsjbxfqt0o.jpg"}, {"id": 102174, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lwabmvh5qt2cpubv8aiy.jpg"}], "slug": "worms-pinball", "summary": "Worms Pinball is a pinball simulation game set within the Worms franchise. The game features a single pinball table themed around two main modes, one inspired by martial arts and the other by a Western setting. Players control a pinball table that incorporates multiple objectives, rule sets, and sub-games presented through a three-dimensional LED display.\n\nThe table includes transparent ramps, moving mechanical components, user-controlled elements, and magnetic fields. Gameplay mechanics replicate standard pinball techniques such as tilt functions, hit combinations, ball control maneuvers, and recovery actions. The table contains a large number of animated elements and extensive rendered animation sequences used for the LED display. Sound effects and music are integrated to accompany gameplay events. The design emphasizes depth through layered objectives and complex table rules, supporting extended play for both casual and experienced pinball players.", "themes": [{"id": 1, "name": "Action"}, {"id": 35, "name": "Kids"}], "url": "https://www.igdb.com/games/worms-pinball", "collections": [{"id": 212, "name": "Worms"}]}