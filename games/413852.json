games/purrtopia", "videos": [{"id": 193144, "name": "Trailer", "video_id": "tM4ws6lwZwM", "url": "https://www.youtube.com/watch?v=tM4ws6lwZwM", "title": "Purrtopia - Official Announcement Trailer", "thumb": "https://i.ytimg.com/vi/tM4ws6lwZwM/maxresdefault.jpg"}]}