ious Murasame Castle featuring the character Takamaru.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 22, "name": "Historical"}], "url": "https://www.igdb.com/games/samurai-warriors-3", "videos": [{"id": 39130, "name": "Game Intro", "video_id": "79YMSG5o2gQ", "url": "https://www.youtube.com/watch?v=79YMSG5o2gQ", "title": "\u6226\u56fd\u7121\u53cc\uff13\u3000OP", "thumb": "https://i.ytimg.com/vi/79YMSG5o2gQ/hqdefault.jpg"}, {"id": 5421, "name": "Trailer", "video_id": "HkZSnui_sF0", "url": "https://www.youtube.com/watch?v=HkZSnui_sF0", "title": "Samurai Warriors 3 (Wii) Launch Trailer", "thumb": "https://i.ytimg.com/vi/HkZSnui_sF0/hqdefault.jpg"}], "collections": [{"id": 763, "name": "Samurai Warriors"}]}