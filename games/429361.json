{"id": 1987786, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16lsa.jpg"}, {"id": 1987785, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16ls9.jpg"}, {"id": 1987791, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16lsf.jpg"}, {"id": 1987787, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16lsb.jpg"}], "slug": "gravediggers--1", "summary": "GraveDiggers is an online co-op game for 1 to 6 players in which the players are undertaker cats. Each in-game day, the team has to find a body, carry it in a coffin to a cemetery hidden somewhere in the landscape and dig its grave before the day ends. If the sun rises on an unburied body, the curse level goes up and the day starts over. A necromancer tries to steal the bodies, and at midnight a sphere of mist starts closing in on the map. Players split up to scout, carry the coffin together and fight off enemies, with physics-based handling and landmarks holding loot and secrets.", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/gravediggers--1", "videos": [{"id": 203009, "name": "Trailer", "video_id": "o6POW3rskB4", "url": "https://www.youtube.com/watch?v=o6POW3rskB4", "title": "GraveDiggers | Playtest Trailer - Co-op Horror with Cats", "thumb": "https://i.ytimg.com/vi/o6POW3rskB4/fhddefault.jpg"}, {"id": 203012, "name": "Teaser", "video_id": "nbiTok8-lG0", "url": "https://www.youtube.com/watch?v=nbiTok8-lG0", "title": "Where is the coffin? | GraveDiggers, Co-op Horror with Cats", "thumb": "https://i.ytimg.com/vi/nbiTok8-lG0/maxresdefault.jpg"}]}