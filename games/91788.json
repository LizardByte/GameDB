s": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/touki-denshou-angel-eyes", "videos": [{"id": 159334, "name": "Trailer", "video_id": "QxfdKC5-GpI", "url": "https://www.youtube.com/watch?v=QxfdKC5-GpI", "title": "Toukidenshou - Angel Eyes VER. 960 MAME Gameplay video Snapshot -Rom name tkdensho-", "thumb": "https://i.ytimg.com/vi/QxfdKC5-GpI/sddefault.jpg"}]}