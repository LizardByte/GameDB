0c6\u30e0\u642d\u8f09\n\u30fb\u540c\u3058\u4e16\u754c\u89b3\u3092\u6301\u3064\u300eCresteaju\u300f\uff08Switch\u72482020\u5e74\u767a\u58f2\uff09\u3068\u306e\u4e16\u754c\u89b3\u306e\u3064\u306a\u304c\u308a\u3082\u697d\u3057\u3081\u308b\n\u30fb\u30df\u30cb\u30b2\u30fc\u30e0\u300e\u57f4\u8f2a\u9053\u300f\u53ce\u9332\n\n\n\u3010\u30ad\u30e3\u30b9\u30c8\uff08\u656c\u79f0\u7565\uff09\u3011\n\u30a2\u30eb\u30e4\uff1a \u4f0a\u702c\u7d50\u9678\n\u30c6\u30a3\u30fc\u30cd \uff1a\u76f8\u5ddd\u9065\u82b1\n\u30d2\u30ed \uff1a\u590f\u4ee3\u3081\u3050\u307f\n\u30ec\u30a4\u30b7\u30b9 \uff1a\u4e03\u6d77\u3053\u3053\u308d\n\u30bb\u30a4\u30eb\uff1a \u590f\u76ee\u97ff\u5e73\n\u30eb\u30fc\u30b7\u30fc \uff1a\u5c0f\u67f3\u65e5\u83dc\n\u30df\u30ca \uff1a\u307b\u305f\u304b\u3051\u308b\n\u30ec\u30a4\u30ac \uff1a\u5bae\u702c\u5c1a\u4e5f\n\u30b8\u30a2 \uff1a\u79cb\u8449\u606d\u5e73\n\u30e9\u30f4\u30a3\u30c3\u30c4\uff1a \u6e21\u8fba\u7d18\n\u30a2\u30e9\u30cd\u30a2\uff1a \u590f\u4ee3\u3081\u3050\u307f\n\u30a2\u30fc\u30bc\u30b9\uff0f\u30c0\u30a4\u30b5\u30af \uff1a\u4f50\u6771\u5145\n\u30c9\u30eb\u30ac\u30a4\u30e9\u30b9\uff0f\u9752\u306e\u9b42\uff0f\u30d0\u30ca\u30ca \uff1a\u4e0a\u7530\u3053\u3046\u3059\u3051\n\u30ec\u30f3\uff0f\u30b7\u30f3\uff0f\u30bc\u30f3\uff0f\u30d5\u30a7\u30f3\uff0f\u30aa\u30a6\u30c8 \uff1a\u7802\u5c71\u54f2\u82f1\n\u30ce\u30fc\u30c6\u30a3\u30b9\uff0f\u30a6\u30cb\u30ae\u30eb\u30c9\u7dcf\u9577\uff0f\u30d5\u30a9\u30fc\u30eb\u30f3 \uff1a\u5742\u4e0a\u6676\n\u30a8\u30eb\u30c9\uff0f\u753a\u9577\u30b0\u30e9\u30a6\u30c0\u30fc\uff0f\u30a2\u30eb\u30fc\u30bb\u30bf\u306e\u9577\u8001\uff1a \u5ddd\u4e0a\u6643\u4e8c\n\u30b8\u30a7\u30a4\u30f3\uff0f\u30b7\u30e3\u30cd\u30a4\u30f3 \uff1a\u9808\u7530\u52dd\u4e5f\n\u30bd\u30e0\u30e4\u30fc\u30c9\uff0f\u8001\u795e\u5b98 \uff1a\u85e4\u91ce\u88d5\u898f\n\u30a4\u30fc\u30b0\u30eb\uff0f\u30b0\u30ec\u30a4\uff1a \u5ba4\u4e95\u6d77\u4eba\n\u30de\u30bc\u30eb\u30b9\uff0f\u30ac\u30cf\u30c7\u30a3\uff0f\u30a4\u30a8\u30ed\u30fc\u30b7\u30c6\u30a3\u30fc\u753a\u9577 