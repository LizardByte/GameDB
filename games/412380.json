{"id": 412380, "artworks": [{"id": 297747, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6dqr.jpg"}, {"id": 297760, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6dr4.jpg"}], "cover": {"id": 589368, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cocmrc.jpg"}, "external_games": [{"id": 3201640, "name": "NARON", "uid": "153924207", "url": "https://www.twitch.tv/directory/game/NARON", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 3201334, "name": "Naron", "uid": "4828260", "url": "https://store.steampowered.com/app/4828260", "external_game_source": {"id": 1, "name": "Steam"}}], "genres": [{"id": 31, "name": "Adventure"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 405955, "company": {"id": 70825, "name": "Tideraft"}, "developer": true}], "multiplayer_modes": [{"id": 43784, "campaigncoop": false, "dropin": false, "game": 412380, "lancoop": false, "offlinecoop": false, "offlinemax": 0, "onlinecoop": true, "onlinecoopmax": 4, "platform": 6, "splitscreen": false, "checksum": "4e54341e-5ee2-8b99-53b6-b9cf51a93e89"}], "name": "Naron", "platforms": [6], "player_perspectives": [{"id": 1, "name": "First person"}], "screenshots": [{"id": 1926552, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15ajc.jpg"}, {"id": 1926545, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj5.jpg"}, {"id": 1926544, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj4.jpg"}, {"id": 1926548, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj8.jpg"}, {"id": 1926549, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj9.jpg"}, {"id": 1926547, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj7.jpg"}, {"id": 1926553, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15ajd.jpg"}, {"id": 1926546, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aj6.jpg"}, {"id": 1926551, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15ajb.jpg"}, {"id": 1926550, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15aja.jpg"}], "slug": "naron", "summary": "Naron is a co-op mining roguelite for 1-4 players. You take a drillship twenty depths down into a dying moon. Every depth has an objective waiting, and the drill won't move until it's done.\n\nBetween depths the crew decides the route together at the map table. Two depths ahead are visible: the biome, the task and the hazards waiting there. The safe route pays less, the hard one pays more, and there is no going back.\n\nThe rock is fully deformable - no fixed mining nodes anywhere. And every bit of progress on the main objective wakes the moon: pressure fronts tear open, broods swarm out, the way back gets more expensive. If the crew falls, the run is over - what you learned and permanently unlocked comes with you into the next one.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/naron", "videos": [{"id": 192134, "name": "Trailer", "video_id": "Ffl-8YQqg8g", "url": "https://www.youtube.com/watch?v=Ffl-8YQqg8g", "title": "NARON \u2013 Official Teaser Trailer | Co-op Mining Roguelite (1\u20134 Players)", "thumb": "https://i.ytimg.com/vi/Ffl-8YQqg8g/fhddefault.jpg"}, {"id": 196904, "name": "Trailer", "video_id": "IxligRgLpsw", "url": "https://www.youtube.com/watch?v=IxligRgLpsw", "title": "NARON \u2013 Playtest Trailer | Co-op Mining Roguelite (1\u20134 Players)", "thumb": "https://i.ytimg.com/vi/IxligRgLpsw/fhddefault.jpg"}]}