}, {"id": 1533319, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwv47.jpg"}, {"id": 1533320, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwv48.jpg"}], "slug": "predator-2", "storyline": "Loosely based on the events of the film.\n\nLos Angeles Lieutenant Mike Harrington is used to dealing with a drug war between Spanish and Jamaican drug gangs, but how he's caught up in the city's worst nightmare! The fearsome Predator species of alien has arrived, out to wreak serious destruction. It is your job to stop it.", "summary": "The game is a crosshair shooter influenced by Operation Wolf. The viewpoint is from slightly behind Harrington, while the game scrolls on as you clear each section. Mouse control is offered on 16-bit versions. Your armour must be kept functional by collecting top-ups, and there are weapon power-ups such as machine guns and rocket launchers to be had. You can't go in all-guns-blazing however, as killing a single innocent causes Harrington to lose his job.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/predator-2", "videos": [{"id": 150432, "name": "Gameplay Video", "video_id": "G036IGYYJZA", "url": "https://www.youtube.com/watch?v=G036IGYYJZA", "title": "Amiga 500 Longplay [161] Predator 2", "thumb": "https://i.ytimg.com/vi/G036IGYYJZA/maxresdefault.jpg"}, {"id": 150433, "name": "Gameplay Video", "video_id": "hDdfIX2ALBI", "url": "https://www.youtube.com/watch?v=hDdfIX2ALBI", "title": "ATARI ST Predator 2 Imageworks Image Works Mirrorsoft Mirror Soft 20th Century Fox AutomationMenu477", "thumb": "https://i.ytimg.com/vi/hDdfIX2ALBI/maxresdefault.jpg"}, {"id": 150434, "name": "Gameplay Video", "video_id": "xGfa0PpDm1w", "url": "https://www.youtube.com/watch?v=xGfa0PpDm1w", "title": "Predator 2 Longplay (C64) [50 FPS]", "thumb": "https://i.ytimg.com/vi/xGfa0PpDm1w/maxresdefault.jpg"}]}