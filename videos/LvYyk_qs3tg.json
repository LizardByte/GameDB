435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b \u0441 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f\u043c\u0438 \u0434\u043b\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u0433\u0440\u044b \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438, \u0447\u0442\u043e \u043f\u0435\u0440\u0435\u0440\u043e\u0441\u043b\u043e \u0432 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u043c\u043d\u043e\u0433\u043e\u043b\u0435\u0442\u043d\u0438\u0439 \u043f\u0440\u043e\u0435\u043a\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0443\u0436\u0435 \u043d\u0435\u043e\u0434\u043d\u043e\u043a\u0440\u0430\u0442\u043d\u043e \u043c\u0435\u043d\u044f\u043b\u0441\u044f, \u043f\u0435\u0440\u0435\u0436\u0438\u0432 \u043c\u043d\u043e\u0433\u043e \u0432\u0437\u043b\u0451\u0442\u043e\u0432 \u0438 \u043f\u0430\u0434\u0435\u043d\u0438\u0439."}}}