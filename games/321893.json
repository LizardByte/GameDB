s": [386, 6, 471], "player_perspectives": [{"id": 1, "name": "First person"}], "release_dates": [{"id": 836134, "date": 1763596800, "platform": 6, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 935515, "date": 1783555200, "platform": 6, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1503745, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8ap.jpg"}, {"id": 1503746, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8aq.jpg"}, {"id": 1503747, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8ar.jpg"}, {"id": 1503741, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8al.jpg"}, {"id": 1503742, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8am.jpg"}, {"id": 1503743, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8an.jpg"}, {"id": 1503744, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw8ao.jpg"}], "slug": "cursed-companions", "storyline": "Explore the dungeons and seek Treasure for the Dark Queen. But beware, for these Treasures are cursed with forbidden words that will hurt you if they are spoken.\n\nBring the Treasures home for the Dark Queen, and you will gain her favor. But if you don\u2019t collect enough Treasure\u2026 the consequences are dire.\n\nRemember, you must always meet the target!\n\nLook out for loot along the way \u2014 selling them will allow you to buy equipment and upgrade your skills. And with enough gold, you and your companions can turn your humble hearth into a tasteful mansion!\n\nDungeons are procedurally generated, every run is a brand-new experience. The dungeons go deeper as the game progresses, so try not to get lost!\n\nThe Dark Queen assures you that all dungeon creatures are safe and cuddly. Just try not to aggravate them. From monsters that hunt by sound to ones that you have to shoo away by yelling, there\u2019s always a way to survive your wildlife experience.\n\nCommunication is key to Cursed Companions \u2014 what you say or don\u2019t say to each other will determine the success or failure of your mission. And don\u2019t forget, the real treasure was the friends we made along the way.", "summary": "Co-op horror with voice activation where the game listens to what everyone is saying. Say the right words to save friends, but the wrong words bring chaos, death and laughs. Explore procedurally generated dungeons, seek treasure, and try to survive the mayhem. Play up to 8 players in Co-op Mode and up to 16 players in Traitor Mode.", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/cursed-companions", "videos": [{"id": 132586, "name": "Gameplay Trailer", "video_id": "YaY54SjhrPo", "url": "https://www.youtube.com/watch?v=YaY54SjhrPo", "title": "Cursed Companions Main Trailer (2024)", "thumb": "https://i.ytimg.com/vi/YaY54SjhrPo/maxresdefault.jpg"}, {"id": 135420, "name": "Gameplay Trailer", "video_id": "LBjAzweya0k", "url": "https://www.youtube.com/watch?v=LBjAzweya0k", "title": "Cursed Companions Trailer and Gameplay (2025)", "thumb": "https://i.ytimg.com/vi/LBjAzweya0k/fhddefault.jpg"}, {"id": 189208, "name": "Trailer", "video_id": "K5XnfqoBXfU", "url": "https://www.youtube.com/watch?v=K5XnfqoBXfU", "title": "Cursed Companions Official Release Trailer (2026)", "thumb": "https://i.ytimg.com/vi/K5XnfqoBXfU/fhddefault.jpg"}]}