d": 432703, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc99vj.jpg"}, {"id": 432704, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc99vk.jpg"}, {"id": 432705, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc99vl.jpg"}, {"id": 432706, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc99vm.jpg"}], "slug": "a-tale-in-the-desert", "summary": "A Tale in the Desert is a Massive Multiplayer Online Roleplaying Game (MMO), presented by Desert Nomad Studios, and set in ancient Egypt.\n\nThe game focuses on crafting and trading, mixed with strong social and political challenges, and has absolutely no combat.\n\nWithin the game is one of the most complex crafting and trade skill systems that have ever been created. This is coupled with tests in various disciplines that challenge players to work together or against each other. Be creative in the arts or build massive structures, create complex thought puzzles to challenge other players.\n\nThe game is a great sociological experiment, asking questions like \"Will players work together in a project when working against each other could potentially have more benefit to one of them?\".", "themes": [{"id": 33, "name": "Sandbox"}], "url": "https://www.igdb.com/games/a-tale-in-the-desert", "videos": [{"id": 48099, "name": "Gameplay Video", "video_id": "N6xmS2B_yfQ", "url": "https://www.youtube.com/watch?v=N6xmS2B_yfQ", "title": "A Tale in the Desert: Tale 9 - Part 1 - Welcome Island (ATitD)", "thumb": "https://i.ytimg.com/vi/N6xmS2B_yfQ/maxresdefault.jpg"}]}