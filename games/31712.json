latforms": [6], "player_perspectives": [{"id": 1, "name": "First person"}, {"id": 2, "name": "Third person"}], "rating": 69.66887972143513, "release_dates": [{"id": 546921, "date": 1535500800, "platform": 6, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 752328, "date": 1750118400, "platform": 6, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 49613, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lsohksnmekakdly0zkkl.jpg"}, {"id": 49614, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qz8fxyfg1ilgppej4c6m.jpg"}, {"id": 49615, "url": "//images.igdb.com/igdb/image/upload/t_thumb/wydlbdhi827yukf0tl8m.jpg"}, {"id": 213871, "url": "//images.igdb.com/igdb/image/upload/t_thumb/gjz4tfdbgkaihw2dvg5n.jpg"}, {"id": 213872, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bd9zjqv8jmrvgug0akpd.jpg"}, {"id": 213873, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dvowbdqdrvb09mnli9ne.jpg"}, {"id": 210453, "url": "//images.igdb.com/igdb/image/upload/t_thumb/rzmute2zza9wnit6xdwn.jpg"}, {"id": 210455, "url": "//images.igdb.com/igdb/image/upload/t_thumb/eofekhg8tnwoks7po1sy.jpg"}, {"id": 210454, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ovodgzbege5l2buhrh4w.jpg"}, {"id": 1387301, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctqg5.jpg"}, {"id": 1387300, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctqg4.jpg"}, {"id": 49611, "url": "//images.igdb.com/igdb/image/upload/t_thumb/csedss0hnfxfkgqzuryw.jpg"}, {"id": 210452, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bk9gmvkgq5ujq5ciqazz.jpg"}], "slug": "scum", "storyline": "In a not-too-distant future where entertainment has turned bloodthirsty, the powerful TEC1 corporation transforms convicted prisoners into unwilling stars of the world\u2019s most brutal survival show: SCUM. Dropped onto a deadly island, inmates must fight, hunt, craft, and outsmart both each other and the horrors engineered to keep viewers watching. Every kill, escape, alliance, and betrayal feeds the broadcast, earning fame, sponsors, and the faint hope of survival. But on SCUM Island, freedom is never guaranteed, death may not be the end, and every desperate choice is part of the show.", "summary": "Scum aims to evolve the multiplayer open world survival game with unprecedented levels of character customization, control and progression, where knowledge and skills are the ultimate weapons for long-term survival. Combining the methodical planning and management of hardcore survival with optional PvP \u2018network events\u2019 available to everyone at anytime, SCUM strikes a unique balance between complex simulation and intense action in the next generation of survival game.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 21, "name": "Survival"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/scum", "videos": [{"id": 20544, "name": "Early Access Teaser Trailer", "video_id": "yO3fUu9Wdp4", "url": "https://www.youtube.com/watch?v=yO3fUu9Wdp4", "title": "SCUM - Early Access Teaser Trailer", "thumb": "https://i.ytimg.com/vi/yO3fUu9Wdp4/maxresdefault.jpg"}, {"id": 153310, "name": "Gameplay Trailer", "video_id": "bF_0I055h7I", "url": "https://www.youtube.com/watch?v=bF_0I055h7I", "title": "Scum 1.0 Gameplay Trailer - Future Games Show Summer Showcase 2025", "thumb": "https://i.ytimg.com/vi/bF_0I055h7I/maxresdefault.jpg"}, {"id": 154121, "name": "Launch Trailer", "video_id": "qcLxrICgixU", "url": "https://www.youtube.com/watch?v=qcLxrICgixU", "title": "SCUM 1.0 CINEMATIC LAUNCH TRAILER 4K", "thumb": "https://i.ytimg.com/vi/qcLxrICgixU/maxresdefault.jpg"}, {"id": 195062, "name": "Trailer", "video_id": "p24sHIp4Cw8", "url": "https://www.youtube.com/watch?v=p24sHIp4Cw8", "title": "SCUM | FPS Games Show 2026", "thumb": "https://i.ytimg.com/vi/p24sHIp4Cw8/fhddefault.jpg"}]}