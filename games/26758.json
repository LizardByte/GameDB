, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qgcn3akcfv4rvojqdbvb.jpg"}, {"id": 174802, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tznt5qzxdqdzqxsy1crl.jpg"}, {"id": 174799, "url": "//images.igdb.com/igdb/image/upload/t_thumb/equ6v5psjfdq2sepgw41.jpg"}, {"id": 174801, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xugrhmbobkhqi2pgs0xs.jpg"}, {"id": 1010715, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sclnvf.jpg"}], "slug": "super-mario-odyssey", "storyline": "Bowser has kidnapped Princess Peach once again, but this time, he plans to force her into a royal wedding! Mario sets off on a globe-trotting adventure beyond the Mushroom Kingdom, teaming up with Cappy, a mysterious hat-shaped spirit from the Cap Kingdom whose sister Tiara was also taken by Bowser.\n\nTogether, they travel across vast and colorful kingdoms aboard the airship Odyssey, collecting Power Moons to fuel their journey. Using Cappy\u2019s powers, Mario can \u201ccapture\u201d enemies, objects, and creatures to gain their abilities, from a Goomba stack to a mighty T-Rex.\n\nFrom the bustling streets of New Donk City to the frozen peaks of the Snow Kingdom, Mario and Cappy must chase Bowser across the world to stop his forced wedding and rescue Peach and Tiara before it\u2019s too late.", "summary": "Explore incredible places far from the Mushroom Kingdom as you join Mario and his new ally Cappy on a massive, globe-trotting 3D adventure. Use amazing new abilities, like the power to capture and control objects, animals, and enemies to collect Power Moons so you can power up the Odyssey airship and save Princess Peach from Bowser\u2019s wedding plans!", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/super-mario-odyssey", "videos": [{"id": 14436, "name": "Gameplay video", "video_id": "_GQGUGe7kDU", "url": "https://www.youtube.com/watch?v=_GQGUGe7kDU", "