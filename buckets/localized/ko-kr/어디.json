{"257267": {"name": "\uc5b4\ub514\uc11c \ub9ce\uc774 \ubcf8 \uadf8 \uac8c\uc784\uc744 \ub9c9\ub300 \uc778\uac04\uc73c\ub85c \uc9c4\uc9dc \ub9cc\ub4e4\uc5b4 \ubd24\ub294\ub370, \uacfc\uc5f0 \ub2f9\uc2e0\uc774 \ud074\ub9ac\uc5b4\ud560 \uc218 \uc788\uc744\uae4c?"}, "308732": {"name": "\uc5b4\ub514\uc11c \ub9ce\uc774 \ubcf8 \uadf8 \uac8c\uc784\uc744 \ub9c9\ub300 \uc778\uac04\uc73c\ub85c \uc9c4\uc9dc \ub9cc\ub4e4\uc5b4 \ubd24\ub294\ub370, \uacfc\uc5f0 \ub2f9\uc2e0\uc774 \ud074\ub9ac\uc5b4\ud560 \uc218 \uc788\uc744\uae4c? 2"}, "341942": {"name": "\uc5b4\ub514\uc11c \ub9ce\uc774 \ubcf8 \"\uadf8 \uac8c\uc784\"\uc744 \ub354 \uaca9\ud558\uac8c \ub9cc\ub4e4\uc5b4 \ubd24\ub294\ub370, \ub9c9\ub300 \uc778\uac04\uc73c\ub85c\ub294 \ud55c\uacc4\uac00 \uc788\uc5c8\ub358 \uac74\uc5d0 \ub300\ud558\uc5ec."}}