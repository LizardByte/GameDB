, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc149c5.jpg"}, {"id": 1878342, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc149c6.jpg"}, {"id": 1878343, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc149c7.jpg"}, {"id": 1878344, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc149c8.jpg"}], "slug": "pidgeon-pocket", "storyline": "A rooftop pigeon-keeper trains a small flock of city pigeons to work the park below. Round after round the pigeons slip into the crowd, lift coins from unsuspecting pockets and fly the loot home, while the local police slowly wise up to the feathered crime wave.", "summary": "Pidgeon Pocket is a chill incremental game about a rooftop pigeon-keeper who sends a flock of trained pigeons into a living city park to pickpocket small valuables from park-goers and bring the loot home. Each round the park transforms into a different live event, from a marathon or a street parade to a market, a concert or a dog show, while an intelligent police force reacts to every theft. Progression runs through a skill tree of abilities and rotating talents, growing the flock from a single pigeon into a full squad. Localized into 30 languages, fully playable with mouse, keyboard or controller, and built to run on Steam Deck.", "themes": [{"id": 23, "name": "Stealth"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/pidgeon-pocket", "videos": [{"id": 190193, "name": "Trailer", "video_id": "lLqTWkM48oY", "url": "https://www.youtube.com/watch?v=lLqTWkM48oY", "title": "Pidgeon Pocket official trailer", "thumb": "https://i.ytimg.com/vi/lLqTWkM48oY/sddefault.jpg"}]}