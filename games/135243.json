inecoop": true, "onlinecoopmax": 2, "splitscreen": true, "checksum": "28cc6564-d5e9-8948-151a-7121453c92e4"}], "name": "It Takes Two", "platforms": [169, 48, 6, 167, 49, 130], "player_perspectives": [{"id": 2, "name": "Third person"}], "rating": 88.5159810951886, "release_dates": [{"id": 539826, "date": 1616630400, "platform": 6, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 539828, "date": 1616716800, "platform": 167, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 539830, "date": 1616716800, "platform": 169, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 539825, "date": 1667520000, "platform": 130, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 539827, "date": 1616716800, "platform": 48, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 539829, "date": 1616716800, "platform": 49, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 389382, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8cg6.jpg"}, {"id": 389380, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8cg4.jpg"}, {"id": 389381, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8cg5.jpg"}, {"id": 389383, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8cg7.jpg"}], "slug": "it-takes-two", "storyline": "Cody and May, a married couple planning to divorce, break the news to their daughter Rose. Upset, Rose takes handmade dolls resembling her parents into the family shed, and her tears cause Cody and May to become trapped inside the dolls. They are confronted by Dr. Hakim, an anthropomorphic relationship therapy book who says he has been tasked with fixing their marriage. As Cody and May try to find a way back to their human bodies, Hakim places obstacles and collaborative challenges in their path, forcing them to work together. Along the way, they encounter personified versions of their neglected possessions, rediscover their individual passions, and are reminded of what brought them together.", "summary": "It Takes Two is a cooperative action-adventure game designed exclusively for two players, playable in local split-screen or online. Players control Cody and May, a married couple transformed into dolls, as they travel through fantastical environments based on their home and relationship. Gameplay combines platforming, puzzle-solving, and action sequences, with each level introducing new mechanics and giving the two characters different abilities that must be used together to progress. The game frequently changes its core mechanics from chapter to chapter, incorporating sections involving shooting, racing, flight, and other genres.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/it-takes-two", "videos": [{"id": 43578, "name": "Trailer", "video_id": "ohClxMmNLQQ", "url": "https://www.youtube.com/watch?v=ohClxMmNLQQ", "title": "It Takes Two Official Reveal Trailer", "thumb": "https://i.ytimg.com/vi/ohClxMmNLQQ/maxresdefault.jpg"}, {"id": 37708, "name": "Announcement Trailer", "video_id": "blwlcwlAXwA", "url": "https://www.youtube.com/watch?v=blwlcwlAXwA", "title": "The Return of a Visionary \u2013 Josef Fares and Hazelight", "thumb": "https://i.ytimg.com/vi/blwlcwlAXwA/maxresdefault.jpg"}]}