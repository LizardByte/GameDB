olved_companies": [{"id": 190189, "company": {"id": 129, "name": "Konami"}, "developer": true}], "name": "Pro Evolution Soccer 2014", "platforms": [9, 6, 12], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "rating": 66.25722660620542, "release_dates": [{"id": 778329, "date": 1379635200, "platform": 6, "y": 2013, "release_region": {"id": 1, "region": "europe"}}, {"id": 778332, "date": 1379980800, "platform": 9, "y": 2013, "release_region": {"id": 2, "region": "north_america"}}, {"id": 778333, "date": 1379548800, "platform": 9, "y": 2013, "release_region": {"id": 1, "region": "europe"}}, {"id": 778337, "date": 1379980800, "platform": 12, "y": 2013, "release_region": {"id": 2, "region": "north_america"}}, {"id": 778330, "date": 1380758400, "platform": 6, "y": 2013, "release_region": {"id": 3, "region": "australia"}}, {"id": 778331, "date": 1384214400, "platform": 6, "y": 2013, "release_region": {"id": 2, "region": "north_america"}}, {"id": 778334, "date": 1380758400, "platform": 9, "y": 2013, "release_region": {"id": 3, "region": "australia"}}, {"id": 778335, "date": 1384387200, "platform": 9, "y": 2013, "release_region": {"id": 5, "region": "japan"}}, {"id": 778336, "date": 1379635200, "platform": 12, "y": 2013, "release_region": {"id": 1, "region": "europe"}}, {"id": 778338, "date": 1380153600, "platform": 12, "y": 2013, "release_region": {"id": 7, "region": "asia"}}, {"id": 778339, "date": 1380758400, "platform": 12, "y": 2013, "release_region": {"id": 3, "region": "australia"}}], "screenshots": [{"id": 25539, "url": "//images.igdb.com/igdb/image/upload/t_thumb/v86karvuqcnnavih7zrj.jpg"}, {"id": 25540, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qdrd0pojsjhc0cavovwr.jpg"}, {"id": 25542, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ugkqksy7fkrfiyts8qfb.jpg"}, {"id": 25541, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mwcnkavix3hhn4idp26s.jpg"}, {"id": 25543, "url": "//images.igdb.com/igdb/image/upload/t_thumb/vjxsdkbzd5sseirfgkod.jpg"}], "slug": "pro-evolution-soccer-2014", "summary": "Pro Evolution Soccer 2014 (PES 2014) is a football simulation game developed by Konami. Released in 2013, it is part of the long-running Pro Evolution Soccer series and introduces a new engine, updated mechanics, and expanded features across multiple platforms.\n\nPES 2014 centers gameplay around realistic ball physics, player motion, and team dynamics. It introduces the Motion Animation Stability System (M.A.S.S.) to enhance physical interactions between players, making tackles, collisions, and positioning more lifelike. The game also features a morale system where crowd influence and individual performances affect team behavior on the pitch.\n\nThe Player ID system, first introduced in PES 2013, is expanded to cover more star players and now replicates full squad behaviors to reflect real-world playing styles. A new Combination Plan allows users to coordinate tactical plays among three or more players, enabling more diverse and strategic attacking options.\n\nAdditional features include the ability to switch clubs or coach national teams in Master League, create third and fourth kits (with some official options), and play the UEFA Europa League in a dedicated mode.", "themes": [{"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/pro-evolution-soccer-2014", "videos": [{"id": 120011, "name": "Teaser", "video_id": "g54BRukQEJA", "url": "https://www.youtube.com/watch?v=g54BRukQEJA", "title": "E3 2013 Teaser: PES 2014 Trailer \u3010HD\u3011", "thumb": "https://i.ytimg.com/vi/g54BRukQEJA/hqdefault.jpg"}], "collections": [{"id": 195, "name": "Pro Evolution Soccer"}, {"id": 8363, "name": "World Soccer Winning Eleven"}]}