}], "slug": "digimon-story-time-stranger", "storyline": "Dan or Kanan Yuki is an agent of ADAMAS, a covert organization investigating digital anomalies across Tokyo. During an operation in Shinjuku, the agent witnesses the Shinjuku Inferno, a catastrophic outbreak of war between Digimon that devastates the district and flings the agent eight years into the past. There they meet a girl named Inori Misono and Aegiomon, a Digimon in her care, and are soon pulled through a space-time rift into Iliad, the Digital World, where a gang of rogue Digimon called the Titans has thrown both realms into chaos. Racing between past and present, the agent works to uncover the true cause of the disaster and prevent the collapse of the human and Digital Worlds.", "summary": "The latest in the Digimon Story series is finally here! In this RPG, unravel a mystery that spans across the human world and the Digital World, collecting and raising a wide variety of Digimon to save the world.", "themes": [{"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/digimon-story-time-stranger", "videos": [{"id": 140212, "name": "Announcement Trailer", "video_id": "npVx8cNyDe4", "url": "https://www.youtube.com/watch?v=npVx8cNyDe4", "title": "Digimon Story Time Stranger - Announcement Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/npVx8cNyDe4/maxresdefault.jpg"}, {"id": 155113, "name": "Dev Diary", "video_id": "13m4Ylsv6A4", "url": "https://www.youtube.com/watch?v=13m4Ylsv6A4", "title": "DIGIMON STORY TIME STRANGER \u2013 Deep Dive with Producer Hara-san | Bandai Namco Summer Showcase", "thumb": "https://i.ytimg.com/vi/13m4Ylsv6A4/maxresdefault.jpg"}, {"id": 152579, "name": "Release Date Trailer", "video_id": "IVvDc7_w5ZY", "url": "https://www.youtube.com/watch?v=IVvDc7_w5ZY", "title": "Digimon Story Time Stranger - Release Date Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/IVvDc7_w5ZY/maxresdefault.jpg"}, {"id": 155089, "name": "Trailer", "video_id": "ICCFACvxF84",