pg"}, {"id": 182371, "url": "//images.igdb.com/igdb/image/upload/t_thumb/nyjwhkgpuqp8l7g2fqlc.jpg"}, {"id": 182372, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mbhttsndsxyfjcxyygfn.jpg"}, {"id": 182370, "url": "//images.igdb.com/igdb/image/upload/t_thumb/wtjudfs29ihfzvkuu3pi.jpg"}, {"id": 182367, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yxkvwuk3vnrbvetfvxjo.jpg"}, {"id": 182369, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xxubmjp4wuong39zzlaz.jpg"}], "slug": "lego-star-wars-iii-the-clone-wars", "storyline": "This LEGO adventure retells events from the animated film and television series Star Wars: The Clone Wars in a playful, brick-built style. Set during the galaxy-spanning conflict between the Galactic Republic and the Separatist droid armies, it follows Jedi heroes like Anakin Skywalker, Obi-Wan Kenobi, and Ahsoka Tano as they lead clone troopers into battle. Players relive the war's memorable campaigns and skirmishes across many worlds. The familiar events are reimagined with the lighthearted humor and charm of LEGO.", "summary": "The Saga continues. Build, battle and laugh your way across the Star Wars universe like never before! Play as Anakin Skywalker and Obi-Wan Kenobi through a story spanning the entire Clone Wars era. LEGO Star Wars III: The Clone Wars combines epic space battles, challenging puzzles and of course, the imaginative gameplay of LEGO.\n\nThe Sith and their allies have declared war on the Jedi Council with an army of droids, and it\u2019s up to you to stop them. With the Dark Side gathering power and entire star systems in turmoil, galactic freedom hangs in the balance.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 27, "name": "Comedy"}, {"id": 35, "name": "Kids"}, {"id": 40, "name": "Party"}], "url": "https://www.igdb.com/games/lego-star-wars-iii-the-clone-wars", "videos": [{"id": 16491, "name": "Trailer", "video_id": "MCCWs05P-xA", "url": "https://www.youtube.com/watch?v=M