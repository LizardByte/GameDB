n"}}, {"id": 730784, "date": 1222646400, "platform": 5, "y": 2008, "release_region": {"id": 2, "region": "north_america"}}, {"id": 730786, "date": 1479340800, "platform": 41, "y": 2016, "release_region": {"id": 2, "region": "north_america"}}, {"id": 730785, "date": 1222387200, "platform": 5, "y": 2008, "release_region": {"id": 1, "region": "europe"}}, {"id": 730787, "date": 1459987200, "platform": 41, "y": 2016, "release_region": {"id": 1, "region": "europe"}}, {"id": 730788, "date": 1471996800, "platform": 41, "y": 2016, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 135589, "url": "//images.igdb.com/igdb/image/upload/t_thumb/njci7gdfzcgqndo2t82h.jpg"}, {"id": 178037, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zkbwzfygtonubqlyq7iq.jpg"}, {"id": 178035, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hxl4cy2fxiqjmkxx81ip.jpg"}, {"id": 135587, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hsgux01fchajuaigq24u.jpg"}, {"id": 135586, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ctw8dp5xaikz0flir5yd.jpg"}, {"id": 135588, "url": "//images.igdb.com/igdb/image/upload/t_thumb/oanzkfaa1brslvlr9kp3.jpg"}, {"id": 135585, "url": "//images.igdb.com/igdb/image/upload/t_thumb/olxgrmxtudha47nfckfb.jpg"}, {"id": 178038, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xzgfaixetg2mxzrifsl0.jpg"}, {"id": 178033, "url": "//images.igdb.com/igdb/image/upload/t_thumb/wgukvf9qq5rcrcpgwl7s.jpg"}, {"id": 178036, "url": "//images.igdb.com/igdb/image/upload/t_thumb/kssdkxphcb2qekui3oso.jpg"}, {"id": 178039, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ut1sbmudqziv6bfxzhzg.jpg"}, {"id": 178034, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qzaiwrkdpjt1aya7dpn3.jpg"}], "slug": "wario-land-shake-it", "storyline": "Wario Land: Shake It! is a side-scrolling platformer starring the greedy antihero Wario. The adventure begins when the treasure hunter Captain Syrup breaks into a museum and examines an ancient globe that holds a hidden realm known as the Shake Dimension. Peering inside, she witnesses a crisis unfolding: the tyrannical Shake King has seized power, imprisoning the benevolent Queen Merelda and her tiny Merfle subjects, and claiming the legendary Bottomless Coin Sack, a magical pouch that pours out an endless stream of coins when shaken. Scheming to profit, Syrup steals the globe and mails it to Wario, insisting the real treasure lies within. When one of the escaped Merfles emerges and pleads for help, Wario shows no interest until he hears of the Bottomless Coin Sack. Lured by the promise of infinite riches, the money-obsessed Wario follows the Merfle into the Shake Dimension to seize the prize and, almost incidentally, confront the Shake King's reign.", "summary": "Wario, Nintendo's greedy, uncouth and rude anti-hero, returns to his roots. The Wario Land series is where Wario first appeared, and it's back in all its side-scrolling, platform-jumping glory.", "themes": [{"id": 1, "name": "Action"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/wario-land-shake-it", "videos": [{"id": 62987, "name": "Trailer", "video_id": "XVsxFXvcZQY", "url": "https://www.youtube.com/watch?v=XVsxFXvcZQY", "title": "Wario Land: Shake It! (Wii) E3 Trailer", "thumb": "https://i.ytimg.com/vi/XVsxFXvcZQY/hqdefault.jpg"}, {"id": 62988, "name": "Trailer", "video_id": "yLJzo72vnzI", "url": "https://www.youtube.com/watch?v=yLJzo72vnzI", "title": "YouTube Custom Gadget : Wario Land: Shake It  Amazing footage!", "thumb": "https://i.ytimg.com/vi/yLJzo72vnzI/maxresdefault.jpg"}, {"id": 62989, "name": "Trailer", "video_id": "2r_AYT1FUYg", "url": "https://www.youtube.com/watch?v=2r_AYT1FUYg", "title": "Wario Land: Shake It! Trailer", "thumb": "https://i.ytimg.com/vi/2r_AYT1FUYg/maxresdefault.jpg"}], "collections": [{"id": 6065, "name": "Wario Land"}]}