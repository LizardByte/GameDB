{"id": 368081, "artworks": [{"id": 265897, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p61.jpg"}, {"id": 265888, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p5s.jpg"}, {"id": 265889, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p5t.jpg"}, {"id": 265890, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p5u.jpg"}, {"id": 265891, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p5v.jpg"}, {"id": 265898, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5p62.jpg"}], "cover": {"id": 555991, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cobx07.jpg"}, "external_games": [{"id": 3161536, "name": "ASTRAL COURT DX", "uid": "4568830", "url": "https://store.steampowered.com/app/4568830", "external_game_source": {"id": 1, "name": "Steam"}}, {"id": 3100336, "name": "Astral Court DX", "uid": "1818734817", "url": "https://www.twitch.tv/directory/game/Astral%20Court%20DX", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 8, "name": "Platform"}, {"id": 32, "name": "Indie"}, {"id": 33, "name": "Arcade"}], "involved_companies": [{"id": 346811, "company": {"id": 49677, "name": "LUA COMPUTA"}, "developer": true}], "name": "Astral Court DX", "platforms": [6], "player_perspectives": [{"id": 4, "name": "Side view"}], "release_dates": [{"id": 947881, "date": 1787616000, "platform": 6, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1815972, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12x7o.jpg"}, {"id": 1815974, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12x7q.jpg"}, {"id": 1815973, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12x7p.jpg"}, {"id": 1815975, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12x7r.jpg"}, {"id": 1815971, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12x7n.jpg"}], "slug": "astral-court-dx", "summary": "Astral Court DX is an arcade precision platformer! Taking place in Heaven, you play as \"The Prisoner\" - an infamous criminal who's been to prison one too many times and is sent to death-row! Heaven's one and only court, the Astral Court, is an... odd one... and decides to grant The Prisoner with a series of deadly trials that, if completed, will allow them to get out of prison scot-free!\n\nIn these trials, you platform on top of the Scales Of Justice, well several of them, collecting little stars named \"Shinies\" that spawn around the arena. You must collect a certain amount of Shinies all whilst avoiding whatever foes or obstacles have set up to stop you. Movement is made to give you as much control as possible to avoid hazards efficiently, you have a jump that can be performed even whilst falling and a double jump to get as much height as possible. There are a variety of other characters whom add extra challenge to the trials, accessible in the endless mode only however.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/astral-court-dx", "videos": [{"id": 163623, "name": "Announcement Trailer", "video_id": "tExNMBbhRks", "url": "https://www.youtube.com/watch?v=tExNMBbhRks", "title": "ASTRAL COURT DX - ANNOUNCEMENT TRAILER", "thumb": "https://i.ytimg.com/vi/tExNMBbhRks/maxresdefault.jpg"}, {"id": 180949, "name": "Trailer", "video_id": "ooX6tAwrcJA", "url": "https://www.youtube.com/watch?v=ooX6tAwrcJA", "title": "WISHLIST ASTRAL COURT DX", "thumb": "https://i.ytimg.com/vi/ooX6tAwrcJA/fhddefault.jpg"}]}