mpany": {"id": 70, "name": "Nintendo"}, "developer": false}], "multiplayer_modes": [{"id": 24940, "campaigncoop": false, "dropin": false, "game": 254339, "lancoop": false, "offlinecoop": true, "offlinecoopmax": 4, "onlinecoop": false, "onlinemax": 12, "splitscreen": false, "checksum": "0ac12090-7409-1f95-2272-6a46f5797fec"}], "name": "Super Mario Bros. Wonder", "platforms": [130], "player_perspectives": [{"id": 4, "name": "Side view"}], "rating": 87.43074158088703, "release_dates": [{"id": 485171, "date": 1697760000, "platform": 130, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1077507, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3er.jpg"}, {"id": 1077508, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3es.jpg"}, {"id": 1077509, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3et.jpg"}, {"id": 1077510, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3eu.jpg"}, {"id": 1077511, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3ev.jpg"}, {"id": 1077512, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scn3ew.jpg"}], "slug": "super-mario-bros-wonder", "storyline": "Mario and his friends are invited to the Flower Kingdom by its ruler, Prince Florian, to witness the power of a Wonder Flower. Bowser crashes the ceremony, steals the Wonder Flower, and uses its reality-warping magic to fuse himself with the kingdom's castle, transforming into a sentient flying fortress. He imprisons the kingdom's citizens, the Poplins, and begins plotting to enslave the entire universe. Mario and the group set out alongside Prince Florian to gather six Royal Seeds scattered across the kingdom's regions, each one removing a layer of Bowser's defenses and bringing them closer to a final confrontation.", "summary": "Super Mario Bros. Wonder is a side-scrolling platform game and the first 2D Super Mario entry since New Super Mario Bros. U (2012). Players choose from twelve characters and traverse levels across the Flower Kingdom, a new setting for the series. The game's central mechanic is the Wonder Flower, which dramatically alters levels in unpredictable ways when touched. New power-ups include an elephant transformation, a bubble flower, and a drill hat, while an equippable badge system allows players to customize their abilities. The game supports local multiplayer for up to four active players and includes an asynchronous online mode.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/super-mario-bros-wonder", "videos": [{"id": 92391, "name": "Trailer", "video_id": "JStAYvbeSHc", "url": "https://www.youtube.com/watch?v=JStAYvbeSHc", "title": "Super Mario Bros. Wonder - Nintendo Direct 6.21.2023", "thumb": "https://i.ytimg.com/vi/JStAYvbeSHc/maxresdefault.jpg"}, {"id": 98393, "name": "Gameplay Trailer", "video_id": "ljx3QQ4uApg", "url": "https://www.youtube.com/watch?v=ljx3QQ4uApg", "title": "Super Mario Bros. Wonder \u2013 Overview Trailer \u2013 Nintendo Switch", "thumb": "https://i.ytimg.com/vi/ljx3QQ4uApg/maxresdefault.jpg"}], "collections": [{"id": 6118, "name": "Super Mario Bros."}, {"id": 240, "name": "Super Mario"}]}