 1924783, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15967.jpg"}, {"id": 1924775, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1595z.jpg"}, {"id": 1924777, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15961.jpg"}, {"id": 1924778, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15962.jpg"}, {"id": 1924779, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15963.jpg"}, {"id": 1924780, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15964.jpg"}, {"id": 1924774, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1595y.jpg"}], "slug": "kingdom-of-night", "storyline": "One night, in 1987, in the small town of Miami, Arizona, a satanic cult unwittingly summons the ancient evil, Baphomet, catapulting the town into chaos. John, awoken by the kidnapping of his neighbor, sets out into the night to fight back against the demonic invasion and rescue his friends before it's too late...\n\nTake control of John as his adventure leads him through an hour-by-hour experience of what could be everyone's last night on Earth. As John, you will encounter unearthly evils, Demon lords, afflicted townsfolk, high school bullies, and a torrent of engaging, serial-like side stories \u2013 all nested in a larger-than-life fantasy that brings the ultimate evil to a neighborhood near you.\n\nChoose your class, customize your abilities, and battle nightmarish creatures as you collect unique gear in order to infiltrate the massive lairs of Demon lords that have taken over the town.", "summary": "Kingdom of Night is an 80s-inspired isometric action RPG where coming-of-age drama meets cosmic horror.\n\nWhen a satanic cult unleashes the ancient evil Baphomet on the small town of Miami, Arizona, high school student John must fight through a night of demonic chaos to rescue his friends before the town is lost forever.\n\nChoose from five distinct classes\u2014Barbarian, Knight, Rogue, Necromancer, or Sorcerer\u2014and customize your build with expansive skill trees, powerful loot, and unique equipment. Explore the town freely, battle terrifying Demon Generals in any order, uncover the stories of Miami's residents, and descend into massive demon lairs.\n\nFace the apocalypse alone or team up with a friend in local co-op to save Miami before the night ends.", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/kingdom-of-night", "videos": [{"id": 45534, "name": "Announcement Trailer", "video_id": "sCjwczn3i3I", "url": "https://www.youtube.com/watch?v=sCjwczn3i3I", "title": "Kingdom of Night - Kickstarter Announcement Trailer", "thumb": "https://i.ytimg.com/vi/sCjwczn3i3I/maxresdefault.jpg"}, {"id": 45535, "name": "Trailer", "video_id": "AMa-oZY1gok", "url": "https://www.youtube.com/watch?v=AMa-oZY1gok", "title": "Kingdom of Night - Trailer #2", "thumb": "https://i.ytimg.com/vi/AMa-oZY1gok/maxresdefault.jpg"}, {"id": 130706, "name": "Gameplay Trailer", "video_id": "7cPpfjmiG2E", "url": "https://www.youtube.com/watch?v=7cPpfjmiG2E", "title": "Kingdom of Night - Gameplay Trailer | PC", "thumb": "https://i.ytimg.com/vi/7cPpfjmiG2E/maxresdefault.jpg"}, {"id": 167968, "name": "Release Date Trailer", "video_id": "jKuC0YZZhuo", "url": "https://www.youtube.com/watch?v=jKuC0YZZhuo", "title": "Kingdom of Night - Release Date Trailer | PC", "thumb": "https://i.ytimg.com/vi/jKuC0YZZhuo/maxresdefault.jpg"}, {"id": 169759, "name": "Launch Trailer", "video_id": "6Chj1WR1xc8", "url": "https://www.youtube.com/watch?v=6Chj1WR1xc8", "title": "Kingdom of Night - Launch Trailer | PC", "thumb": "https://i.ytimg.com/vi/6Chj1WR1xc8/maxresdefault.jpg"}, {"id": 196590, "name": "Trailer", "video_id": "bFVWYd68J5Q", "url": "https://www.youtube.com/watch?v=bFVWYd68J5Q", "title": "Kingdom of Night - Console Release Date Trailer", "thumb": "https://i.ytimg.com/vi/bFVWYd68J5Q/fhddefault.jpg"}]}