{"id": 12785, "cover": {"id": 12649, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zelkxu9j8ly1fiyrirpm.jpg"}, "external_games": [{"id": 1974076, "name": "Super Methane Bros", "uid": "718396590", "url": "https://www.twitch.tv/directory/game/Super%20Methane%20Bros", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 149661, "name": "Super Methane Brothers", "uid": "8080", "url": "https://www.giantbomb.com/games/3030-8080/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}], "genres": [{"id": 8, "name": "Platform"}], "involved_companies": [{"id": 146011, "company": {"id": 9305, "name": "Apache Software Limited"}, "developer": true}], "name": "Super Methane Bros", "platforms": [114, 16], "player_perspectives": [{"id": 4, "name": "Side view"}], "release_dates": [{"id": 36654, "date": 788832000, "platform": 16, "y": 1994, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 36655, "date": 788832000, "platform": 114, "y": 1994, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 595085, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccr65.jpg"}, {"id": 595086, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccr66.jpg"}, {"id": 595087, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccr67.jpg"}], "slug": "super-methane-bros", "summary": "Super Methane Brothers is a 1993 platform arcade game released for Amiga by Apache Software Ltd.. The gameplay is similar to Taito's Bubble Bobble.\nPuff and Blow each have a Methane Gas Gun which fires a cloud of immobilising gas. If this comes into contact with a bad guy he will be absorbed into the gas and then float around the screen for a limited time. Bad guys are harmless in this state. Puff and Blow must suck the floating gas clouds into their guns and blast them out against a vertical surface. Bad guys then turn into bonuses which can be collected.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/super-methane-bros", "videos": [{"id": 96033, "name": "Gameplay Video", "video_id": "HQh5IqfHufA", "url": "https://www.youtube.com/watch?v=HQh5IqfHufA", "title": "Super Methane Bros. - Amiga Gameplay", "thumb": "https://i.ytimg.com/vi/HQh5IqfHufA/maxresdefault.jpg"}]}