 sourcebook, desktop and mobile wallpapers", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/cyberpunk-2077-collectors-edition", "videos": [{"id": 27911, "name": "Trailer", "video_id": "wwr6TlEbiuU", "url": "https://www.youtube.com/watch?v=wwr6TlEbiuU", "title": "Cyberpunk 2077 \u2014 Official Collector\u2019s Edition Unboxing Video", "thumb": "https://i.ytimg.com/vi/wwr6TlEbiuU/maxresdefault.jpg"}]}