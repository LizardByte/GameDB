{"id": 5681, "artworks": [{"id": 103201, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar27mp.jpg"}], "cover": {"id": 79640, "url": "//images.igdb.com/igdb/image/upload/t_thumb/co1pg8.jpg"}, "external_games": [{"id": 151289, "name": "Locomotion", "uid": "6285", "url": "https://www.giantbomb.com/games/3030-6285/", "external_game_source": {"id": 3, "name": "GiantBomb"}}, {"id": 1963962, "name": "Loco-Motion", "uid": "1019759311", "url": "https://www.twitch.tv/directory/game/Loco-Motion", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}, {"id": 4, "name": "Split screen"}], "genres": [{"id": 9, "name": "Puzzle"}, {"id": 15, "name": "Strategy"}], "involved_companies": [{"id": 34683, "company": {"id": 2521, "name": "Mattel Electronics"}, "developer": false}, {"id": 34682, "company": {"id": 129, "name": "Konami"}, "developer": true}, {"id": 152690, "company": {"id": 2528, "name": "Centuri"}, "developer": false}, {"id": 152689, "company": {"id": 112, "name": "Sega"}, "developer": false}, {"id": 241532, "company": {"id": 10282, "name": "Sony"}, "developer": false}, {"id": 241533, "company": {"id": 2878, "name": "Konami Industry"}, "developer": true}], "name": "Loco-Motion", "platforms": [52, 67, 27], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "rating": 60.15805573794991, "release_dates": [{"id": 551790, "date": 383788800, "platform": 52, "y": 1982, "release_region": {"id": 5, "region": "japan"}}, {"id": 551791, "date": 410140800, "platform": 67, "y": 1982, "release_region": {"id": 2, "region": "north_america"}}, {"id": 537965, "date": 441676800, "platform": 27, "y": 1983, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 423632, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc92vk.jpg"}, {"id": 423633, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc92vl.jpg"}, {"id": 423634, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc92vm.jpg"}], "slug": "loco-motion", "summary": "Loco-Motion is basically an updated version of a sliding block puzzle game where the player can move pieces horizontally or vertically within a frame to complete a picture. However, the presence of a constantly moving locomotive complicates matters. The player controls the playfield and the aim is to guide the locomotive around the tracks to collect the passengers waiting at the stations located around the edges of the screen.\n\nThe player uses a joystick to slide a piece of the track into the vacant square. The locomotive is always moving, but the player has the option of making it move faster to get to the passengers more quickly by using a button next to the joystick. The player must avoid crashing the locomotive into the dead-end barricades (shown as a yellow 'X'), and also ensure that it does not run into the edge of the gap or a barrier at the playfield edge, either of which costs a life.", "themes": [{"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/loco-motion", "videos": [{"id": 104679, "name": "Gameplay Video", "video_id": "XvRUZP-zeKo", "url": "https://www.youtube.com/watch?v=XvRUZP-zeKo", "title": "Arcade Game: Loco-Motion (1982 Konami (Centuri license))", "thumb": "https://i.ytimg.com/vi/XvRUZP-zeKo/sddefault.jpg"}]}