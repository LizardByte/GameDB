{"id": 1527555, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwqo3.jpg"}, {"id": 1527556, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwqo4.jpg"}, {"id": 1527557, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwqo5.jpg"}], "slug": "no-alibi", "summary": "No Alibi is an online top-down co-op shooter with roguelike elements. Sneak in unseen, take hostages or go in gunning \u2013 the choice is yours. Use your cash to buy a range of customizable weapons, from small pistols to massive miniguns and sentry turrets. Add attachments to your weapons at the weapons workbench \u2013 but keep in mind that the more you invest in your gear, the more you\u2019ll lose if you can\u2019t make it out.\n\nYour group starts out as a small criminal concern, robbing banks and jewelry stores, but you\u2019ll soon find yourself scoring big on some high-stakes targets. The man you answer to is hard to keep happy, and if you can\u2019t deliver, it\u2019s game over. The relentless action will keep you on your toes, so make sure you come well-equipped. You\u2019ll never be truly ready.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/no-alibi", "videos": [{"id": 149587, "name": "Trailer", "video_id": "0RVEix9J0xQ", "url": "https://www.youtube.com/watch?v=0RVEix9J0xQ", "title": "No Alibi - Announcement Trailer", "thumb": "https://i.ytimg.com/vi/0RVEix9J0xQ/maxresdefault.jpg"}]}