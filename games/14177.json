rue, "game": 14177, "lancoop": true, "offlinecoop": true, "offlinecoopmax": 4, "offlinemax": 0, "onlinecoop": true, "onlinecoopmax": 4, "onlinemax": 0, "platform": 6, "splitscreen": true, "checksum": "58fc076a-e4c6-5b9a-a237-73986bc4caf8"}, {"id": 9737, "campaigncoop": true, "dropin": true, "game": 14177, "lancoop": true, "offlinecoop": true, "offlinecoopmax": 4, "offlinemax": 0, "onlinecoop": true, "onlinecoopmax": 4, "onlinemax": 0, "platform": 3, "splitscreen": true, "checksum": "ca12e7d8-ca51-feb1-b01f-fb441307c1f6"}], "name": "Divinity: Original Sin - Enhanced Edition", "platforms": [48, 3, 6, 14, 49], "player_perspectives": [{"id": 2, "name": "Third person"}, {"id": 3, "name": "Bird view / Isometric"}], "rating": 84.59082427144801, "release_dates": [{"id": 201349, "date": 1445904000, "platform": 6, "y": 2015, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 201353, "date": 1450828800, "platform": 14, "y": 2015, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 201350, "date": 1445904000, "platform": 48, "y": 2015, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 201352, "date": 1450828800, "platform": 3, "y": 2015, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 456825, "date": 1459382400, "platform": 14, "y": 2016, "release_region": {"id": 1, "region": "europe"}}, {"id": 201351, "date": 1445904000, "platform": 49, "y": 2015, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 84046, "url": "//images.igdb.com/igdb/image/upload/t_thumb/k8ruu5ne2e59qhv974xf.jpg"}, {"id": 84048, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dodltagf7cdlw7jzif7d.jpg"}, {"id": 84049, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ww1au2ekdvs20qu2u52z.jpg"}, {"id": 84045, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yuluj9isyzua0mj0jws3.jpg"}, {"id": 84047, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lvqamqrc9qeetqwmioav.jpg"}], "slug": "divinity-original-sin-enhanced-edition", "storyline": "The heroes are a pair of Source Hunters, members of an order sworn to root out a dangerous and forbidden form of magic known as Source, along with the Sorcerers who wield it. Their latest assignment sends them to Cyseal, a port town in the southern reaches of the land of Rivellon, to investigate the murder of a town councilor believed to have been slain by a Sourcerer. Upon arriving, the two find Cyseal besieged by marauding orcs and restless undead, and it quickly becomes clear that the councilor's death is only the surface of something far more sinister. As they dig deeper into the killing, the Source Hunters begin to unravel a sprawling conspiracy whose roots reach far beyond the troubled town and threaten all of Rivellon.", "summary": "Divinity Original Sin: Enhanced Edition Edition is a much lauded Role-Playing-Game that blends deep customization and humor with dynamic turn based combat. Either in online co-op, split-screen co-op on your TV, or even alone, take advantage of a classless RPG system to create your heroes and conquer the evils of Rivellon!\n\nEmbark upon a journey with up to three companions as you bend the very fabric of time, where what seems like the case of a simple murder unravels into hours of quests facing fiendish foes, magical polymorphs, and dastardly bosses. As a Source Hunter, master the elements and use the environment to your advantage in dynamic combats mixing weather and magic to explode, poison, electrify, freeze and burn your enemies!", "themes": [{"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/divinity-original-sin-enhanced-edition", "videos": [{"id": 5980, "name": "Consoles Launch Trailer", "video_id": "Ej5-71re0mU", "url": "https://www.youtube.com/watch?v=Ej5-71re0mU", "title": "Divinity: Original Sin - Enhanced Edition - Consoles Launch Trailer (Official)", "thumb": "https://i.ytimg.com/vi/Ej5-71re0mU/maxresdefault.jpg"}, {"id": 170684, "name": "Trailer", "video_id": "nb4imtel3ls", "url": "https://www.youtube.com/watch?v=nb4imtel3ls", "title": "Divinity Original Sin Enhanced Edition - Overview Trailer | PS4", "thumb": "https://i.ytimg.com/vi/nb4imtel3ls/maxresdefault.jpg"}, {"id": 170685, "name": "Launch Trailer", "video_id": "rxnApC7Uxik", "url": "https://www.youtube.com/watch?v=rxnApC7Uxik", "title": "Divinity: Original Sin - Enhanced Edition Release Trailer", "thumb": "https://i.ytimg.com/vi/rxnApC7Uxik/maxresdefault.jpg"}], "collections": [{"id": 1024, "name": "Divinity"}]}