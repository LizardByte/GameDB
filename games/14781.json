}, {"id": 777663, "date": 628473600, "platform": 60, "y": 1989, "release_region": {"id": 2, "region": "north_america"}}, {"id": 777664, "date": 628473600, "platform": 60, "y": 1989, "release_region": {"id": 1, "region": "europe"}}, {"id": 777665, "date": 520560000, "platform": 63, "y": 1986, "release_region": {"id": 2, "region": "north_america"}}, {"id": 777666, "date": 510019200, "platform": 13, "y": 1986, "release_region": {"id": 2, "region": "north_america"}}, {"id": 777667, "date": 596937600, "platform": 14, "y": 1988, "release_region": {"id": 2, "region": "north_america"}}, {"id": 777668, "platform": 65, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1595899, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scy7ej.jpg"}, {"id": 1595900, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scy7ek.jpg"}, {"id": 1595901, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scy7el.jpg"}], "slug": "mean-18-ultimate-golf", "storyline": "This is it! A hush falls over the California countryside as you stand on the eighteenth hole of Pebble Beach. You\u2019re five long feet from the hole and you have a one-stroke lead in the biggest tournament of your life. Your caddy hands you your lucky putter. You line up your shot, and swing. The ball rolls slowly toward the hole. There\u2019s a tense moment as it almost rings the cup. finally, the ball falls in. You retain your title!", "summary": "Mean 18 is a golf video game designed by Rex Bradford with graphics by George Karalias, both of Microsmiths, and released by Accolade for MS-DOS compatible operating systems in 1986. It was ported to the Amiga, Apple IIGS, Atari ST, and Macintosh. It includes an editor allowing players to create their own courses. In 1989, Atari Corporation published a port for the Atari 7800 console. A version for Atari 8-bit computers was in development in 1989 but was cancelled.", "url": "https://www.igdb.com/games/mean-18-ultimate-golf", "videos": [{"id": 157373, "name"