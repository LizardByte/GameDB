, {"id": 1958928, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15zio.jpg"}, {"id": 1958933, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15zit.jpg"}, {"id": 1958926, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15zim.jpg"}, {"id": 1958929, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15zip.jpg"}, {"id": 1958931, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc15zir.jpg"}], "slug": "magic-isle-simulator", "summary": "Magic Isle Simulator is a first-person magic shop management and crafting game set in a secret town where only wizards live. Players inherit a magic shop from their grandfather and run it alone or in online co-op for up to four players. They grow magical herbs, brew potions in a cauldron mini-game, craft wands in a line-tracing mini-game, and sell goods such as flying wands, spellbooks, broomsticks and prophecy orbs. Earnings and higher-level licences expand the shop, while thieves and cursed items add risk. Seasons and festivals change customer demand, and players choose between two secret societies, the Round Table, which keeps magic hidden and offers rent discounts, and the Watchers, which share magic openly and offer rare rewards; angering the wrong side can bring raids or taxes.", "themes": [{"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/magic-isle-simulator"}