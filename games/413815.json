{"id": 413815, "artworks": [{"id": 304247, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6irb.jpg"}, {"id": 301246, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar6gfy.jpg"}], "cover": {"id": 592640, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cocpa8.jpg"}, "external_games": [{"id": 3206486, "name": "Beggar Simulator: Istanbul", "uid": "5114920", "url": "https://store.steampowered.com/app/5114920", "external_game_source": {"id": 1, "name": "Steam"}}, {"id": 3206479, "name": "Beggar Simulator: Istanbul", "uid": "729446683", "url": "https://www.twitch.tv/directory/game/Beggar%20Simulator:%20Istanbul", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 13, "name": "Simulator"}, {"id": 31, "name": "Adventure"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 408331, "company": {"id": 80241, "name": "BHS Gaming"}, "developer": true}], "name": "Beggar Simulator: Istanbul", "platforms": [6], "player_perspectives": [{"id": 1, "name": "First person"}], "release_dates": [{"id": 959354, "date": 1788307200, "platform": 6, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1900034, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2q.jpg"}, {"id": 1900035, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2r.jpg"}, {"id": 1900036, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2s.jpg"}, {"id": 1900037, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2t.jpg"}, {"id": 1900038, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2u.jpg"}, {"id": 1900039, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2v.jpg"}, {"id": 1900040, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2w.jpg"}, {"id": 1900041, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2x.jpg"}, {"id": 1900042, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2y.jpg"}, {"id": 1900043, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q2z.jpg"}, {"id": 1900044, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14q30.jpg"}], "slug": "beggar-simulator-istanbul", "summary": "Beggar Simulator: Istanbul is a first-person job simulation set on the streets of a contemporary Istanbul. The player controls a man who is not destitute but performs destitution for money, renting a costume and an act each morning and choosing where to work. A traffic junction, a covered bazaar, a mosque courtyard, a nightlife avenue and a metro concourse each draw a different crowd and reward a different approach.\n\nBegging is handled through a dialogue menu whose lines are weighed against the passer-by being read, while the act that was rented restricts which lines can be used without breaking character. Municipal enforcement officers, pickpockets and rival beggars press on the working day, and the money earned goes on food, on a place to sleep and on the next day's rent for the act. Hunger, illness and sleep carry over between days.", "themes": [{"id": 27, "name": "Comedy"}, {"id": 28, "name": "Business"}], "url": "https://www.igdb.com/games/beggar-simulator-istanbul", "videos": [{"id": 193123, "name": "Trailer", "video_id": "ldAr_7Xvwtc", "url": "https://www.youtube.com/watch?v=ldAr_7Xvwtc", "title": "Beggar Simulator: Istanbul \u2014 Official Trailer", "thumb": "https://i.ytimg.com/vi/ldAr_7Xvwtc/fhddefault.jpg"}]}