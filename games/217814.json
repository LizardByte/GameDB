ease_region": {"id": 8, "region": "worldwide"}}, {"id": 391324, "date": 1664323200, "platform": 49, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 391325, "date": 1664323200, "platform": 169, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 391326, "date": 1664323200, "platform": 130, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 883634, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixte.jpg"}, {"id": 883635, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixtf.jpg"}, {"id": 883636, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixtg.jpg"}, {"id": 883638, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixti.jpg"}, {"id": 883639, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixtj.jpg"}, {"id": 883637, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scixth.jpg"}], "slug": "tip-top-dont-fall", "summary": "Tip Top is an arcade style climbing game with procedurally generated routes that never repeat themselves! It features a gripping single player campaign that has you exploring all corners of the globe while making sure not to fall to your (perma)death.\n\nThe player uses the innovative control scheme to move the characters hands from one hold to the next while making sure to be as efficient as possible. You only have a limited amount of stamina to use in order to reach the peak. If you run out of stamina or miss a hold you'll fall!\n\nBut! The twist on the roguelike genre is that you never have to die. Careful players will try routes several times while clipping their rope to the wall before taking any risks. Skilled players will be those that find the right balance between risk and rationality and reach the peak in peace. Players that climb too carefully may never reach the top, as they\u2019ll waste too much energy clipping in to the bolts.", "themes": [{"id": 35, "name": "Kids"}], "url": "https://www.igdb.com/games/tip-top-dont-fall", "video