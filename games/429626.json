images.igdb.com/igdb/image/upload/t_thumb/sc16mzm.jpg"}, {"id": 1989350, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16mzq.jpg"}, {"id": 1989348, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16mzo.jpg"}, {"id": 1989352, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16mzs.jpg"}, {"id": 1989351, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16mzr.jpg"}], "slug": "ashwend", "summary": "Ashwend is a first-person multiplayer survival game set on a remote planet. Players start with nothing, gather stone, wood and ore, craft tools and weapons, and build bases they can lock and claim. Fights are fought with melee weapons, bows, crossbows and guns assembled from salvaged parts, and bases are raided with explosives.\n\nThe world is a whole small planet with no map edge: continents, seas to swim, burnt-out villages and the roads between them, under a day that lasts thirty minutes. Meteor showers leave craters holding the best metal, and four guarded launch sites hold supplies. Every world lasts thirty days. Something grows in the sky night after night, and when it arrives the server wipes and a new world begins. Ashwend is free to play.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 21, "name": "Survival"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/ashwend", "videos": [{"id": 203246, "name": "Trailer", "video_id": "XqF71wzi7Eo", "url": "https://www.youtube.com/watch?v=XqF71wzi7Eo", "title": "Ashwend - Official Steam Trailer | Free-to-Play Open-World Survival", "thumb": "https://i.ytimg.com/vi/XqF71wzi7Eo/fhddefault.jpg"}]}