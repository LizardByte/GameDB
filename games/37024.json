 Cloud"}}, {"id": 251797, "name": "Super Lucky's Tale", "uid": "497413", "url": "https://www.twitch.tv/directory/game/Super Lucky's Tale", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 1482281, "name": "Super Lucky's Tale", "uid": "847360", "url": "https://store.steampowered.com/app/847360", "external_game_source": {"id": 1, "name": "Steam"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 8, "name": "Platform"}, {"id": 31, "name": "Adventure"}], "involved_companies": [{"id": 57044, "company": {"id": 1010, "name": "Microsoft Studios"}, "developer": false}, {"id": 409377, "company": {"id": 5142, "name": "Playful"}, "developer": true}], "name": "Super Lucky's Tale", "platforms": [6, 49], "player_perspectives": [{"id": 2, "name": "Third person"}], "rating": 70.19237525817323, "release_dates": [{"id": 119683, "date": 1510012800, "platform": 6, "y": 2017, "release_region": {"id": 2, "region": "north_america"}}, {"id": 115806, "date": 1510012800, "platform": 49, "y": 2017, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 44446, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xr0fprfk2b17stekb4ex.jpg"}, {"id": 44442, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yydbbewkhzbnl8hdprs5.jpg"}, {"id": 44444, "url": "//images.igdb.com/igdb/image/upload/t_thumb/denbsyfx9f7jiwoicuio.jpg"}, {"id": 44445, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lkdcb92w9fwfsmeesozj.jpg"}, {"id": 44443, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xa23guzsloyq1mjxcg1b.jpg"}], "slug": "super-luckys-tale", "storyline": "A colorful family-friendly platformer, Super Lucky's Tale follows Lucky Swiftail, a curious and brave young fox setting out on a journey to discover his own inner strength. At the heart of his adventure lies the Book of Ages, a magical tome that holds entire worlds and the many whimsical characters who dwell within them. Lucky's sister Lyra is charged with protecting the book, but it has fallen under threat from Jinx, a mysterious and villainous cat scheming to seize its power for his own dark purposes. To stop him, Lucky ventures inside the Book of Ages itself, traveling through its vibrant realms in search of the clovers he needs to wrest control away from Jinx. Along the way he crosses paths with Jinx's mischievous children, the Kitty Litter, and befriends a cast of quirky inhabitants, from misplaced Yetis to a village of farming worms, all of whom depend on Lucky to save their storybook worlds from ruin.", "summary": "Super Lucky\u2019s Tale is a delightful, playground platformer for all ages that follows Lucky, the ever-optimistic and lovable hero, on his quest to find his inner strength and help his beloved sister rescue the Book of Ages from the nefarious Jinx. Head back to the era of classic platformers with challenges players of all skill levels and all ages can enjoy.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/super-luckys-tale", "videos": [{"id": 16623, "name": "Launch Trailer", "video_id": "NhZ3xiCNK28", "url": "https://www.youtube.com/watch?v=NhZ3xiCNK28", "title": "Super Lucky's Tale Launch Trailer", "thumb": "https://i.ytimg.com/vi/NhZ3xiCNK28/maxresdefault.jpg"}, {"id": 16568, "name": "Jinx & the Kitty Litter", "video_id": "iaBqMK3ffSk", "url": "https://www.youtube.com/watch?v=iaBqMK3ffSk", "title": "Super Lucky's Tale - Jinx & the Kitty Litter", "thumb": "https://i.ytimg.com/vi/iaBqMK3ffSk/maxresdefault.jpg"}, {"id": 14297, "name": "Trailer", "video_id": "3zi_nI0SIic", "url": "https://www.youtube.com/watch?v=3zi_nI0SIic", "title": "Super Lucky's Tale \u2013 E3 2017 \u2013 4K Announce Video", "thumb": "https://i.ytimg.com/vi/3zi_nI0SIic/maxresdefault.jpg"}], "collections": [{"id": 2947, "name": "Lucky's Tale"}]}