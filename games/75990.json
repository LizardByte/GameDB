on": "japan"}}, {"id": 161871, "date": 1552608000, "platform": 130, "y": 2019, "release_region": {"id": 1, "region": "europe"}}, {"id": 161874, "date": 1553212800, "platform": 130, "y": 2019, "release_region": {"id": 3, "region": "australia"}}], "screenshots": [{"id": 212307, "url": "//images.igdb.com/igdb/image/upload/t_thumb/uagdf0fgm3eelgxrsluk.jpg"}, {"id": 212304, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zxknxrwbt2tlzhy9kakb.jpg"}, {"id": 212305, "url": "//images.igdb.com/igdb/image/upload/t_thumb/gaixbfc6zgmxw1kwuyyb.jpg"}, {"id": 212309, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zze9rp7jrjj61usjbajz.jpg"}, {"id": 212306, "url": "//images.igdb.com/igdb/image/upload/t_thumb/x02tu7kmpjklrycgjumg.jpg"}, {"id": 212308, "url": "//images.igdb.com/igdb/image/upload/t_thumb/npwcpuuzpaulmrigfqrs.jpg"}, {"id": 212303, "url": "//images.igdb.com/igdb/image/upload/t_thumb/jewnzbr4vxd6fsmoh3ll.jpg"}], "slug": "the-caligula-effect-overdose", "storyline": "The Caligula Effect: Overdose is an enhanced retelling of a role-playing game set inside a virtual reality world called Mobius. Created to shelter troubled people from the pain of their real lives, Mobius traps its inhabitants in an idyllic high school existence, where they are made to relive the same three years of adolescence over and over without end. The protagonist is one of the few to awaken to the truth: that this comforting paradise is an artificial prison overseen by a god-like vocal program known as Mu. Refusing to remain, they join forces with Aria, the former keeper of Mobius, to found the Go-Home Club, a band of students determined to break free of the simulation and return to reality. Standing against them are the Ostinato Musicians, devoted followers who serve Mu and brand the Go-Home Club as dangerous traitors. What follows is a struggle to escape a beautiful lie and reclaim the harsh truth of the real world.", "summary": "Mobius. An idyllic world that exists for the sake of letting people forget about the pain and problems of reality. In this world created by a sentient vocaloid program, \u03bc, reality and fantasy has become blurred, allowing people to relive their high school years in bliss. Yet in this seemingly beautiful and perfect world, something is amiss. Escape from this false paradise with your fellow students and return to reality in The Caligula Effect: Overdose!", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/the-caligula-effect-overdose", "videos": [{"id": 16770, "name": "Trailer", "video_id": "KDmcrWzMEW4", "url": "https://www.youtube.com/watch?v=KDmcrWzMEW4", "title": "\u3010Caligula Overdose/\u30ab\u30ea\u30ae\u30e5\u30e9 \u30aa\u30fc\u30d0\u30fc\u30c9\u30fc\u30ba\u3011\u30c6\u30a3\u30b6\u30fc\u30c8\u30ec\u30fc\u30e9\u30fc", "thumb": "https://i.ytimg.com/vi/KDmcrWzMEW4/maxresdefault.jpg"}, {"id": 20995, "name": "Trailer", "video_id": "uzd-atz5iXU", "url": "https://www.youtube.com/watch?v=uzd-atz5iXU", "title": "The Caligula Effect: Overdose - Announcement Trailer (Switch, PS4, Steam)", "thumb": "https://i.ytimg.com/vi/uzd-atz5iXU/maxresdefault.jpg"}, {"id": 21986, "name": "Trailer", "video_id": "CbsXMKNffL8", "url": "https://www.youtube.com/watch?v=CbsXMKNffL8", "title": "The Caligula Effect: Overdose - Story Trailer (Switch, PS4, Steam)", "thumb": "https://i.ytimg.com/vi/CbsXMKNffL8/maxresdefault.jpg"}], "collections": [{"id": 11542, "name": "The Caligula Effect"}]}