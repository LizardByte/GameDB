d": 31, "name": "Adventure"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 121870, "company": {"id": 15094, "name": "ZA/UM"}, "developer": true}], "name": "Disco Elysium: The Final Cut", "platforms": [170, 169, 48, 6, 167, 14, 49, 130], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "rating": 94.19286337328833, "release_dates": [{"id": 234328, "date": 1617062400, "platform": 167, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918597, "date": 1617062400, "platform": 170, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918598, "date": 1617062400, "platform": 14, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918599, "date": 1633910400, "platform": 130, "y": 2021, "release_region": {"id": 1, "region": "europe"}}, {"id": 918600, "date": 1633996800, "platform": 130, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918601, "date": 1661385600, "platform": 130, "y": 2022, "release_region": {"id": 5, "region": "japan"}}, {"id": 918602, "date": 1617062400, "platform": 6, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918603, "date": 1617062400, "platform": 48, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918604, "date": 1633996800, "platform": 49, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 918605, "date": 1633996800, "platform": 169, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 413554, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8v3m.jpg"}, {"id": 413555, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8v3n.jpg"}, {"id": 413556, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8v3o.jpg"}, {"id": 413557, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc8v3p.jpg"}], "slug": "disco-elysium-the-final-cut", "storyline": "Disco Elysium is a stylish open-world role-playing game in which players decide what sort of detective they want to be.\n\nAfter waking up in a trashed hostel room with a hangover and no memory of his past, follow a detective trying to piece his life back together while investigating a murder in the town of Revachol.\n\nAfter initially appearing to be an open and closed case, it soon transpires that this murder has triggered a chain of events that has wider implications for the city and its inhabitants.\n\n\u200bDeath, sex, taxes, and disco \u2013 nothing is off the table. Revachol is a real place with real challenges. Players can solve the massive murder investigation or relax and kick back with sprawling side cases.\n\nThe detective decides, and the citizens abide.", "summary": "Disco Elysium: The Final Cut is an enhanced edition of the original role-playing game developed and published by ZA/UM. It retains the core gameplay and narrative while adding full voice acting, new quests, additional endings, and other narrative revisions.", "themes": [{"id": 20, "name": "Thriller"}, {"id": 31, "name": "Drama"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/disco-elysium-the-final-cut", "videos": [{"id": 55065, "name": "Trailer", "video_id": "ixtTkkEnq0Q", "url": "https://www.youtube.com/watch?v=ixtTkkEnq0Q", "title": "Disco Elysium: The Final Cut - Switch Trailer | Nintendo Direct", "thumb": "https://i.ytimg.com/vi/ixtTkkEnq0Q/maxresdefault.jpg"}, {"id": 144168, "name": "TGA 2020 Trailer", "video_id": "GF8JesUNQVU", "url": "https://www.youtube.com/watch?v=GF8JesUNQVU", "title": "Disco Elysium The Final Cut Premiere at The Game Awards 2020", "thumb": "https://i.ytimg.com/vi/GF8JesUNQVU/maxresdefault.jpg"}]}