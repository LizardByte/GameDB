al_game_source": {"id": 36, "name": "Playstation Store US"}}], "franchises": [{"id": 571, "name": "Assassin's Creed"}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 31, "name": "Adventure"}], "involved_companies": [{"id": 231046, "company": {"id": 17064, "name": "Ubisoft Bordeaux"}, "developer": true}, {"id": 231045, "company": {"id": 104, "name": "Ubisoft Entertainment"}, "developer": false}], "name": "Assassin's Creed Mirage", "platforms": [169, 48, 6, 39, 167, 49], "player_perspectives": [{"id": 2, "name": "Third person"}], "rating": 73.03439316474721, "release_dates": [{"id": 515300, "date": 1696464000, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 515301, "date": 1696464000, "platform": 48, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 527083, "date": 1696464000, "platform": 49, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 527084, "date": 1696464000, "platform": 169, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 515302, "date": 1696464000, "platform": 167, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 590002, "date": 1717632000, "platform": 39, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 866302, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scikfy.jpg"}, {"id": 873027, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipmr.jpg"}, {"id": 1379420, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkd8.jpg"}, {"id": 873025, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipmp.jpg"}, {"id": 873029, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipmt.jpg"}, {"id": 873026, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipmq.jpg"}, {"id": 873028, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipms.jpg"}, {"id": 1379419, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkd7.jpg"}, {"id": 1379421, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkd9.jpg"}, {"id": 873024, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scipmo.jpg"}], "slug": "assassins-creed-mirage", "storyline": "In 861 CE Baghdad, a young street thief named Basim Ibn Ishaq scrapes by in the town of Anbar alongside his closest companion, Nehal. Haunted since childhood by disturbing visions of a monstrous jinni, Basim yearns for purpose beyond petty crime and sets his sights on joining the Hidden Ones, a secretive organization operating in the shadows. When he infiltrates the Caliph's palace to prove his worth and inadvertently triggers a devastating crackdown on the thieves of Anbar, Basim is forced to flee everything he has known.\n\nTaken under the wing of the stern Hidden One mentor Roshan, Basim trains at the mountain fortress of Alamut and eventually earns his place among their ranks. Dispatched to Baghdad to dismantle the influence of the Order of the Ancients, a powerful faction that has infiltrated the highest levels of the Caliphate, Basim hunts their members through the city's bustling districts. But as he closes in on the Order's leadership, unsettling connections between the ancient artifacts they seek and his own fractured memories begin to surface, pulling Basim toward a truth about his identity that threatens to reshape everything he believes.", "summary": "Assassin\u2019s Creed Mirage is a stealth-focused action-adventure game set in ninth-century Baghdad. It emphasizes parkour, infiltration, and targeted assassinations. The game follows a more compact structure than recent entries in the series. Players control Basim, a young thief drawn into a secretive order. The title blends historical settings with narrative elements tied to the franchise\u2019s established lore.\n\nThe story unfolds in a thriving Baghdad at the height of its cultural and scientific influence, where Basim, a young orphan shaped by loss, struggles to survive through street theft. Haunted by disturbing visions and driven by a need for answers, he lashes out violently, forcing him to flee the city. Taken in by the Hidden Ones, he undergoes rigorous training and adopts their code, developing his skills and sense of purpose. As he uncovers the truth about himself and the world he has joined, Basim is pushed toward a destiny that transforms both his identity and his allegiance to the emerging Creed.", "themes": [{"id": 1, "name": "Action"}, {"id": 22, "name": "Historical"}, {"id": 23, "name": "Stealth"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/assassins-creed-mirage", "videos": [{"id": 98778, "name": "Launch Trailer", "video_id": "IRNOoOYVn80", "url": "https://www.youtube.com/watch?v=IRNOoOYVn80", "title": "Assassin's Creed Mirage: Launch Trailer", "thumb": "https://i.ytimg.com/vi/IRNOoOYVn80/maxresdefault.jpg"}, {"id": 74486, "name": "Cinematic Trailer", "video_id": "x55lAlFtXmw", "url": "https://www.youtube.com/watch?v=x55lAlFtXmw", "title": "Assassin's Creed Mirage: Cinematic World Premiere | #UbiForward", "thumb": "https://i.ytimg.com/vi/x55lAlFtXmw/maxresdefault.jpg"}, {"id": 74487, "name": "Dev Diary", "video_id": "dKox5i_T6XA", "url": "https://www.youtube.com/watch?v=dKox5i_T6XA", "title": "Assassin\u2019s Creed Mirage: Developer Trailer Breakdown | #UbiForward", "thumb": "https://i.ytimg.com/vi/dKox5i_T6XA/maxresdefault.jpg"}, {"id": 90296, "name": "Trailer", "video_id": "G97lx7orMN8", "url": "https://www.youtube.com/watch?v=G97lx7orMN8", "title": "Assassin's Creed Mirage: Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/G97lx7orMN8/maxresdefault.jpg"}, {"id": 91834, "name": "Trailer", "video_id": "9hjico7nYvo", "url": "https://www.youtube.com/watch?v=9hjico7nYvo", "title": "Assassin's Creed Mirage: Story Trailer | Ubisoft Forward", "thumb": "https://i.ytimg.com/vi/9hjico7nYvo/maxresdefault.jpg"}, {"id": 91835, "name": "Gameplay Trailer", "video_id": "mxpYHW-M_Ac", "url": "https://www.youtube.com/watch?v=mxpYHW-M_Ac", "title": "Assassin's Cre