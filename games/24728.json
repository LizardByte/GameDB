18The Monk\u2019s Decipher\u2019 DLC", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/lords-of-the-fallen-game-of-the-year-edition", "videos": [{"id": 119448, "name": "Trailer", "video_id": "Mv6Y2b4_z0k", "url": "https://www.youtube.com/watch?v=Mv6Y2b4_z0k", "title": "Lords of the Fallen - Sins Trailer", "thumb": "https://i.ytimg.com/vi/Mv6Y2b4_z0k/maxresdefault.jpg"}, {"id": 119449, "name": "Trailer", "video_id": "ExGOmR_NEqM", "url": "https://www.youtube.com/watch?v=ExGOmR_NEqM", "title": "Lords of the Fallen - Debut Trailer", "thumb": "https://i.ytimg.com/vi/ExGOmR_NEqM/hqdefault.jpg"}]}