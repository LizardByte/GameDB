u are.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 22, "name": "Historical"}, {"id": 33, "name": "Sandbox"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/the-legend-of-zelda-a-link-between-worlds", "videos": [{"id": 1488, "name": "Trailer", "video_id": "qAluniNRibs", "url": "https://www.youtube.com/watch?v=qAluniNRibs", "title": "Nintendo 3DS - The Legend of Zelda: A Link Between Worlds E3 Trailer", "thumb": "https://i.ytimg.com/vi/qAluniNRibs/maxresdefault.jpg"}], "collections": [{"id": 106, "name": "The Legend of Zelda"}, {"id": 9849, "name": "The Legend of Zelda: A Link to the Past"}], "characters": [{"id": 1897, "name": "Voice"}]}