": [{"id": 13, "name": "Simulator"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 283637, "company": {"id": 24018, "name": "President Studio"}, "developer": true}, {"id": 283638, "company": {"id": 9005, "name": "PlayWay S.A."}, "developer": false}], "name": "Crime Scene Cleaner", "platforms": [169, 6, 167], "player_perspectives": [{"id": 1, "name": "First person"}], "rating": 69.97956387566522, "release_dates": [{"id": 728596, "date": 1744848000, "platform": 169, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 629573, "date": 1723593600, "platform": 6, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 747731, "date": 1749772800, "platform": 167, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1049920, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4g.jpg"}, {"id": 1049921, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4h.jpg"}, {"id": 1049922, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4i.jpg"}, {"id": 1049923, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4j.jpg"}, {"id": 1049918, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4e.jpg"}, {"id": 1049919, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4f.jpg"}, {"id": 1049924, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4k.jpg"}, {"id": 1049925, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4l.jpg"}, {"id": 1049926, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4m.jpg"}, {"id": 1049927, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmi4n.jpg"}], "slug": "crime-scene-cleaner", "storyline": "When insurance companies dodge the responsibility, it\u2019s up to you to save your daughter\u2019s life. This will require some dirty work and shady clientele, but you have no other choice, right? When the big boss calls once again, bring a bucket and a mop cause you will really need them. Are you up for the challenge?\n\nYou need nerves of steel to clean crime scenes left behind by major and minor criminals. You may not have money for your daughter\u2019s hospital stays, but what you do have is a very particular set of skills. With the help of an entire arsenal of equipment, you will clean blood, pack up bodies, and remove any odor. All this under the pressure of a ticking clock and police breathing down your neck.", "summary": "Once you get tangled with the mob, you will forever be a part of the mob. At least they pay a decent salary and all you have to do is clean up after their dirty work, but you know what you\u2019re doing. So clean crime scenes, outsmart the police and get ready for the next mission.", "themes": [{"id": 1, "name": "Action"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/crime-scene-cleaner", "videos": [{"id": 128568, "name": "Launch Trailer", "video_id": "TG2jf0UxER0", "url": "https://www.youtube.com/watch?v=TG2jf0UxER0", "title": "Crime Scene Cleaner - Release Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/TG2jf0UxER0/maxresdefault.jpg"}, {"id": 128569, "name": "Gameplay Trailer", "video_id": "TdFeQultVDA", "url": "https://www.youtube.com/watch?v=TdFeQultVDA", "title": "Crime Scene Cleaner - Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/TdFeQultVDA/maxresdefault.jpg"}]}