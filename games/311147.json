egion": "worldwide"}}], "screenshots": [{"id": 1868391, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nr.jpg"}, {"id": 1868392, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141ns.jpg"}, {"id": 1868393, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nt.jpg"}, {"id": 1868394, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nu.jpg"}, {"id": 1868395, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nv.jpg"}, {"id": 1868396, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nw.jpg"}, {"id": 1868397, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141nx.jpg"}, {"id": 1868398, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc141ny.jpg"}], "slug": "unloop--2", "storyline": "You step into the shoes of a highly skilled special agent tasked with a top-secret mission. \u200b\n\nInfiltrating a space station, you face a temporal anomaly \u2013 a time loop that creates copies of you and replicates your previous actions.\u200b\n\nBut you're nobody's fool, and nothing can throw you off your game. You thrive in chaos, and your expertise turns this anomaly into an advantage.\u200b\n\nThe more of you there are, the better!", "summary": "The ultimate VR puzzle where playing with yourself is strictly required Infiltrate a retro-futuristic space station, get trapped in a time loop, and team up with your past-copies to solve puzzles. Forget tutorials. Prove you're a genius, figure it out, or literally screw yourself over.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/unloop--2", "videos": [{"id": 164728, "name": "Trailer", "video_id": "tdf1-YRFDb4", "url": "https://www.youtube.com/watch?v=tdf1-YRFDb4", "title": "UnLoop \u2013 Launch Trailer | You Have All the Time in the World... to Die | Meta Quest | Pico", "thumb": "https://i.ytimg.com/vi/tdf1-YRFDb4/maxresdefault.jpg"}, {"id": 170414, "name": "Trailer", "video_id": "4hfbA9F