ate": 1195516800, "platform": 12, "y": 2007, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 13757, "date": 1211932800, "platform": 6, "y": 2008, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 801511, "date": 1354579200, "platform": 9, "y": 2012, "release_region": {"id": 2, "region": "north_america"}}, {"id": 801512, "date": 1354838400, "platform": 9, "y": 2012, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 8402, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mcoa62ivpynxt9jnx3ys.jpg"}, {"id": 8399, "url": "//images.igdb.com/igdb/image/upload/t_thumb/onndes2gzmquz0e8rpli.jpg"}, {"id": 8400, "url": "//images.igdb.com/igdb/image/upload/t_thumb/feadbwfkxgfbuy7ohnu5.jpg"}, {"id": 8398, "url": "//images.igdb.com/igdb/image/upload/t_thumb/r3uwmc94irofukfk6odw.jpg"}, {"id": 8401, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hatacbd1inqmu5cavj7z.jpg"}], "slug": "mass-effect", "storyline": "In the year 2183, Commander Shepard is sent to the human colony of Eden Prime to recover a Prothean beacon. The mission is disrupted by an attack from the synthetic Geth, led by Saren Arterius, a rogue Spectre agent. After making contact with the beacon and receiving a cryptic vision of destruction, Shepard is appointed the first human Spectre and tasked with hunting Saren across the galaxy.\n\nThe investigation leads Shepard and a growing crew aboard the SSV Normandy through multiple worlds, uncovering a conspiracy tied to the Reapers, a highly advanced machine race believed to eradicate all organic civilizations on a 50,000-year cycle. Shepard must stop Saren before he can trigger their return.", "summary": "Mass Effect is an action role-playing game set in the year 2183. The player takes the role of Commander Shepard, a customizable character who serves as Executive Officer aboard the SSV Normandy. After a routine mission goes wrong, Shepard assembles a squad and pursues a threat that escalates into a galaxy-wide conflict. The game features real-time squad-based combat where players choose companions and tactics suited to different enemy types, from biotic-wielding opponents to heavily armored machines.\n\nThe game spans a large science fiction universe, with explorable locations ranging from the Citadel space station to alien homeworlds and remote outposts. Player decisions affect mission outcomes, crew relationships, and the overarching narrative across the trilogy.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 44, "name": "Romance"}], "url": "https://www.igdb.com/games/mass-effect", "videos": [{"id": 371, "name": "Trailer", "video_id": "-_6ZMr2bMco", "url": "https://www.youtube.com/watch?v=-_6ZMr2bMco", "title": "Mass Effect 1 Trailer", "thumb": "https://i.ytimg.com/vi/-_6ZMr2bMco/maxresdefault.jpg"}, {"id": 119303, "name": "Trailer", "video_id": "0OLDN2tJp2o", "url": "https://www.youtube.com/watch?v=0OLDN2tJp2o", "title": "Mass Effect E3 07 Trailer in HD", "thumb": "https://i.ytimg.com/vi/0OLDN2tJp2o/hqdefault.jpg"}, {"id": 143827, "name": "Announcement Trailer", "video_id": "ktoXyaYSmhQ", "url": "https://www.youtube.com/watch?v=ktoXyaYSmhQ", "title": "ME 2005 X05", "thumb": "https://i.ytimg.com/vi/ktoXyaYSmhQ/maxresdefault.jpg"}, {"id": 143828, "name": "Gameplay Trailer", "video_id": "6qOdSX7Vt2g", "url": "https://www.youtube.com/watch?v=6qOdSX7Vt2g", "title": "MASSeffect e3 06 4minEDIT 720p30 ST", "thumb": "https://i.ytimg.com/vi/6qOdSX7Vt2g/maxresdefault.jpg"}], "collections": [{"id": 25, "name": "Mass Effect"}], "characters": [{"id": 3, "name": "Ashley Williams"}, {"id": 6, "mug_shot": {"id": 3514, "url": "//images.igdb.com/igdb/image/upload/t_thumb/l3n0zuklmgkloi1udslt.jpg"}, "name": "Commander Shepard (female)"}, {"id": 10, "mug_shot": {"id": 3515, "url": "//images.igdb.com/igdb/image/upload/t_thumb/lnozdao4v2rzjbpvatfx.jpg"}, "name": "Commander Shepard (male)"}, {"id": 9, "mug_shot": {"id": 3851, "url": "//images.igdb.com/igdb/ima