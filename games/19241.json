ampaigncoop": true, "dropin": true, "game": 19241, "lancoop": false, "offlinecoop": true, "offlinecoopmax": 2, "offlinemax": 2, "onlinecoop": false, "platform": 48, "splitscreen": false, "checksum": "de821e23-025d-7d0e-18b1-7946e6bef55b"}, {"id": 8802, "campaigncoop": true, "dropin": true, "game": 19241, "lancoop": false, "offlinecoop": true, "offlinecoopmax": 2, "offlinemax": 2, "onlinecoop": false, "platform": 49, "splitscreen": false, "checksum": "a861d46c-9c6b-47bd-709b-8897495c9ad4"}, {"id": 8800, "campaigncoop": true, "dropin": true, "game": 19241, "lancoop": false, "offlinecoop": true, "offlinecoopmax": 2, "offlinemax": 2, "onlinecoop": false, "platform": 6, "splitscreen": false, "checksum": "cde901e1-7786-43c3-0e27-7f39e8ff1d92"}], "name": "Unravel Two", "platforms": [48, 6, 49, 130], "player_perspectives": [{"id": 2, "name": "Third person"}, {"id": 4, "name": "Side view"}], "rating": 77.80827667298776, "release_dates": [{"id": 676673, "date": 1528502400, "platform": 6, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 676675, "date": 1528502400, "platform": 49, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 676674, "date": 1528502400, "platform": 48, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 676672, "date": 1553212800, "platform": 130, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 213718, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ylux6f5mrvx6un0i8pth.jpg"}, {"id": 213717, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qopawa3r6e5fwgqwm5bu.jpg"}, {"id": 213716, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bhuim9eun1hhcyzc49dw.jpg"}, {"id": 213715, "url": "//images.igdb.com/igdb/image/upload/t_thumb/iyj16hbpkgbf75v5jfen.jpg"}], "slug": "unravel-two", "storyline": "The sequel to the wordless yarn adventure Unravel, Unravel Two trades a solitary journey for a story of companionship. It opens amid a storm at sea, where a small red Yarny, a creature spun from thread, is torn from his home and washed ashore among the wreckage of a ship, his life-line severed to a frayed dead end. There he meets a second Yarny, colored blue, and the two join their loose ends together to form an unbreakable bond. From that connection a glowing spark is born, and chasing its light becomes the pair's guiding purpose. Bound to one another, the two Yarnys must cooperate at every turn, swinging, climbing, and solving puzzles that neither could manage alone as they explore a lush island of forests and shorelines. Along the way they cross paths with two troubled children, and the little companions use their spark to help and protect them through a tender tale of friendship and hope.", "summary": "Unravel Two is the sequel to the 2015 puzzle platforming game Unravel. In the game there are two Yarny's (made out of yarn) which can be controlled by one player, though the game can also be played in co-op. Together the Yarny's explore area's and solve the puzzles within them.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 35, "name": "Kids"}], "url": "https://www.igdb.com/games/unravel-two", "videos": [{"id": 20438, "name": "Trailer", "video_id": "j2TmLrTl6gs", "url": "https://www.youtube.com/watch?v=j2TmLrTl6gs", "title": "Unravel Two: Official Reveal Trailer | EA Play 2018", "thumb": "https://i.ytimg.com/vi/j2TmLrTl6gs/maxresdefault.jpg"}], "collections": [{"id": 3566, "name": "Unravel"}]}