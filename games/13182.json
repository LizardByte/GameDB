form": 49, "y": 2016, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 890050, "date": 1768953600, "platform": 167, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 890051, "date": 1768953600, "platform": 169, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 18794, "url": "//images.igdb.com/igdb/image/upload/t_thumb/d7kd48vtry0jnw362qx4.jpg"}, {"id": 18790, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zeq2ua0mdmp1xkenqtwx.jpg"}, {"id": 18793, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mjny7prkbsvqnzwk6vgn.jpg"}, {"id": 18792, "url": "//images.igdb.com/igdb/image/upload/t_thumb/vjiehifbq6l1jxvo5ung.jpg"}, {"id": 18791, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bkpdhculvgpuftpqz7rc.jpg"}], "slug": "far-cry-primal", "storyline": "Takkar, a hunter of the Wenja tribe, becomes separated from his people after his hunting party is killed by a sabertooth tiger in the prehistoric land of Oros. He soon learns that the Wenja have been scattered across the valley, their village destroyed by the brutal Udam, a Neanderthal-like tribe that raids them for food. Takkar discovers he possesses the rare ability to tame wild animals, earning him the title of Beast Master. He begins gathering the surviving Wenja around a new settlement, rebuilding their strength.\n\nAs Takkar unites his people, he faces threats from two directions: the cannibalistic Udam in the northern mountains, and the Izila, a more technologically advanced tribe in the southern marshlands who capture Wenja for slavery and ritual sacrifice. With an ever-growing pack of tamed beasts at his side and specialist allies lending their skills, Takkar must lead his tribe against both enemies if the Wenja are to survive in Oros.", "summary": "Far Cry Primal is a first-person action game set in 10,000 BC during the transition from the Upper Paleolithic to the Mesolithic period. As part of the Far Cry series, it replaces modern firearms with prehistoric weapons including spears, clubs, and bows. Players take the role of Takkar, a Wenja tribesman who can tame wild animals such as sabertooth cats and wolves to use as companions in combat. The open world takes place in the fictional Oros valley and features a day-night cycle with dynamic wildlife behavior, tribal warfare, and resource crafting. The game's characters speak a constructed language based on reconstructed Proto-Indo-European.", "themes": [{"id": 1, "name": "Action"}, {"id": 21, "name": "Survival"}, {"id": 22, "name": "Historical"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/far-cry-primal", "videos": [{"id": 5752, "name": "Announcement Trailer", "video_id": "4E6THsoiokA", "url": "https://www.youtube.com/watch?v=4E6THsoiokA", "title": "Far Cry: Primal - Announcement Trailer (Official)", "thumb": "https://i.ytimg.com/vi/4E6THsoiokA/maxresdefault.jpg"}, {"id": 6812, "name": "King of Oros", "video_id": "-KVA5CeTsro", "url": "https://www.youtube.com/watch?v=-KVA5CeTsro", "title": "Far Cry: Primal - King of Oros Trailer (Official)", "thumb": "https://i.ytimg.com/vi/-KVA5CeTsro/maxresdefault.jpg"}, {"id": 5753, "name": "Behind the Scenes Trailer", "video_id": "bqMmERKezpk", "url": "https://www.youtube.com/watch?v=bqMmERKezpk", "title": "Far Cry: Primal - Behind the Scenes Trailer (Official)", "thumb": "https://i.ytimg.com/vi/bqMmERKezpk/maxresdefault.jpg"}, {"id": 6356, "name": "Beast Master Trailer", "video_id": "Y-ejYYRZpxg", "url": "https://www.youtube.com/watch?v=Y-ejYYRZpxg", "title": "Far Cry: Primal - Beast Master Trailer (Official)", "thumb": "https://i.ytimg.com/vi/Y-ejYYRZpxg/maxresdefault.jpg"}, {"id": 6358, "name": "Wildlife Vignette", "video_id": "kRbzkZODGy0", "url": "https://www.youtube.com/watch?v=kRbzkZODGy0", "title": "Far Cry: Primal - Wildlife Vignette (Official)", "thumb": "https://i.ytimg.com/vi/kRbzkZODGy0/maxresdefault.jpg"}, {"id": 6811, "name": "Behind the Scenes 3", "video_id": "8ZymcuTQfgw", "url": "https://www.youtube.com/watch?v=8ZymcuTQfgw", "title": "Far Cry: Primal - Behind the Scenes 3 (Official)", "thumb": "https://i.ytimg.com/vi/8ZymcuTQfgw/maxresdefault.jpg"}, {"id": 6990, "name": "101 Trailer", "video_id": "CQOiedRo-dc", "url": "https://www.youtube.com/watch?v=CQOiedRo-dc", "title": "Far Cry: Primal - 101 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/CQOiedRo-dc/maxresdefault.jpg"}, {"id": 6357, "name": "Gameplay Walkthrough #1", "video_id": "idnMSPnpI6c", "url": "https://www.youtube.com/watch?v=idnMSPnpI6c", "title": "Far Cry: Primal - Gameplay Walkthrough #1 (Official)", "thumb": "https://i.ytimg.com/vi/idnMSPnpI6c/maxresdefault.jpg"}], "collections": [{"id": 103, "name": "Far Cry"}], "characters": [{"id": 14337, "name": "Voice Talent In-Game"}]}