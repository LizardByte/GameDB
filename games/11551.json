{"id": 11551, "cover": {"id": 576484, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cocctg.jpg"}, "external_games": [{"id": 1982882, "name": "Mugwump", "uid": "1724633889", "url": "https://www.twitch.tv/directory/game/Mugwump", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 9, "name": "Puzzle"}], "involved_companies": [{"id": 400361, "company": {"id": 35827, "name": "Commodore Educational Software"}, "developer": false}, {"id": 400362, "company": {"id": 10933, "name": "Creative Computing Software"}, "developer": false}, {"id": 400363, "company": {"id": 33018, "name": "People's Computer Company"}, "developer": false}], "name": "Mugwump", "platforms": [15, 409, 90], "player_perspectives": [{"id": 5, "name": "Text"}], "release_dates": [{"id": 939074, "date": 102470400, "platform": 409, "y": 1973, "release_region": {"id": 2, "region": "north_america"}}, {"id": 939072, "date": 410140800, "platform": 15, "y": 1982, "release_region": {"id": 2, "region": "north_america"}}, {"id": 939073, "date": 283910400, "platform": 90, "y": 1978, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 1874328, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1468o.jpg"}, {"id": 1874329, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1468p.jpg"}, {"id": 1874330, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1468q.jpg"}, {"id": 1874331, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc1468r.jpg"}], "slug": "mugwump", "summary": "Mugwump is an early video game where the user is tasked with finding four \"Mugwumps\" that are randomly hidden on a 10x10 grid. It is a text-based game written in BASIC.\n\nThe user enters a pair of single-digit co-ordinates in the range from 0 to 9 which are the x,y coordinates to scan. If a mugwump is at that location then the user is alerted. Otherwise the user is told the distance from the scanned coordinates to each of the mugwumps that are yet to be found. The game ends after ten turns or when all of the mugwumps have been found.", "url": "https://www.igdb.com/games/mugwump", "videos": [{"id": 189653, "name": "Gameplay Video", "video_id": "yB52VZcoKaY", "url": "https://www.youtube.com/watch?v=yB52VZcoKaY", "title": "Mugwump (1973) | Hunt the Mugwump | 013", "thumb": "https://i.ytimg.com/vi/yB52VZcoKaY/maxresdefault.jpg"}]}