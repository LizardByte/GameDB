d": 2, "region": "north_america"}}, {"id": 833698, "date": 1392076800, "platform": 38, "y": 2014, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 1696661, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5h.jpg"}, {"id": 1696664, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5k.jpg"}, {"id": 1696665, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5l.jpg"}, {"id": 1696666, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5m.jpg"}, {"id": 1696667, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5n.jpg"}, {"id": 1696662, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5i.jpg"}, {"id": 1696663, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d5j.jpg"}], "slug": "wolf-fang", "storyline": "Wolf Fang SS Kuuga 2001 is the sequel to Vapor Trail. In 2001, two years after the events from Vapor Trail, the technology allows for the building of mechs rather than jets. The DAGGER organization returns and targets the mech factories in Australia and New Zealand.", "summary": "Wolf Fang: Kuuga 2001 was released in Japanese arcades in 1991.The game was released for the Sony PlayStation on May 10, 1996, and to the Sega Saturn on March 28, 1997. Both conversions were developed by Xing Entertainment (famous for the arcade port collection known as Arcade Gears). The console versions have added features such as a new title screen, new introduction, an original redbook audio soundtrack and a staff roll after the endings.\n\nIn 2010, the game was added to the PlayStation Network to allow users to download to and play either on the PSP or PS3. In 2014, MonkeyPaw Games released it on PSN for Western audiences.", "themes": [{"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/wolf-fang", "videos": [{"id": 168080, "name": "Gameplay Video", "video_id": "eXMFCX7JhVs", "url": "https://www.youtube.com/watch?v=eXMFCX7JhVs", "title": "Wolf Fang: Kuuga 2001| PS1 | 4K60\u1da0\u1d56\u02e2