{"id": 31, "name": "Adventure"}], "involved_companies": [{"id": 194929, "company": {"id": 15790, "name": "Ubisoft Qu\u00e9bec"}, "developer": true}, {"id": 215818, "company": {"id": 104, "name": "Ubisoft Entertainment"}, "developer": false}], "name": "Assassin's Creed: Odyssey - Gold Edition", "platforms": [48, 6, 49], "player_perspectives": [{"id": 2, "name": "Third person"}], "release_dates": [{"id": 351125, "date": 1538697600, "platform": 6, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 351124, "date": 1538697600, "platform": 48, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 351123, "date": 1538697600, "platform": 49, "y": 2018, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 588075, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrf.jpg"}, {"id": 588081, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrl.jpg"}, {"id": 588077, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrh.jpg"}, {"id": 588080, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrk.jpg"}, {"id": 588083, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrn.jpg"}, {"id": 588076, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrg.jpg"}, {"id": 588078, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclri.jpg"}, {"id": 588079, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scclrj.jpg"}], "slug": "assassins-creed-odyssey-gold-edition", "storyline": "Set against the backdrop of the Peloponnesian War between Athens and Sparta in the fifth century BCE, Assassin's Creed Odyssey immerses players in a sweeping, mythologically tinged vision of ancient Greece. At the outset, the player chooses to play as one of two siblings, Alexios or Kassandra, a Greek mercenary and descendant of the legendary Spartan king Leonidas. Cast out and living the hardscrabble life of a sellsword, the hero takes up work for both sides of the sprawling conflict, sailing the Aegean and roaming its city-states, islands, and battlefields. Their personal journey is driven by two intertwined goals: to reunite a family long torn apart, and to expose and dismantle the sinister Cult of Kosmos, a secret society pulling hidden strings across the Greek world. Along the way, the mercenary crosses paths with famous historical figures and mythical dangers alike, forging an epic odyssey shaped by the player's own choices.", "summary": "Write your own epic odyssey and become a legendary Spartan hero in Assassin's Creed Odyssey, an inspiring adventure where you must forge your destiny and define your own path in a world on the brink of tearing itself apart. Influence how history unfolds as you experience a rich and ever-changing world shaped by your decisions.\n\nThe Gold Edition includes the Season Pass.", "themes": [{"id": 1, "name": "Action"}, {"id": 22, "name": "Historical"}, {"id": 23, "name": "Stealth"}], "url": "https://www.igdb.com/games/assassins-creed-odyssey-gold-edition", "videos": [{"id": 66016, "name": "Trailer", "video_id": "Md-uL6opUFY", "url": "https://www.youtube.com/watch?v=Md-uL6opUFY", "title": "ASSASSIN'S CREED ODYSSEY: Final Trailer (2018)", "thumb": "https://i.ytimg.com/vi/Md-uL6opUFY/maxresdefault.jpg"}, {"id": 66017, "name": "Gameplay Trailer", "video_id": "vAxc0c5de0c", "url": "https://www.youtube.com/watch?v=vAxc0c5de0c", "title": "Assassin's Creed: Odyssey - E3 2018 Walkthrough Trailer", "thumb": "https://i.ytimg.com/vi/vAxc0c5de0c/maxresdefault.jpg"}]}