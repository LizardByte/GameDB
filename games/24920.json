gdb.com/igdb/image/upload/t_thumb/y6rjbgnagfidkyqecxuu.jpg"}, {"id": 34222, "url": "//images.igdb.com/igdb/image/upload/t_thumb/h0rfqo0gzycq5hc8fahx.jpg"}, {"id": 1371154, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctdzm.jpg"}, {"id": 34223, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mcwj7n5odkdw0zbilv4j.jpg"}, {"id": 1371153, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctdzl.jpg"}, {"id": 1371155, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctdzn.jpg"}, {"id": 1371156, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctdzo.jpg"}], "slug": "call-of-duty-modern-warfare-remastered", "storyline": "A faithful remaster of the landmark 2007 shooter, Modern Warfare Remastered preserves the original's acclaimed campaign, set in a tense near-future 2011. Two crises erupt at once. In Russia, civil war breaks out between the government and a resurgent Ultranationalist movement seeking to restore the country's Soviet-era power. Simultaneously, in an unnamed Middle Eastern nation, a ruthless warlord named Khaled Al-Asad seizes power in a violent coup and executes the country's president on live television. The story unfolds through the eyes of two forces drawn into the escalating conflict: new British Special Air Service recruit Sergeant John \"Soap\" MacTavish, serving under the seasoned Captain John Price, and United States Marine Sergeant Paul Jackson, deployed as America intervenes to capture Al-Asad. As the SAS raids Ultranationalist strongholds and the Marines storm the war-torn capital, the two operations begin to converge on a threat far greater than either side first realizes.", "summary": "One of the most critically-acclaimed games in history. Call of Duty 4: Modern Warfare is back, remastered in true high-definition, featuring enhanced textures, rendering, high-dynamic range lighting, and much more to bring a new generation experience to fans.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/call-of-duty-modern-warfare-remastered", "videos": [{"id": 14686, "name": "Trailer", "video_id": "frcic8ApwJ0", "url": "https://www.youtube.com/watch?v=frcic8ApwJ0", "title": "Official Call of Duty\u00ae: Modern Warfare Remastered 2017 Launch Trailer", "thumb": "https://i.ytimg.com/vi/frcic8ApwJ0/maxresdefault.jpg"}, {"id": 10945, "name": "Trailer", "video_id": "l-eMi1xJ2dM", "url": "https://www.youtube.com/watch?v=l-eMi1xJ2dM", "title": "Official Call of Duty\u00ae: Modern Warfare\u00ae Remastered \u2013 Launch Trailer", "thumb": "https://i.ytimg.com/vi/l-eMi1xJ2dM/maxresdefault.jpg"}], "collections": [{"id": 107, "name": "Call of Duty"}, {"id": 1957, "name": "Call of Duty: Modern Warfare"}]}