}, {"id": 1512264, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwevc.jpg"}], "slug": "double-whammy", "storyline": "Double Whammy is an action-simulation game that follows Gigi, an aspiring guitarist, as she navigates the challenges of balancing her day job at a guitar shop with nightly battles against interdimensional monsters.\n\nAfter discovering an old guitar instruction book, Gigi opens a portal to the dream realm where she must combat otherworldly threats. Although each night's trials end in the morning, the consequences of her battles extend into the real world. Upon waking, Gigi finds that her guitars retain the damage they sustained in her dreams. To prepare for the next night, she must work at the guitar shop to repair her broken guitars and acquire new gear.", "summary": "Work at a guitar shop by day! Fight monsters by night! Make custom guitars!", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/double-whammy", "videos": [{"id": 133697, "name": "Release Date Trailer", "video_id": "XHOe6fnsTfw", "url": "https://www.youtube.com/watch?v=XHOe6fnsTfw", "title": "Double Whammy - Official Release Window Trailer | The MIX Fall Showcase 2024", "thumb": "https://i.ytimg.com/vi/XHOe6fnsTfw/maxresdefault.jpg"}, {"id": 146889, "name": "Trailer", "video_id": "VXRhLatJX-E", "url": "https://www.youtube.com/watch?v=VXRhLatJX-E", "title": "Double Whammy Gameplay Montage (2025 April)", "thumb": "https://i.ytimg.com/vi/VXRhLatJX-E/maxresdefault.jpg"}, {"id": 172522, "name": "Trailer", "video_id": "G1UyffA__Yk", "url": "https://www.youtube.com/watch?v=G1UyffA__Yk", "title": "Double Whammy - 2025 Dec Gameplay (purple road #2)", "thumb": "https://i.ytimg.com/vi/G1UyffA__Yk/maxresdefault.jpg"}]}