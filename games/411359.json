"}, {"id": 1886497, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14fmp.jpg"}], "slug": "zoo-protocol", "storyline": "You and your team have been assigned to an abandoned alien industrial complex controlled by a malfunctioning corporate system. Your job is simple: keep dangerous anomalous creatures alive, maintain the facility, and meet impossible production quotas.\n\nAs the complex continues to deteriorate, routine maintenance turns into a fight for survival. Explore abandoned sectors, recover logs left behind by the previous shift, uncover the truth behind the Zoo Protocol, and find a way to escape before the system marks your crew for disposal.", "summary": "Zoo Protocol is a co-op sci-fi horror game where you and your team are assigned to an abandoned alien industrial complex run by a malfunctioning corporate system. Care for dangerous anomalous creatures, prepare nutritional mixtures, process waste into energy, repair failing machinery, and meet ever-growing production quotas. Explore the facility, uncover the fate of the previous shift, and fight to escape before the system decides you're no longer needed.", "themes": [{"id": 18, "name": "Science fiction"}, {"id": 19, "name": "Horror"}, {"id": 21, "name": "Survival"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/zoo-protocol", "videos": [{"id": 191318, "name": "Trailer", "video_id": "RK4KZQpDdlI", "url": "https://www.youtube.com/watch?v=RK4KZQpDdlI", "title": "ZOO PROTOCOL - OFFICIAL EARLY ACCESS TRAILER", "thumb": "https://i.ytimg.com/vi/RK4KZQpDdlI/maxresdefault.jpg"}, {"id": 193601, "name": "Cinematic Trailer", "video_id": "qI3PKAYsTW0", "url": "https://www.youtube.com/watch?v=qI3PKAYsTW0", "title": "ZOO PROTOCOL - OFFICIAL CINEMATIC TRAILER", "thumb": "https://i.ytimg.com/vi/qI3PKAYsTW0/maxresdefault.jpg"}]}