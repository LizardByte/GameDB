yrf4p4s8.jpg"}, {"id": 182302, "url": "//images.igdb.com/igdb/image/upload/t_thumb/weixmvzfp2yckrmhxhrh.jpg"}, {"id": 182296, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ft730tyoteefkaaquzyi.jpg"}, {"id": 140425, "url": "//images.igdb.com/igdb/image/upload/t_thumb/p8fqqkzeljo8tlq5382z.jpg"}, {"id": 140426, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hj0wvnio5cotwbzgh2kv.jpg"}, {"id": 140423, "url": "//images.igdb.com/igdb/image/upload/t_thumb/it8l2ca0m0kcjejecnmw.jpg"}, {"id": 182297, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yv5e7ksy2icciwlg6miq.jpg"}, {"id": 182299, "url": "//images.igdb.com/igdb/image/upload/t_thumb/iqaasscz6hwyxuhspbez.jpg"}, {"id": 182301, "url": "//images.igdb.com/igdb/image/upload/t_thumb/l8im76tqrxm1zgpnxjib.jpg"}, {"id": 182300, "url": "//images.igdb.com/igdb/image/upload/t_thumb/t7ndevjwgch1y72my1ke.jpg"}, {"id": 182303, "url": "//images.igdb.com/igdb/image/upload/t_thumb/b0tlp6gwgddhl8mbshu9.jpg"}], "slug": "just-dance-2014", "summary": "Just Dance 2014 is a dance rhythm game that has you match the choreography of an on-screen dancer to earn points for accuracy, using your motion controller for real-time movement tracking. Beyond single-player routines, it expands the experience with online multiplayer via World Dance Floor, where you compete simultaneously with others, plus Wii U and Xbox-style second-screen support that helps you manage routines, playlists, and performance from a companion device.\nThe update also adds spotlight-friendly On Stage modes, letting one player lead with others as backup dancers, along with AutoDance to record and share your gameplay and Karaoke for singing along to on-screen lyrics. For variety and fitness, it supports customized workout playlists, calorie tracking across modes, and more dances per track through alternate choreographies in categories like Just Sweat, Extreme, Battle, and Mash-Up.", "themes": [{"id": 1, "name": "Action"}, {"id": 40, "name": "Party"}], "url": "https:/