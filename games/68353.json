, "name": "Twitch"}}, {"id": 2873192, "name": "Unicorn Overlord", "uid": "10002780", "url": "https://store.playstation.com/en-us/concept/10002780", "external_game_source": {"id": 36, "name": "Playstation Store US"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 12, "name": "Role-playing (RPG)"}, {"id": 15, "name": "Strategy"}, {"id": 16, "name": "Turn-based strategy (TBS)"}, {"id": 24, "name": "Tactical"}], "involved_companies": [{"id": 254437, "company": {"id": 818, "name": "Atlus"}, "developer": false}, {"id": 231263, "company": {"id": 112, "name": "Sega"}, "developer": false}, {"id": 231261, "company": {"id": 1060, "name": "Vanillaware"}, "developer": true}], "name": "Unicorn Overlord", "platforms": [169, 48, 167, 130], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}, {"id": 4, "name": "Side view"}], "rating": 83.67467559937432, "release_dates": [{"id": 516137, "date": 1709856000, "platform": 169, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 516139, "date": 1709856000, "platform": 167, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 516138, "date": 1709856000, "platform": 48, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 516124, "date": 1709856000, "platform": 130, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1144844, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojd8.jpg"}, {"id": 1144847, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojdb.jpg"}, {"id": 1144841, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojd5.jpg"}, {"id": 1144842, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojd6.jpg"}, {"id": 1144843, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojd7.jpg"}, {"id": 1144845, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojd9.jpg"}, {"id": 1144846, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojda.jpg"}, {"id": 1144848, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scojdc.jpg"}], "slug": "unicorn-overlord--1", "storyline": "In the kingdom of Cornia, General Valmore leads a rebellion against Queen Ilenia, and with most of the army rallying to his side the throne is soon lost. Before making her final stand, Ilenia entrusts her guard Josef with smuggling her young son Alain and the Ring of the Unicorn, the symbol of Cornian royalty, to safety. Ten years later, Valmore has renamed himself Galerius and forged the sprawling Zenoirian Empire, subjugating neighboring lands from Drakenhold to the elvish realm of Elheim. Raised in hiding on a remote island, Alain comes of age and takes up the mantle of the Liberation Army. Discovering that the Ring of the Unicorn can break the mind-control magic Galerius uses to bend others to his will, Alain sets out to reclaim his homeland.", "summary": "From the masterminds that brought 13 Sentinels: Aegis Rim and Odin Sphere, ATLUS x Vanillaware presents the rebirth of tactical fantasy RPG. Fight against fate and embark on a royal adventure to regain your reign alongside trustworthy allies.\n\nUnicorn Overlord combines the timeless tactical RPG genre with overworld exploration and innovative battle system for a unique epic fantasy experience in the iconic Vanillaware style.\n\nTraverse a vibrant world, assemble units and direct them into exquisitely animated battles. Perform heroic deeds and grow renown throughout the five nations. Cultivate a grand army with over 60 unique characters, from humans and elves to massive beasts and heavenly angels", "themes": [{"id": 17, "name": "Fantasy"}, {"id": 39, "name": "Warfare"}], "url": "https://www.igdb.com/games/unicorn-overlord--1", "videos": [{"id": 97868, "name": "Announcement Trailer", "video_id": "I-enIFmoDrc", "url": "https://www.youtube.com/watch?v=I-enIFmoDrc", "title": "Unicorn Overlord \u2014 Announcement Trailer | Nintendo Switch, PS5, PS4, Xbox Series X|S", "thumb": "https://i.ytimg.com/vi/I-enIFmoDrc/maxresdefault.jpg"}, {"id": 97928, "name": "Teaser", "video_id": "Wr7_RTHy16c", "url": "https://www.youtube.com/watch?v=Wr7_RTHy16c", "title": "New Vanillaware Project Tease", "thumb": "https://i.ytimg.com/vi/Wr7_RTHy16c/hqdefault.jpg"}, {"id": 107610, "name": "Demo Trailer", "video_id": "1u4z9tDwohg", "url": "https://www.youtube.com/watch?v=1u4z9tDwohg", "title": "Unicorn Overlord \u2014 Demo Trailer | Nintendo Switch", "thumb": "https://i.ytimg.com/vi/1u4z9tDwohg/maxresdefault.jpg"}]}