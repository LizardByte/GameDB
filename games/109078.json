5.jpg"}, {"id": 1530760, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwt54.jpg"}, {"id": 1530766, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwt5a.jpg"}, {"id": 1530767, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwt5b.jpg"}, {"id": 1530764, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scwt58.jpg"}], "slug": "shinpi-no-sekai-el-hazard", "storyline": "The protagonist of the story is a young high-school student boy, Makoto Mizuhara, who finds himself, due to various circumstances, tossed into the fantasy world of El-Hazard. While the main character and the setting is based on the anime, this is a completely new story with certain changes and new characters.", "summary": "Shinpi no Sekai: El-Hazard is based off of an anime with the same title.\n\nThe game plays like an enhanced visual novel which is fully voice-acted and displays protagonist and other characters on the screen during dialogues. Event scenes and animations are quite common, and character poses depicting their current disposition is displayed in portrait images which are also animated. Unlike typical visual novels where the player is limited to dialogue and choices, players can explore various locations on the map and try to perform actions outside the dialogue window, such as initiating a talk to other characters, or look around the area or go someplace else.", "themes": [{"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 44, "name": "Romance"}], "url": "https://www.igdb.com/games/shinpi-no-sekai-el-hazard", "videos": [{"id": 150026, "name": "Gameplay Video", "video_id": "9DsW7-dXfMI", "url": "https://www.youtube.com/watch?v=9DsW7-dXfMI", "title": "Shinpi no Sekai - El-Hazard \u300e\u795e\u79d8\u306e\u4e16\u754c\u30a8\u30eb\u30cf\u30b6\u30fc\u30c9\u300f\u3010\u30bb\u30ac\u30b5\u30bf\u30fc\u30f3\u3011\u30101\u3011", "thumb": "https://i.ytimg.com/vi/9DsW7-dXfMI/maxresdefault.jpg"}]}