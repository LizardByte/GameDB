ube", "videos": [{"id": 169634, "name": "Gameplay Video", "video_id": "tQGMWnfKXlQ", "url": "https://www.youtube.com/watch?v=tQGMWnfKXlQ", "title": "PlayStation - Geom Cube (1995)", "thumb": "https://i.ytimg.com/vi/tQGMWnfKXlQ/maxresdefault.jpg"}]}