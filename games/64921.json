 {"id": 727561, "date": 983318400, "platform": 6, "y": 2001, "release_region": {"id": 1, "region": "europe"}}, {"id": 727562, "date": 968889600, "platform": 6, "y": 2000, "release_region": {"id": 1, "region": "europe"}}, {"id": 727563, "date": 977443200, "platform": 7, "y": 2000, "release_region": {"id": 1, "region": "europe"}}, {"id": 727564, "date": 987033600, "platform": 7, "y": 2001, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 1505253, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw9gl.jpg"}, {"id": 1505254, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw9gm.jpg"}, {"id": 1505255, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw9gn.jpg"}, {"id": 1505256, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scw9go.jpg"}], "slug": "mary-kings-riding-star", "summary": "Riding Star is an equestrian simulation where the player has to take care of a horse and ride it in competitions. For the riding the game is shown from a top-down view and in preparation of events the horse needs to be groomed, fed and saddled. There are three different types of events to participate in: dressage, show jumping and cross country. There is also a three-day event. In the championship mode horse and rider compete in multiple championships and the player's care of the horse influences the performance. During the maintenance part everything is controlled with the mouse. In races the horse is controlled through the arrow keys with the space bar to jump. Next to the AI opponents it is also possible to compete with up to four friends on a single computer in the multiplayer event.", "themes": [{"id": 28, "name": "Business"}, {"id": 32, "name": "Non-fiction"}], "url": "https://www.igdb.com/games/mary-kings-riding-star", "videos": [{"id": 145882, "name": "Gameplay Video", "video_id": "uNif4_gj6q8", "url": "https://www.youtube.com/watch?v=uNif4_gj6q8", "title": "Mary King's Riding Star (PC)", "thumb": "https://i.ytimg.com/vi/uNif4_gj6q8/hqdefaul