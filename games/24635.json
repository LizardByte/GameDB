ty", "platforms": [65, 15, 26, 75], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 716844, "date": 473299200, "platform": 65, "y": 1984, "release_region": {"id": 1, "region": "europe"}}, {"id": 716842, "date": 533779200, "platform": 75, "y": 1986, "release_region": {"id": 2, "region": "north_america"}}, {"id": 716843, "date": 460166400, "platform": 65, "y": 1984, "release_region": {"id": 2, "region": "north_america"}}, {"id": 716845, "date": 473299200, "platform": 15, "y": 1984, "release_region": {"id": 1, "region": "europe"}}, {"id": 582377, "date": 473299200, "platform": 15, "y": 1984, "release_region": {"id": 2, "region": "north_america"}}, {"id": 582378, "date": 504835200, "platform": 26, "y": 1985, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 111258, "url": "//images.igdb.com/igdb/image/upload/t_thumb/oobrtimdmfjtgskusd8z.jpg"}, {"id": 353224, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7kjs.jpg"}, {"id": 353223, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7kjr.jpg"}, {"id": 1483588, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scvsqs.jpg"}], "slug": "mike-edwards-realm-of-impossibility", "storyline": "The dungeons the hero must traverse make use of visual effects, similar to those found in M. C. Escher's work, to create physically impossible scenarios. These structures serve as a basis for puzzles which must be solved in-between the fighting in order to proceed.\n\nThe game features a total of 13 dungeons with 129 different rooms. A cooperative mode with another player is also included.", "summary": "Is a platform game in which the protagonist has to fight the titular monsters, snakes, spiders, and an array of other creatures in order to survive.\n\nThe success of the original release \"Zombies\" prompted Don Daglow to acquire the rights for EA. Minor changes were made to the game, new levels were added, and a new soundtrack was added, written by Dave Warhol. Officially renamed \"Mike Edwards' Realm of Impossibility\", it was released not long after the original BRAM release, with the box cover touting \"Deluxe Edition of The Classic Game Zombies\". The game was part of the \"third wave\" of titles introduced by Electronic Arts after its founding in 1982.", "themes": [{"id": 1, "name": "Action"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/mike-edwards-realm-of-impossibility", "videos": [{"id": 110941, "name": "Gameplay Video", "video_id": "LdGBA0FG7Gk", "url": "https://www.youtube.com/watch?v=LdGBA0FG7Gk", "title": "C64 Longplay - Realm Of Impossibility", "thumb": "https://i.ytimg.com/vi/LdGBA0FG7Gk/hqdefault.jpg"}]}