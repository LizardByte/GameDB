{"id": 28400, "age_ratings": [{"id": 178894, "organization": {"id": 4, "name": "USK"}, "rating_category": {"id": 18, "rating": "0"}}, {"id": 62007, "organization": {"id": 1, "name": "ESRB"}, "rating_category": {"id": 3, "rating": "E"}}, {"id": 178893, "organization": {"id": 3, "name": "CERO"}, "rating_category": {"id": 13, "rating": "A"}}, {"id": 178895, "organization": {"id": 7, "name": "ACB"}, "rating_category": {"id": 34, "rating": "G"}}], "artworks": [{"id": 176117, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3rw5.jpg"}, {"id": 176118, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3rw6.jpg"}], "cover": {"id": 101151, "url": "//images.igdb.com/igdb/image/upload/t_thumb/co261r.jpg"}, "external_games": [{"id": 253124, "name": "Devil Dice", "uid": "15423", "url": "https://www.twitch.tv/directory/game/Devil Dice", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 141716, "name": "Devil Dice", "uid": "16824", "url": "https://www.giantbomb.com/games/3030-16824/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}], "genres": [{"id": 9, "name": "Puzzle"}], "involved_companies": [{"id": 46394, "company": {"id": 2216, "name": "Shift"}, "developer": true}, {"id": 46396, "company": {"id": 197, "name": "THQ"}, "developer": false}, {"id": 197753, "company": {"id": 13634, "name": "Sony Computer Entertainment"}, "developer": false}], "name": "Devil Dice", "platforms": [9, 7, 38], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "rating": 70.0, "release_dates": [{"id": 608040, "date": 899078400, "platform": 7, "y": 1998, "release_region": {"id": 1, "region": "europe"}}, {"id": 608041, "date": 899164800, "platform": 7, "y": 1998, "release_region": {"id": 2, "region": "north_america"}}, {"id": 608042, "date": 898128000, "platform": 7, "y": 1998, "release_region": {"id": 5, "region": "japan"}}, {"id": 759703, "date": 1182988800, "platform": 9, "y": 2007, "release_region": {"id": 5, "region": "japan"}}, {"id": 759704, "date": 1182988800, "platform": 38, "y": 2007, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 42693, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zguv1x9x08luvjqnmylp.jpg"}, {"id": 1570068, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scxnh0.jpg"}], "slug": "devil-dice", "summary": "Devil Dice is a unique puzzle game, where the player controls a small devil that runs around a grid covered in large dice. The player can both stand atop dice, and stand on the ground (with the dice towering above). When standing on the dice, the player can move from die to die, or can roll a die in the direction he or she runs, revealing a different face as the die rotates. Creating a group of adjacent dice with identical pips\u2014the size of which must be at least the number of pips\u2014causes those dice to slowly sink into the field before disappearing. Chain reactions are possible by adding additional dice to a sinking set. Different types of dice are available in some modes, with different properties to make the game more challenging.\n\nIt was originally created by developer Shift on the \"homebrew\" Yaroze platform, and later turned into a commercial game. Released in 1998, it is one of only a handful of games to make the leap from the Yaroze to commercial release. The game is a million-seller and a demo version was released as a PlayStation Classic game for the PlayStation 3 and PlayStation Portable on November 7, 2007.", "url": "https://www.igdb.com/games/devil-dice", "videos": [{"id": 117215, "name": "Gameplay Video", "video_id": "uxR2Z3jNlZk", "url": "https://www.youtube.com/watch?v=uxR2Z3jNlZk", "title": "Devil Dice (PS1) - Gameplay", "thumb": "https://i.ytimg.com/vi/uxR2Z3jNlZk/hqdefault.jpg"}], "collections": [{"id": 2691, "name": "Xi"}]}