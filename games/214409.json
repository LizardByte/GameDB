te": 1691625600, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 503829, "date": 1691625600, "platform": 167, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 503830, "date": 1691625600, "platform": 169, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 863300, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4k.jpg"}, {"id": 863299, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4j.jpg"}, {"id": 863295, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4f.jpg"}, {"id": 863296, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4g.jpg"}, {"id": 863297, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4h.jpg"}, {"id": 863298, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scii4i.jpg"}], "slug": "atlas-fallen", "storyline": "Atlas Fallen is an action role-playing game set in a sweeping, sun-scorched fantasy world of endless deserts and buried ruins. Players create and customize their own hero, an ordinary figure who comes into possession of a mysterious ancient gauntlet imbued with extraordinary power. This relic grants command over sand itself, allowing its wielder to conjure shifting weapons from the dunes, glide across the wastes, and raise long-buried structures from beneath the earth to uncover hidden paths and forgotten secrets. Armed with this gift, the hero sets out across a vast open landscape, battling monstrous creatures that roam the sands and growing steadily more powerful as they master the gauntlet's abilities. By collecting shards and fragments scattered through the world, the wielder unlocks ever greater feats of combat and traversal. What begins as the discovery of a wondrous artifact becomes a journey through a desolate realm, one shaped by the player's own choices and the growing might of the sand.", "summary": "Rise from the dust and glide the sands of a timeless land, filled with ancient dangers, mysteries and fragments of the past. Hunt legendary monsters with powerful sand-infused weapons and abilities in spectacular, super-powered combat.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/atlas-fallen", "videos": [{"id": 73646, "name": "Trailer", "video_id": "_hFePdmcci0", "url": "https://www.youtube.com/watch?v=_hFePdmcci0", "title": "Atlas Fallen - World Premiere Reveal Trailer | Gamescom Opening Night Live 2022", "thumb": "https://i.ytimg.com/vi/_hFePdmcci0/maxresdefault.jpg"}, {"id": 94154, "name": "Gameplay Trailer", "video_id": "AGQfhGubWns", "url": "https://www.youtube.com/watch?v=AGQfhGubWns", "title": "Atlas Fallen - Combat Trailer", "thumb": "https://i.ytimg.com/vi/AGQfhGubWns/maxresdefault.jpg"}, {"id": 94523, "name": "Trailer", "video_id": "JJbVvjviXOc", "url": "https://www.youtube.com/watch?v=JJbVvjviXOc", "title": "Atlas Fallen - Gameplay Overview Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/JJbVvjviXOc/maxresdefault.jpg"}]}