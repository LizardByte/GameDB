{"id": 386979, "artworks": [{"id": 246816, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5ag0.jpg"}, {"id": 246817, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5ag1.jpg"}], "cover": {"id": 529568, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cobcm8.jpg"}, "external_games": [{"id": 3139344, "name": "Train Goes Right", "uid": "342862512", "url": "https://www.twitch.tv/directory/game/Train%20Goes%20Right", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 3104722, "name": "Train Goes Right", "uid": "3475880", "url": "https://store.steampowered.com/app/3475880", "external_game_source": {"id": 1, "name": "Steam"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}, {"id": 3, "name": "Co-operative"}], "genres": [{"id": 13, "name": "Simulator"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 394672, "company": {"id": 73293, "name": "Molecular Cohesion"}, "developer": true}], "name": "Train Goes Right", "platforms": [3, 6], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 863578, "date": 1798675200, "platform": 6, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 929309, "date": 1798675200, "platform": 3, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1764431, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11tfz.jpg"}, {"id": 1764424, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11tfs.jpg"}, {"id": 1764427, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11tfv.jpg"}, {"id": 1764425, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11tft.jpg"}, {"id": 1764428, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc11tfw.jpg"}], "slug": "train-goes-right", "storyline": "Step into the mid-19th century and take on the role of a railway pioneer in Train Goes Right, a casual yet immersive co-op adventure where the train never stops\u2014unless you do! In this charming low-poly world, you\u2019ll build an endless railway, one rail at a time, while operating a faithfully simplified steam train. The primary controls of the locomotive are represented, giving you just the right level of interaction to keep the train moving forward without overwhelming complexity. Whether you prefer to play alone or team up with friends, Train Goes Right offers both local and online co-op so you can lay rail at your own pace. Don\u2019t like trains? That\u2019s fine too\u2014we left you a handcart in the corner.", "summary": "A cozy physics based railroad simulator where you chop trees, drive trains, transport materials, and build track one rail at a time in the early steam age. The goal is simple: go right.", "url": "https://www.igdb.com/games/train-goes-right", "videos": [{"id": 174453, "name": "Trailer", "video_id": "oEW7Te65Ltc", "url": "https://www.youtube.com/watch?v=oEW7Te65Ltc", "title": "Train Goes Right Trailer", "thumb": "https://i.ytimg.com/vi/oEW7Te65Ltc/maxresdefault.jpg"}, {"id": 182777, "name": "Trailer", "video_id": "gsnXyVVa0w0", "url": "https://www.youtube.com/watch?v=gsnXyVVa0w0", "title": "Train Goes Right - Updated Trailer", "thumb": "https://i.ytimg.com/vi/gsnXyVVa0w0/fhddefault.jpg"}]}