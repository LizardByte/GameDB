eveloper": false}, {"id": 344975, "company": {"id": 16845, "name": "Ubi Soft Entertainment"}, "developer": false}, {"id": 344976, "company": {"id": 1151, "name": "Game Arts"}, "developer": true}, {"id": 344977, "company": {"id": 13634, "name": "Sony Computer Entertainment"}, "developer": false}, {"id": 344974, "company": {"id": 1953, "name": "Entertainment Software Publishing"}, "developer": false}], "name": "Grandia", "platforms": [9, 34, 32, 7, 38], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "rating": 76.04513563077089, "release_dates": [{"id": 774145, "date": 954460800, "platform": 7, "y": 2000, "release_region": {"id": 1, "region": "europe"}}, {"id": 774146, "date": 941068800, "platform": 7, "y": 1999, "release_region": {"id": 2, "region": "north_america"}}, {"id": 774147, "date": 930182400, "platform": 7, "y": 1999, "release_region": {"id": 5, "region": "japan"}}, {"id": 774148, "date": 1289347200, "platform": 9, "y": 2010, "release_region": {"id": 1, "region": "europe"}}, {"id": 774149, "date": 1267056000, "platform": 9, "y": 2010, "release_region": {"id": 2, "region": "north_america"}}, {"id": 774150, "date": 1240358400, "platform": 9, "y": 2009, "release_region": {"id": 5, "region": "japan"}}, {"id": 774151, "date": 1267056000, "platform": 38, "y": 2010, "release_region": {"id": 2, "region": "north_america"}}, {"id": 774152, "date": 1240358400, "platform": 38, "y": 2009, "release_region": {"id": 5, "region": "japan"}}, {"id": 774153, "date": 1289347200, "platform": 38, "y": 2010, "release_region": {"id": 1, "region": "europe"}}, {"id": 774157, "date": 882403200, "platform": 32, "y": 1997, "release_region": {"id": 5, "region": "japan"}}, {"id": 799033, "date": 1334188800, "platform": 34, "y": 2012, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 377823, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc83j3.jpg"}, {"id": 306614, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6kl2.jpg"}, {"id": 306615, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6kl3.jpg"}, {"id": 1635396, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scz1vo.jpg"}, {"id": 1635397, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scz1vp.jpg"}], "slug": "grandia", "storyline": "The game takes place in a fantasy world where emerging technology and exploration are prevalent. A young boy named Justin inherits a magic stone that leads him on a journey around the world to uncover the mystery of a long-lost civilization. Along the way, he meets other adventurers who join him on his quest, which draws the attention of the militaristic Garlyle Forces who seek to uncover the secrets of the past as well.", "summary": "Grandia is a role-playing video game developed by Game Arts and published by Entertainment Software Publishing for the Sega Saturn console as the first game in their Grandia series. Initially released in Japan in 1997, the game was later ported to the PlayStation in 1999, with an English version of the game appearing on the platform in North America in the following September by Sony Computer Entertainment America, and later in Europe in March 2000 by Ubisoft. The game was produced by much of the same staff who worked on the company's previous role-playing endeavor, the Lunar series, including producer Yoichi Miyagi and music composer Noriyuki Iwadare.\n\nSince its release, Grandia has become notable for its combat mechanics, which have been carried over to future games within the franchise, and has spawned two spin-off titles \u2013 Grandia: Digital Museum and Grandia: Parallel Trippers \u2013 both released exclusively in Japan. In celebration of the announcement of renewing development on Grandia Online, which acts as a prequel to Grandia, the game was re-released on Sony's PlayStation Network platform in Japan as a downloadable title in April 2009 and in North America on February 25, 2010. It was re-released in Europe on November 10, 2010.", "themes": [{"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/grandia", "videos": [{"id": 161642, "name": "Trailer", "video_id": "PYMOJJZ8UNs", "url": "https://www.youtube.com/watch?v=PYMOJJZ8UNs", "title": "Grandia Official Trailer", "thumb": "https://i.ytimg.com/vi/PYMOJJZ8UNs/hqdefault.jpg"}, {"id": 161643, "name": "Gameplay Video", "video_id": "ixQs9pTKac0", "url": "https://www.youtube.com/watch?v=ixQs9pTKac0", "title": "Grandia (Sega Saturn) - Title Screen + Opening", "thumb": "https://i.ytimg.com/vi/ixQs9pTKac0/sddefault.jpg"}, {"id": 161644, "name": "Gameplay Video", "video_id": "bolj8xirfGs", "url": "https://www.youtube.com/watch?v=bolj8xirfGs", "title": "Grandia - Full Game Walkthrough - No Commentary - Longplay - Gameplay", "thumb": "https://i.ytimg.com/vi/bolj8xirfGs/maxresdefault.jpg"}], "collections": [{"id": 1289, "name": "Grandia"}]}