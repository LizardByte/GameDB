igdb.com/igdb/image/upload/t_thumb/js4sbpb1ybepbm9f4dh7.jpg"}, {"id": 46910, "url": "//images.igdb.com/igdb/image/upload/t_thumb/fqiskihdkyoeexkwenfc.jpg"}, {"id": 46909, "url": "//images.igdb.com/igdb/image/upload/t_thumb/vscnhpjllpny9utfp1mi.jpg"}, {"id": 46912, "url": "//images.igdb.com/igdb/image/upload/t_thumb/t3ty3n3kt2mtmou4o6zj.jpg"}], "slug": "quake-iii-arena", "storyline": "In Quake III Arena, the greatest warriors of all time are pulled from their own worlds to fight for the amusement of a powerful race known as the Vadrigar within the Arena Eternal. The player takes the role of one such combatant, battling through tiers of opponents in an endless contest of skill and survival.", "summary": "Quake III Arena is a first-person shooter built around competitive multiplayer combat. Unlike earlier entries in the Quake series, it has no story-driven campaign, and its single-player mode instead pits the player against computer-controlled bots across a series of increasingly difficult arenas. Matches take place in maps that mix gothic and technological architecture, with weapons and power-ups spawning at fixed points that players fight to control. Movement techniques such as strafe-jumping and rocket-jumping are central to high-level play. Game modes include free-for-all deathmatch, team deathmatch, one-on-one tournament duels, and capture the flag, and the game supports network and internet play along with extensive customization and modding.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/quake-iii-arena", "videos": [{"id": 436, "name": "Trailer", "video_id": "NsL32y--h00"}, {"id": 25823, "name": "Gameplay video", "video_id": "p2Y_-uO3_bU", "url": "https://www.youtube.com/watch?v=p2Y_-uO3_bU", "title": "Quake 3 - Arena 1999 PC", "thumb": "https://i.ytimg.com/vi/p2Y_-uO3_bU/maxresdefault.jpg"}], "collections": [{"id": 37, "name": "Quake"}]}