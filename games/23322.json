elease_region": {"id": 2, "region": "north_america"}}, {"id": 629249, "date": 1664496000, "platform": 6, "y": 2022, "release_region": {"id": 1, "region": "europe"}}, {"id": 606363, "date": 1664496000, "platform": 130, "y": 2022, "release_region": {"id": 1, "region": "europe"}}, {"id": 606365, "date": 1693440000, "platform": 130, "y": 2023, "release_region": {"id": 5, "region": "japan"}}, {"id": 606370, "date": 1665100800, "platform": 48, "y": 2022, "release_region": {"id": 3, "region": "australia"}}, {"id": 606369, "date": 1664236800, "platform": 48, "y": 2022, "release_region": {"id": 2, "region": "north_america"}}, {"id": 911946, "date": 1664323200, "platform": 6, "y": 2022, "release_region": {"id": 5, "region": "japan"}}, {"id": 911947, "date": 1587600000, "platform": 48, "y": 2020, "release_region": {"id": 5, "region": "japan"}}, {"id": 927192, "date": 1788998400, "platform": 508, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 927193, "date": 1788998400, "platform": 167, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 601737, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccwax.jpg"}, {"id": 601739, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccwaz.jpg"}, {"id": 601736, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccwaw.jpg"}, {"id": 601738, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccway.jpg"}, {"id": 601734, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccwau.jpg"}, {"id": 601735, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sccwav.jpg"}], "slug": "the-legend-of-heroes-trails-from-zero", "storyline": "Part of the long-running Trails series, Trails from Zero is set in the prosperous city-state of Crossbell, an independent territory wedged uneasily between two great powers, the Erebonian Empire and the Calvard Republic, both of which covet control over it. Beneath its cosmopolitan surface, Crossbell is riddled with political tension, corruption, and entrenched organized crime. The story follows Lloyd Bannings, a young police detective who returns home after completing his training only to be assigned to a brand-new and untested branch of the city's police force, the Special Support Section. Alongside his fellow rookies, the political heiress Elie MacDowell, the easygoing ex-mercenary Randy Orlando, and the quiet electronics prodigy Tio Plato, Lloyd sets out to prove that this fledgling unit can make a difference. As the four take on the cases no one else will handle, they begin to peel back the layers of crime and corruption festering within Crossbell, drawing them steadily toward forces far more dangerous than they anticipated.", "summary": "The Legend of Heroes: Trails from Zero is the fourth installment in the main Trails series, serving as a direct sequel to the events of the Liberl arc and the beginning to the Crossbell arc. The game follows Lloyd Bannings and his colleagues Elie MacDowell, Randy Orlando, and Tio Plato. The four form the Special Support Section, a newly formed department of the Crossbell police in a city-state located between two great powers fighting for control over it.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 31, "name": "Drama"}], "url": "https://www.igdb.com/games/the-legend-of-heroes-trails-from-zero", "videos": [{"id": 9638, "name": "Trailer", "video_id": "YpUx1zeYTv8", "url": "https://www.youtube.com/watch?v=YpUx1zeYTv8", "title": "\u82f1\u96c4\u4f1d\u8aac \u96f6\u306e\u8ecc\u8de1 \u30c7\u30e2\u30e0\u30fc\u30d3\u30fc", "thumb": "https://i.ytimg.com/vi/YpUx1zeYTv8/maxresdefault.jpg"}, {"id": 9637, "name": "Trailer", "video_id": "_via7K5nLMw", "url": "https://www.youtube.com/watch?v=_via7K5nLMw", "title": "\u300c\u96f6&\u78a7\u306e\u8ecc\u8de1\u300d\u65e5\u672c\u30b2\u30fc\u30e0\u5927\u8cde&\u30e6\u30fc\u30b6\u30fc\u30ba\u30c1\u30e7\u30a4\u30b9\u8cdeW\u53d7\u8cde\u8a18\u5ff5\u30e0\u30fc\u30d3\u30fc", "thumb":