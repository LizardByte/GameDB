{"id": 429761, "artworks": [{"id": 328254, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar71a6.jpg"}], "cover": {"id": 624168, "url": "//images.igdb.com/igdb/image/upload/t_thumb/coddm0.jpg"}, "external_games": [{"id": 3231776, "name": "ROGUE COLLECTOR", "uid": "4292000", "url": "https://store.steampowered.com/app/4292000", "external_game_source": {"id": 1, "name": "Steam"}}, {"id": 3253947, "name": "Rogue Collector", "uid": "955975917", "url": "https://www.twitch.tv/directory/game/Rogue%20Collector", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 12, "name": "Role-playing (RPG)"}, {"id": 15, "name": "Strategy"}, {"id": 16, "name": "Turn-based strategy (TBS)"}, {"id": 24, "name": "Tactical"}, {"id": 32, "name": "Indie"}], "name": "Rogue Collector", "screenshots": [{"id": 1990046, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16nj2.jpg"}, {"id": 1990047, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16nj3.jpg"}, {"id": 1990045, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16nj1.jpg"}], "slug": "rogue-collector", "summary": "A turn-based extraction roguelike where you collect unique heroes, and lose them if you don't make it out. Send a Rogue from your collection into one of five eldritch biomes, fight through procedurally generated hex-grid levels, and rescue new Rogues and loot weapons, spells and talismans that are yours for good, but only if you extract.\n\nFall, and your Rogue and everything it carried are sealed in a tomb you can go back for. Cross a branching map to the biome's Avatar in Expedition, or push into a Descent with no map and no bottom, then trade Rogues and gear with other players on the Nexus, a shared market.", "themes": [{"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/rogue-collector", "videos": [{"id": 203343, "name": "Trailer", "video_id": "EH-WSAf