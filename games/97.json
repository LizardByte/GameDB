4, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v0w.jpg"}, {"id": 1719828, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v10.jpg"}, {"id": 1719829, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v11.jpg"}, {"id": 1719830, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v12.jpg"}, {"id": 1719831, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v13.jpg"}, {"id": 1719832, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v14.jpg"}, {"id": 1719833, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v15.jpg"}, {"id": 1719834, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10v16.jpg"}], "slug": "need-for-speed-underground-2", "storyline": "Shortly after becoming the top racer in Olympic City, the player is ambushed and their car is destroyed by an unknown assailant. Six months later, they relocate to the city of Bayview to start over, guided by a contact named Rachel Teller who introduces them to the local racing scene. As the player earns sponsorships and builds a reputation, they draw the attention of Caleb Reece, the leader of a crew called The Wraiths who is attempting to control Bayview's racing scene by manipulating sponsorship deals. Rachel reveals that Caleb is the same person responsible for the attack in Olympic City. After turning one of Caleb's crew members to their side and surviving multiple attempts to sabotage their career through rigged tournaments, the player challenges Caleb directly, defeats him, and claims the title of Bayview's best underground racer.", "summary": "Need for Speed: Underground 2 is a street racing game and the first entry in the series to feature an open world environment. Set in the fictional city of Bayview, players drive freely between events while building their reputation through circuit, sprint, drift, drag, and Street X races, as well as outrun challenges and Underground Racing League tournaments. The game expands on its predecessor with broader vehicle customization options, a sponsorship system, and new race types. SUVs appear alongside the returning roster of tuner cars.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/need-for-speed-underground-2", "videos": [{"id": 13768, "name": "Trailer", "video_id": "Xl38fecVFzU", "url": "https://www.youtube.com/watch?v=Xl38fecVFzU", "title": "Need For Speed Underground 2 Trailer #1", "thumb": "https://i.ytimg.com/vi/Xl38fecVFzU/hqdefault.jpg"}, {"id": 134614, "name": "Gameplay Video", "video_id": "7NJDrcLilpQ", "url": "https://www.youtube.com/watch?v=7NJDrcLilpQ", "title": "NFS Underground  2- Need for Speed sur Gamecube - 2004 / EA Blackbox", "thumb": "https://i.ytimg.com/vi/7NJDrcLilpQ/hqdefault.jpg"}, {"id": 166608, "name": "Gameplay Trailer", "video_id": "0w2ep42kiz4", "url": "https://www.youtube.com/watch?v=0w2ep42kiz4", "title": "Need for Speed: Underground 2 - 2004 Trailer [High Quality]", "thumb": "https://i.ytimg.com/vi/0w2ep42kiz4/maxresdefault.jpg"}, {"id": 193664, "name": "Trailer", "video_id": "1XYRmqjSo4o", "url": "https://www.youtube.com/watch?v=1XYRmqjSo4o", "title": "Need For Speed: Underground 2 (2004), Official Trailer (PC/PS2/GC/Xbox)", "thumb": "https://i.ytimg.com/vi/1XYRmqjSo4o/hqdefault.jpg"}, {"id": 193668, "name": "Launch Trailer", "video_id": "5di7qsI4Yn0", "url": "https://www.youtube.com/watch?v=5di7qsI4Yn0", "title": "Need for Speed Underground 2 (2004), Official Brooke Burke Launch trailer (PC/PS2/GC/Xbox/DS/GBA)", "thumb": "https://i.ytimg.com/vi/5di7qsI4Yn0/hqdefault.jpg"}, {"id": 193669, "name": "Release Date Trailer", "video_id": "zN2241FF2Hg", "url": "https://www.youtube.com/watch?v=zN2241FF2Hg", "title": "Need for Speed Underground 2 (2004), Official Cast Release date trailer (PC/PS2/GC/Xbox/DS/GBA)", "thumb": "https://i.ytimg.com/vi/zN2241FF2Hg/maxresdefault.jpg"}, {"id": 193670, "name": "Announcement Trailer", "video_id": "FCap0TJE8dY", "url": "https://www.youtube.com/watch?v=FCap0TJE8dY", "title": "Need for speed: Un