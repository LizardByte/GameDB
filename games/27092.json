nies": [{"id": 44159, "company": {"id": 110, "name": "Focus Entertainment"}, "developer": false}, {"id": 44158, "company": {"id": 405, "name": "Spiders"}, "developer": true}], "name": "GreedFall", "platforms": [169, 48, 6, 167, 49], "player_perspectives": [{"id": 2, "name": "Third person"}], "rating": 73.02281731329187, "release_dates": [{"id": 296097, "date": 1625011200, "platform": 169, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 296028, "date": 1625011200, "platform": 167, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 256036, "date": 1567987200, "platform": 6, "y": 2019, "release_region": {"id": 2, "region": "north_america"}}, {"id": 414705, "date": 1567987200, "platform": 6, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 171892, "date": 1568073600, "platform": 49, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 171891, "date": 1568073600, "platform": 48, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 308352, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lxc.jpg"}, {"id": 308347, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lx7.jpg"}, {"id": 308348, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lx8.jpg"}, {"id": 308354, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lxe.jpg"}, {"id": 308351, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lxb.jpg"}, {"id": 308350, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lxa.jpg"}, {"id": 308349, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lx9.jpg"}, {"id": 308353, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc6lxd.jpg"}], "slug": "greedfall", "storyline": "De Sardet, a noble of the Merchant Congregation, travels to the newly colonized island of Teer Fradee to serve as diplomatic envoy to their cousin Constantin, the island's newly appointed governor. Their mission carries an additional urgency: the continent is being ravaged by a deadly plague called the malichor, and the Congregation hopes the island's exotic resources may hold a cure.\n\nUpon arrival, De Sardet discovers the island's native people possess a supernatural connection to the land itself, and they worship a powerful being tied to the island's very essence. Caught between the invading colonial powers and the increasingly hostile natives fighting to protect their home, De Sardet must navigate fragile alliances and uncover the island's secrets while racing to find a remedy before the plague consumes everything they left behind.", "summary": "GreedFall is a single-player action RPG set in a fictional world inspired by 17th-century Baroque Europe. Players take the role of a diplomat arriving on a remote island inhabited by natives with supernatural abilities, now contested by colonial factions from various nations. The game emphasizes player choice, offering combat, diplomacy, and stealth approaches to quests, with decisions affecting relationships between the island's competing factions. A prequel, GreedFall 2: The Dying World, was released in 2026.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/greedfall", "videos": [{"id": 12035, "name": "Teaser", "video_id": "NYlhq3L0bMQ", "url": "https://www.youtube.com/watch?v=NYlhq3L0bMQ", "title": "GreedFall - Teaser (Official)", "thumb": "https://i.ytimg.com/vi/NYlhq3L0bMQ/maxresdefault.jpg"}, {"id": 29211, "name": "Trailer", "video_id": "6UCMZldBGpM", "url": "https://www.youtube.com/watch?v=6UCMZldBGpM", "title": "GreedFall - Gameplay Overview Trailer | PS4", "thumb": "https://i.ytimg.com/vi/6UCMZldBGpM/maxresdefault.jpg"}, {"id": 29443, "name": "Trailer", "video_id": "cX0UAUTX3-Q", "url": "https://www.youtube.com/watch?v=cX0UAUTX3-Q", "title": "[GAMESCOM 2019] GreedFall \u2013 Companions Trailer", "thumb": "https://i.ytimg.com/vi/cX0UAUTX3-Q/maxresdefault.jpg"}, {"id": 20728, "name":