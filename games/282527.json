g"}, {"id": 1223770, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq89m.jpg"}, {"id": 1223771, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq89n.jpg"}, {"id": 1223767, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scq89j.jpg"}], "slug": "flash-of-the-blade-x", "storyline": "Flash of the Blade X is a first-person slasher set in Feudal Japan.\nTake control of a ninja on a quest for revenge against the clan that betrayed him and left him for dead.\nUse period-accurate weaponry such as the Katana, Kusari-Gama, and Shuriken to bring death upon enemies.", "summary": "Flash of the Blade is a first-person slasher with a high level of difficulty due to its one-hit-kill mechanic. Described by testers as unforgiving, brutal, and thematically on-point, the game has gone through extensive balancing to get it to a stage where it is no longer unfair, but FUNfair.\n\nThe game is purposefully light on story, basing itself around a battle between a lone ninja and an Evil Ninja Clan helmed by a diaper-wearing Sumo. Expect to suffer not just due to the game's difficulty, but due to seeing the boss in a giant diaper.\nThe story effectively boils down to - See Ninja, Fight Ninja, Be Ninja.\n\nFlash of the Blade contains 11 fast-paced, ferocious levels, 5 deadly weapons, and 6 grueling enemy types.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/flash-of-the-blade-x", "videos": [{"id": 144926, "name": "Launch Trailer", "video_id": "KIcpXKZaKxc"}]}