provider-sim", "videos": [{"id": 189606, "name": "Trailer", "video_id": "Q1yEb5YPk1c", "url": "https://www.youtube.com/watch?v=Q1yEb5YPk1c", "title": "Uptime: Gameplay Trailer 1 - Garage", "thumb": "https://i.ytimg.com/vi/Q1yEb5YPk1c/fhddefault.jpg"}, {"id": 189607, "name": "Teaser", "video_id": "3WZfPHjjPmA", "url": "https://www.youtube.com/watch?v=3WZfPHjjPmA", "title": "Uptime: Teaser 1 - Growth", "thumb": "https://i.ytimg.com/vi/3WZfPHjjPmA/fhddefault.jpg"}]}