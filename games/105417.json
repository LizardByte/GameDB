ion": "japan"}}, {"id": 943223, "date": 1658966400, "platform": 6, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 943224, "date": 1659052800, "platform": 48, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 943225, "date": 1659052800, "platform": 49, "y": 2022, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 239472, "url": "//images.igdb.com/igdb/image/upload/t_thumb/j5g4ejortp3os5z9izsy.jpg"}, {"id": 239473, "url": "//images.igdb.com/igdb/image/upload/t_thumb/htmht7tvnhxdu2pxwpwg.jpg"}, {"id": 1881855, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1r.jpg"}, {"id": 1881856, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1s.jpg"}, {"id": 1881857, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1t.jpg"}, {"id": 1881858, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1u.jpg"}, {"id": 1881859, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1v.jpg"}, {"id": 1881860, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1w.jpg"}, {"id": 1881861, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1x.jpg"}, {"id": 1881862, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1y.jpg"}, {"id": 1881863, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc14c1z.jpg"}], "slug": "digimon-survive", "storyline": "A group of teenagers on a school field trip to investigate the local legends of monstrous \"Beast Gods\" find themselves suddenly transported to a strange and dangerous parallel world populated by creatures called Digimon. Stranded and hunted by hostile monsters, the students form bonds with Digimon partners of their own and struggle to survive while searching for a way home. As tensions, fear, and hard choices test the group, they must confront the mysteries of this world, including the truth behind the fog that threatens to consume them all.", "summary": "This is a story of survival in a strange new world.\n\nCelebrating the 20th Anniversary of the Digimon Anime, Digimon Survive presents a brand-new adventure set in a mysterious world with characters designed by Uichi Ukumo, and music by the much-acclaimed Tomoki Miyoshi.\n\nDigimon Survive sees a brand-new group of teenagers, led by Takuma Momozuka, get lost on a school camping trip, finding them transported to a strange new world of monsters and danger.\n\nAs they fight their way back home through an animated world of difficult decisions and deadly battles, players\u2019 choices throughout the game will impact the evolution of their monster allies, and the final ending. Battles in the game are fought in 2D, in a more classic SRPG style.", "themes": [{"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 21, "name": "Survival"}], "url": "https://www.igdb.com/games/digimon-survive", "videos": [{"id": 28843, "name": "Game intro", "video_id": "D3pKh6XwPpc", "url": "https://www.youtube.com/watch?v=D3pKh6XwPpc", "title": "Digimon Survive \u2013 Opening Movie", "thumb": "https://i.ytimg.com/vi/D3pKh6XwPpc/maxresdefault.jpg"}, {"id": 21430, "name": "Trailer", "video_id": "kB52ole0BgI", "url": "https://www.youtube.com/watch?v=kB52ole0BgI", "title": "Digimon Survive \u2013 Teaser Trailer", "thumb": "https://i.ytimg.com/vi/kB52ole0BgI/maxresdefault.jpg"}, {"id": 70970, "name": "Release Date Trailer", "video_id": "TF1eRTJVJGE", "url": "https://www.youtube.com/watch?v=TF1eRTJVJGE", "title": "Digimon Survive - Release Date Trailer - Nintendo Switch", "thumb": "https://i.ytimg.com/vi/TF1eRTJVJGE/maxresdefault.jpg"}], "collections": [{"id": 3053, "name": "Digimon"}]}