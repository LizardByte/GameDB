{"id": 57832, "artworks": [{"id": 218619, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4oor.jpg"}, {"id": 218618, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar4ooq.jpg"}], "cover": {"id": 505765, "url": "//images.igdb.com/igdb/image/upload/t_thumb/coau91.jpg"}, "external_games": [{"id": 1905624, "name": "Hashiriya: Ookami-tachi no Densetsu", "uid": "493120", "url": "https://www.twitch.tv/directory/game/Hashiriya:%20Ookami-tachi%20no%20Densetsu", "external_game_source": {"id": 14, "name": "Twitch"}}, {"id": 105901, "name": "Hashiriya: Ookami Tachi no Densetsu", "uid": "55441", "url": "https://www.giantbomb.com/games/3030-55441/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 10, "name": "Racing"}], "involved_companies": [{"id": 358553, "company": {"id": 2075, "name": "Nichibutsu"}, "developer": true}, {"id": 358554, "company": {"id": 17183, "name": "Hamster Corporation"}, "developer": false}, {"id": 358555, "company": {"id": 3705, "name": "Nihon Bussan"}, "developer": false}], "name": "Hashiriya: Ookami-tachi no Densetsu", "platforms": [9, 7, 38], "player_perspectives": [{"id": 1, "name": "First person"}, {"id": 2, "name": "Third person"}], "release_dates": [{"id": 833703, "date": 861321600, "platform": 7, "y": 1997, "release_region": {"id": 5, "region": "japan"}}, {"id": 833704, "date": 1271203200, "platform": 9, "y": 2010, "release_region": {"id": 5, "region": "japan"}}, {"id": 833705, "date": 1271203200, "platform": 38, "y": 2010, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 969733, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scks91.jpg"}, {"id": 1696687, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d67.jpg"}, {"id": 1696688, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d68.jpg"}, {"id": 1696689, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d69.jpg"}, {"id": 1696690, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d6a.jpg"}, {"id": 1696691, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc10d6b.jpg"}], "slug": "hashiriya-ookami-tachi-no-densetsu", "summary": "A neat drift-racing game ala Initial D that lets you choose among 15 cars and 5 courses. You can race against up to 5 cars in the arcade mode and there's also a story, time trial and practice mode (where you can train tricky parts of courses).\n\nGraphics and sound are passable but unremarkable (you can listen the 12 redbook tracks on your stereo) and the handling is a bit hard to get into at first as it feels a bit stiff with a digital pad. I'd recommened using the Negcon, which helps quite a bit. An obscure racing wheel, the \"Cockpit Wheel\" (SLHP-00024) is also supported. Sadly no multiplayer option, but all in all I'd say it's a nice little racer, albeit not quite up on par with the greats (Side by Side Special, Touge MAX G).", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/hashiriya-ookami-tachi-no-densetsu", "videos": [{"id": 168085, "name": "Gameplay Video", "video_id": "6cMvc4x8ANo", "url": "https://www.youtube.com/watch?v=6cMvc4x8ANo", "title": "2955 Hashiriya \u8d70\u308a\u5c4b \u72fc\u305f\u3061\u306e\u4f1d\u8aac ps1 playstation", "thumb": "https://i.ytimg.com/vi/6cMvc4x8ANo/maxresdefault.jpg"}]}