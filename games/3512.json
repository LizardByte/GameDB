 184, "name": "id Software"}, "developer": false}, {"id": 183670, "company": {"id": 71, "name": "Raven Software"}, "developer": true}], "multiplayer_modes": [{"id": 13701, "campaigncoop": false, "dropin": false, "game": 3512, "lancoop": true, "offlinecoop": false, "onlinecoop": false, "onlinemax": 4, "splitscreen": false, "checksum": "235afece-6a59-df2d-46a6-c54436a57bc8"}], "name": "Hexen: Beyond Heretic", "platforms": [6, 14, 13], "player_perspectives": [{"id": 1, "name": "First person"}], "rating": 72.73817777885367, "release_dates": [{"id": 24683, "date": 815011200, "platform": 13, "y": 1995, "release_region": {"id": 2, "region": "north_america"}}, {"id": 24684, "date": 820368000, "platform": 13, "y": 1995, "release_region": {"id": 1, "region": "europe"}}, {"id": 24682, "date": 833587200, "platform": 14, "y": 1996, "release_region": {"id": 2, "region": "north_america"}}, {"id": 24685, "date": 1186099200, "platform": 6, "y": 2007, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 24692, "date": 883526400, "platform": 6, "y": 1997, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 46869, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qh7w9d7ekud4usmorkdr.jpg"}, {"id": 46870, "url": "//images.igdb.com/igdb/image/upload/t_thumb/c6i5hbxd46nknb6yfm8m.jpg"}, {"id": 46871, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tbvedz9qndwvcuuw631n.jpg"}, {"id": 46873, "url": "//images.igdb.com/igdb/image/upload/t_thumb/impfxcdxkma2i6kcvg9x.jpg"}, {"id": 46872, "url": "//images.igdb.com/igdb/image/upload/t_thumb/xnqmv3n3wc2gmpbjg6j2.jpg"}], "slug": "hexen-beyond-heretic", "storyline": "Following the tale of D'Sparil's defeat in Heretic, Hexen takes place in another realm, Cronos, which is besieged by the second of the three Serpent Riders, Korax. Three heroes set out to destroy Korax. The player assumes the role of one such hero. Throughout the course of his quest, he travels through elemental dungeons, a wilderness region, a mountainside seminary, a large castle, and finally a necropolis, before the final showdown with the Serpent Rider.", "summary": "While you were battling the evil forces of D'Sparil, the other Serpent Riders were busy sowing the seeds of destruction in other dimensions. One such dimension is the decaying world where Hexen takes place. A world littered with the mangled corpses of nonbelievers and inhabited by the undead followers that executed them. Only three humans; a warrior, a mage and a cleric; have escaped the leaders' vicious spell. Now these brave souls have sworn to crush the evil regime that threatens to destroy the world forever. Separated upon entering the mystical portal, the three are forced to attempt on their own what they had hoped to do together: find Korax's stronghold, destroy him and restore order in the physical world.\n\nBecome one of 3 heroes. Wield superhuman powers and lethal weapons.\nWalk. Run. Fly. Look all around. Inflict serious pain.\nPillage your way through earthquakes, crumbling bridges and fog.\nTrack down powerful artifacts and cast wicked spells.\nFour sick individuals can wreak havoc via network, two by modem.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 19, "name": "Horror"}], "url": "https://www.igdb.com/games/hexen-beyond-heretic", "videos": [{"id": 31570, "name": "Gameplay video", "video_id": "dTrI2im443k"}], "collections": [{"id": 176, "name": "Heretic"}, {"id": 6002, "name": "Hexen"}]}