ch"}}, {"id": 101586, "name": "The New World", "uid": "60470", "url": "https://www.giantbomb.com/games/3030-60470/", "external_game_source": {"id": 3, "name": "GiantBomb"}}, {"id": 1486056, "name": "The New World", "uid": "648410", "url": "https://store.steampowered.com/app/648410", "external_game_source": {"id": 1, "name": "Steam"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 12, "name": "Role-playing (RPG)"}, {"id": 16, "name": "Turn-based strategy (TBS)"}, {"id": 24, "name": "Tactical"}], "involved_companies": [{"id": 362437, "company": {"id": 2081, "name": "Iron Tower Studio"}, "developer": true}], "name": "Colony Ship: A Post-Earth Role Playing Game", "platforms": [6], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 536528, "date": 1617667200, "platform": 6, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 536529, "date": 1699488000, "platform": 6, "y": 2023, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 354042, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6i.jpg"}, {"id": 354044, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6k.jpg"}, {"id": 354048, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6o.jpg"}, {"id": 354046, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6m.jpg"}, {"id": 354047, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6n.jpg"}, {"id": 354045, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6l.jpg"}, {"id": 354043, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc7l6j.jpg"}], "slug": "colony-ship-a-post-earth-role-playing-game", "storyline": "It is the Year of Our Lord 2754\u2026\n\nYou will never feel the sun\u2019s warmth under a blue sky, never hear the wind in the branches of a tree, and never swim in the ocean, all because you had the misfortune to be born on the Ship, chained to a fate you didn\u2019t choose. You have never seen Earth and you\u2019ll never see Proxima Centauri either. You\u2019re doomed to live and die on the Ship in the name of the Mission, like your father before you, like his father before him.\n\nThe Ship is old. She had already been twenty years in service when she was rechristened Starfarer - a pretty name for a retrofitted interplanetary freighter. No one is certain the Ship will actually reach its destination, and nobody much cares, since no one alive now will live to see it. Might as well get on with your life and try to make the best of it.", "summary": "Colony Ship is a turn-based, party-based role-playing game set aboard a generation ship launched to Proxima Centauri. The game features a detailed skill-based character system, multiple ways to handle quests, choices & consequences, and branching dialogue trees.", "themes": [{"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/colony-ship-a-post-earth-role-playing-game", "videos": [{"id": 171146, "name": "Trailer", "video_id": "pEXwwgTwBPo", "url": "https://www.youtube.com/watch?v=pEXwwgTwBPo", "title": "Colony Ship - Release Trailer", "thumb": "https://i.ytimg.com/vi/pEXwwgTwBPo/maxresdefault.jpg"}]}