e": 1183680000, "platform": 5, "y": 2007, "release_region": {"id": 3, "region": "australia"}}, {"id": 145705, "date": 1166400000, "platform": 5, "y": 2006, "release_region": {"id": 2, "region": "north_america"}}, {"id": 145706, "date": 1166745600, "platform": 5, "y": 2006, "release_region": {"id": 1, "region": "europe"}}, {"id": 145707, "date": 1166572800, "platform": 5, "y": 2006, "release_region": {"id": 5, "region": "japan"}}, {"id": 773959, "date": 717379200, "platform": 121, "y": 1992, "release_region": {"id": 5, "region": "japan"}}, {"id": 773960, "date": 602985600, "platform": 86, "y": 1989, "release_region": {"id": 5, "region": "japan"}}, {"id": 773961, "date": 635040000, "platform": 86, "y": 1990, "release_region": {"id": 2, "region": "north_america"}}, {"id": 773962, "date": 1072828800, "platform": 55, "y": 2003, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 773963, "date": 1104451200, "platform": 55, "y": 2004, "release_region": {"id": 5, "region": "japan"}}, {"id": 773964, "date": 1242086400, "platform": 34, "y": 2009, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 773965, "date": 716688000, "platform": 149, "y": 1992, "release_region": {"id": 5, "region": "japan"}}], "screenshots": [{"id": 181293, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mk4nxqi93jxydwdsmwjj.jpg"}, {"id": 181295, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yszvplw2sy2alllmfnai.jpg"}, {"id": 181292, "url": "//images.igdb.com/igdb/image/upload/t_thumb/r0ryyjs0up2k2puwrfyd.jpg"}, {"id": 181291, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bw2ax0oa63nhaago5bsc.jpg"}, {"id": 181294, "url": "//images.igdb.com/igdb/image/upload/t_thumb/eberbofnwbun19gzpjey.jpg"}, {"id": 1588449, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scy1nl.jpg"}, {"id": 1588450, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scy1nm.jpg"}], "slug": "military-madness", "storyline": "Space on Earth has become limited, and mankind has looked to colonize the moon. A group known as the Axis Powers has seized control over most of the lunar surface, and it's up to you as a member of the Allied Powers to fight against them. As you move around the map (shown in a top-down 2D perspective), enemy combatants will try and stop you from achieving your goal. Once encountered, the screen shifts view points to a close-up view of the skirmish at hand.", "summary": "Military Madness (released as Nectaris in Japan) is a futuristic turn-based strategy war game. The year is 2089 and the setting is Earth\u2019s moon, which yields many important resources. While the governments of Earth bicker over their staked claims on the moon, the evil Axis Empire launches a lunar military campaign and takes over the moon, using its factories to produce advanced weaponry, the most devastating of which is the SAM (Supreme Atomic Missile). As commander of the Allied forces, it is the player\u2019s responsibility to lead what\u2019s left of the Allied armies in a desperate offensive against the Axis Empire on the lunar surface before they can use the SAM to destroy Earth.", "themes": [{"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/military-madness", "videos": [{"id": 156611, "name": "Gameplay Video", "video_id": "F4Z8bSwy01I", "url": "https://www.youtube.com/watch?v=F4Z8bSwy01I", "title": "Nectaris (PCEngine / TurboGrafx-16)", "thumb": "https://i.ytimg.com/vi/F4Z8bSwy01I/sddefault.jpg"}], "collections": [{"id": 4177, "name": "Nectaris"}]}