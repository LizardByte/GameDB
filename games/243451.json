_thumb/sclvex.jpg"}], "slug": "street-fighter-alpha-2--1", "storyline": "The game brings back all thirteen characters from Street Fighter Alpha, with M. Bison, Akuma, and Dan now being immediately selectable as playable characters. In addition to the Alpha roster, Alpha 2 includes Dhalsim and Zangief, both from Street Fighter II; Gen, an assassin from the original Street Fighter; Rolento, a member of the Mad Gear gang who originally appeared in Final Fight; and newcomer Sakura, a Japanese schoolgirl who takes up street fighting after witnessing one of Ryu's battles. The game also features a \"classic-style\" alternative version of Chun-Li where she is wearing her outfit from the Street Fighter II series.", "summary": "The PlayStation port of Street Fighter Alpha 2 features an arranged soundtrack and Shin Akuma as a selectable character via a secret code.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/street-fighter-alpha-2--1", "videos": [{"id": 87107, "name": "Gameplay Video", "video_id": "oQMp6iLdU2Y", "url": "https://www.youtube.com/watch?v=oQMp6iLdU2Y", "title": "Street Fighter Alpha 2 - Longplay | PS1", "thumb": "https://i.ytimg.com/vi/oQMp6iLdU2Y/maxresdefault.jpg"}], "collections": [{"id": 2883, "name": "Street Fighter Alpha"}, {"id": 219, "name": "Street Fighter"}]}