, "genres": [{"id": 5, "name": "Shooter"}, {"id": 31, "name": "Adventure"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 33054, "company": {"id": 420, "name": "Flying Wild Hog"}, "developer": true}, {"id": 33055, "company": {"id": 6549, "name": "Good Shepherd Entertainment"}, "developer": false}], "name": "Hard Reset: Redux", "platforms": [48, 6, 12, 49], "player_perspectives": [{"id": 1, "name": "First person"}], "rating": 60.339114149476, "release_dates": [{"id": 50935, "date": 1464912000, "platform": 48, "y": 2016, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 50936, "date": 1464912000, "platform": 49, "y": 2016, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 417342, "date": 1464912000, "platform": 6, "y": 2016, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 117257, "date": 1464912000, "platform": 48, "y": 2016, "release_region": {"id": 2, "region": "north_america"}}, {"id": 136064, "date": 1464912000, "platform": 49, "y": 2016, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 20560, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ri6nd0khyvsjhbue2vxp.jpg"}, {"id": 20561, "url": "//images.igdb.com/igdb/image/upload/t_thumb/rpz5onws8n7eo63dh0ug.jpg"}, {"id": 20562, "url": "//images.igdb.com/igdb/image/upload/t_thumb/kojhfd3zhchf98ahdjtl.jpg"}, {"id": 20563, "url": "//images.igdb.com/igdb/image/upload/t_thumb/jqzt6le68bnftsr5aspq.jpg"}, {"id": 20564, "url": "//images.igdb.com/igdb/image/upload/t_thumb/brduac58z43eghyzaq2u.jpg"}], "slug": "hard-reset-redux", "storyline": "The world as we know it ceased to exist. Humanity is at the verge of extinction, living in the last closed city of Bezoar. Mankind wages war against the machines controlling vast areas of what became the 'Barrens'. Machines want to control and assimilate 'The Sanctuary' a network that holds billions of digitalized human minds. Our hero, Maj. Fletcher, is a soldier of CLN - a corporation combat unit, established to protect the city. Machines are constantly assaulting the walls of Bezoar. Fletcher moves in when Bezoar's protective barrier is breached.", "summary": "The acclaimed First-Person Shooter returns fully upgraded, and more beautifully challenging than ever. Hard Reset: Redux is a brand new version of the cyberpunk classic that includes all the content of previous editions, and adds new improved gameplay, enhanced visuals and additional content to make this the Definitive Edition of Hard Reset.\n\nHard Reset: Redux is an action-packed and hardcore single-player shooter which embraces the best qualities that the genre has it offer. It includes over-the-top destruction, loads of enemies, great weapon variety, a challenging campaign and a beautifully realized cyberpunk setting. Having been originally developed to shake-up the shooter scene on PC, Hard Reset now returns to do it again on a new generation of hardware.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/hard-reset-redux", "videos": [{"id": 8348, "name": "Launch Trailer", "video_id": "xgRqISfrbi4", "url": "https://www.youtube.com/watch?v=xgRqISfrbi4", "title": "Hard Reset Redux - Launch Trailer (Official)", "thumb": "https://i.ytimg.com/vi/xgRqISfrbi4/maxresdefault.jpg"}, {"id": 8157, "name": "Trailer", "video_id": "t13GKrC0Nc8", "url": "https://www.youtube.com/watch?v=t13GKrC0Nc8", "title": "Hard Reset Redux - Announcement Trailer", "thumb": "https://i.ytimg.com/vi/t13GKrC0Nc8/maxresdefault.jpg"}, {"id": 8158, "name": "Gameplay video", "video_id": "wi5FpyYt8kM", "url": "https://www.youtube.com/watch?v=wi5FpyYt8kM", "title": "Hard Reset Redux - 15 Minutes of Bang Bang Boom!", "thumb": "https://i.ytimg.com/vi/wi5FpyYt8kM/maxresdefault.jpg"}], "collections": [{"id": 2049, "name": "Hard Reset"}], "characters": [{"id": 9434, "name": "CEO"}, {"id": 1950, "name": "Policeman 2"}, {"id": 9261, "name": "Haven"}, {"id": 9436, "name": "Haven Dispatch"