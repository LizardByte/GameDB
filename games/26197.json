}}, {"id": 101126, "date": 1505779200, "platform": 49, "y": 2017, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 101127, "date": 1505779200, "platform": 48, "y": 2017, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 44381, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tyqytgnmsrkoqqhpnrib.jpg"}, {"id": 44382, "url": "//images.igdb.com/igdb/image/upload/t_thumb/fmzdqke5kbdeyhmqq7jw.jpg"}, {"id": 210899, "url": "//images.igdb.com/igdb/image/upload/t_thumb/l5upcriinypeaqcfmej6.jpg"}, {"id": 210905, "url": "//images.igdb.com/igdb/image/upload/t_thumb/s4w4vrfghmx9cmzaaacr.jpg"}, {"id": 210904, "url": "//images.igdb.com/igdb/image/upload/t_thumb/wiyavckjlfo6pemrkcee.jpg"}, {"id": 210907, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bhv4m2ltllrknxhsxg15.jpg"}, {"id": 210906, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zruofhlo7r5qz2ay4zja.jpg"}, {"id": 210901, "url": "//images.igdb.com/igdb/image/upload/t_thumb/q33dhdklgzrqaj4dzas9.jpg"}, {"id": 210902, "url": "//images.igdb.com/igdb/image/upload/t_thumb/vuxs3wefu0tee9gvugn6.jpg"}, {"id": 210903, "url": "//images.igdb.com/igdb/image/upload/t_thumb/gzuz00jhq7iigpjwfthj.jpg"}, {"id": 210908, "url": "//images.igdb.com/igdb/image/upload/t_thumb/szjizknlhbazhkvq7zpq.jpg"}, {"id": 210900, "url": "//images.igdb.com/igdb/image/upload/t_thumb/yf1ik2g6fl8t2u1fswod.jpg"}], "slug": "marvel-vs-capcom-infinite", "storyline": "When the heroes and villains of the Marvel and Capcom universes are thrown together, their two worlds collide in catastrophe. Seeking their own twisted vision of order, the demon lord Jedah and the embodiment of Death set a scheme in motion around the fabled Infinity Stones. In the chaos, the machine intelligence Ultron and the ruthless Sigma seize the Space and Reality Stones, fuse their dimensions into one, and merge into a single terrifying being called Ultron Sigma. To wipe out all organic life, they unleash an evolving virus that converts living creatures into synthetic servants under their control. Facing extinction, an unlikely alliance of champions from both worlds bands together, striking a wary bargain with the mad titan Thanos to hunt down the remaining Infinity Stones. From the halls of Avengers Tower to distant kingdoms and space stations, these legendary warriors must set old rivalries aside to reclaim their merged world.", "summary": "Marvel vs. Capcom: Infinite will feature a variety of exciting and accessible single player modes and rich multi-player content for new players and longtime fans alike. In addition to single player Arcade, Training and Mission modes, a visually stunning and immersive cinematic Story Mode will put players at the center of both universes as they battle for survival against a sinister new threat. Marvel vs. Capcom: Infinite is being built to highlight a combination of iconic locations and fan favorite characters from both universes, including Captain Marvel and Iron Man from the Marvel side, and Ryu and Mega Man X from Capcom.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/marvel-vs-capcom-infinite", "videos": [{"id": 14570, "name": "E3 2017 Trailer", "video_id": "cnQkXqMu9Ec", "url": "https://www.youtube.com/watch?v=cnQkXqMu9Ec", "title": "Marvel vs. Capcom: Infinite - E3 2017 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/cnQkXqMu9Ec/maxresdefault.jpg"}, {"id": 11189, "name": "PSX 2016 Announcement Trailer", "video_id": "5BxXoQ2O3AI", "url": "https://www.youtube.com/watch?v=5BxXoQ2O3AI", "title": "Marvel vs. Capcom: Infinite - PSX 2016 Announcement Trailer (Official)", "thumb": "https://i.ytimg.com/vi/5BxXoQ2O3AI/maxresdefault.jpg"}, {"id": 11216, "name": "Gameplay Trailer", "video_id": "amGcJ-mSzlQ", "url": "https://www.youtube.com/watch?v=amGcJ-mSzlQ", "title": "Marvel vs. Capcom: Infinite - Gameplay Trailer (Official)", "thumb": "https://i.ytimg.com/vi/amGcJ-mSzlQ/maxresdefault.jpg"}, {"id":