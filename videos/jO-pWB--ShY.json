u5408\u6210\u7d20\u6750\u30a2\u30a4\u30c6\u30e0\u3092\u5408\u6210\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u6b66\u5668\u306e\u653b\u6483\u529b\u30fb\u786c\u5ea6\u30fb\u91cd\u3055\u30fb\u5c5e\u6027\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30e2\u30f3\u30b9\u30bf\u30fc\u306b\u306f\u786c\u3055\u304c\u3042\u308a\u3001\u305d\u306e\u786c\u3055\u3092\u8d85\u3048\u308b\u6b66\u5668\u3067\u306a\u3051\u308c\u3070\u30c0\u30e1\u30fc\u30b8\u304c\u6e1b\u8870\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n\u307e\u305f\u91cd\u3055\u304c\u4e0a\u6607\u3059\u308b\u3068\u901f\u5ea6\u304c\u9045\u304f\u306a\u308a\u3001\u6226\u95d8\u4e2d\u306e\u884c\u52d5\u9806\u756a\u304c\u56de\u3063\u3066\u304f\u308b\u306e\u304c\u9045\u304f\u306a\u308a\u307e\u3059\u3002\n\u653b\u6483\u529b\u3060\u3051\u3067\u306a\u304f\u3001\u3088\u308a\u786c\u304f\u3001\u3088\u308a\u8efd\u304f\u3057\u3066\u3044\u304f\u3053\u3068\u304c\u809d\u8981\u3067\u3059\u3002\n\n\u307e\u305f\u300c\u7cbe\u970a\u306e\u6d99\u300d\u3092\u6240\u6301\u3057\u3066\u3044\u308b\u6642\u306b\u5408\u6210\u5bfe\u8c61\u3068\u3057\u3066\u88c5\u5099\u3057\u3066\u3044\u306a\u3044\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u73fe\u5728\u88c5\u5099\u3057\u3066\u3044\u308b\u6b66\u5668\u3068\u5408\u6210\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u6b66\u5668\u3092\u5408\u6210\u3059\u308b\u3068\u5bfe\u8c61\u6b66\u5668\u306e\u7279\u6027(\u5c5e\u6027\u30fb\u7279\u6b8a\u52b9\u679c)\u304c\u4ed8\u52a0\u3055\u308c\u3001\u3088\u308a\u5f37\u529b\u306a\u6b66\u5668\u3092\u751f\u307f\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u4e00\u3064\u306e\u6b66\u5668\u306b\u306f\u3001\u6700\u521d\u304b\u3089\u3064\u3044\u3066\u3044\u308b\u7279\u6027\u3068\u5408\u308f\u305b\u3066\u3001\u5408\u8a082\u3064\u307e\u3067\u7279\u6027\u3092\u4fdd\u6301\u3067\u304d\u307e\u3059\u3002\n\u81ea\u5206\u3060\u3051\u306e\u6700\u5f37\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8003\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\n\u25c6\u30ac\u30e9\u30b1\u30fc\u7248\u304b\u3089\u306e\u5909\u66f4\u70b9\u25c6\n\u30fb60fps\u5316\n\u30fb\u30a8\u30d5\u30a7\u30af\u30c8\u5f37\u5316\n\u30fb\u30c6\u30f3\u30dd\u30a2\u30c3\u30d7\n\u30fb\u4fbf\u5229\u30e1\u30cb\u30e5\u30fc\uff08\u307e\u3093\u305f\u3093\u6a5f\u80fd\u3084\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\uff09\u8ffd\u52a0\n\u30fb\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\uff13\u67a0\u304b\u3089\uff19\u67a0\u306b\u5897\u52a0\n\u30fb\u6226\u95d8\u4e2d\u306e\u30d0\u30d5\u30c7\u30d0\u30d5\u4e00\u89a7\u8868\u793a\u6a5f\u80fd\u8ffd\u52a0\n\u30fb\u6575\uff11\u4f53\u305a\u3064\u306e\u30c0\u30e1\u30fc\u30b8\u5224\u5b9a\u51e6\u7406\u3092\u307e\u3068\u3081\u3066\u51e6\u7406\u306b\u5909\u66f4\n\u30fb\u4e00\u90e8\u30d1\u30e9\u30e1\u30fc\u30bf\u8abf\u6574\u306a\u3069\n\n\u25c6\u88dc\u8db3\u25c6\n[\u203b] \u672c\u4f5c\u306f\u3001\u904e\u53bb\u306b\u4ed6\u793e\u3088\u308ai\u30e2\u30fc\u30c9\u5411\u3051\u30a2\u30d7\u30ea\u3068\u3057\u3066\u914d\u4fe1\u3055\u308c\u3066\u3044\u305f\u540c\u540d\u4f5c\u54c1\u306b\u3064\u3044\u3066\u3001\u539f\u4f5c\u8005\u3067\u3042\u308b\u5f53\u65b9\u304c\u518d\u30ea\u30ea\u30fc\u30b9\u3059\u308b\u6a29\u5229\u3092\u53d6\u5f97\u3057\u3001 \u6700\u65b0\u74b0\u5883\u5411\u3051\u306b\u79fb\u690d\u3057\u305f\u6b63\u5f0f\u30ea\u30cb\u30e5\u30fc\u30a2\u30eb\u7248\u3067\u3059\u3002\u304a\u554f\u3044\u5408\u308f\u305b\u306f\u30b9\u30c8\u30a2\u7d4c\u7531\u304b\u3001\u958b\u767a\u8005\u306e\u30db\u30fc\u30e0\u30da\u30fc\u30b8\uff08\u30a2\u30d7\u30ea\u7f6e\u304d\u5834\uff09\u3078\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n[\u203b] \u672c\u4f5c\u306f\u300160FPS\u56fa\u5b9a\u3067\u52d5\u4f5c\u3057\u307e\u3059\u300260Hz\uff08\u53ca\u3073\u305d\u306e\u500d\u6570\uff09\u4ee5\u5916\u306e\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u304c\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u52d5\u304d\u304c\u65ad\u7d9a\u7684\u306b\u611f\u3058\u3089\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"}