db/image/upload/t_thumb/uedjgwztllty0irrn5ql.jpg"}, {"id": 1379892, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkqc.jpg"}, {"id": 1379891, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkqb.jpg"}, {"id": 15409, "url": "//images.igdb.com/igdb/image/upload/t_thumb/botbw3mw1ikiqixqszte.jpg"}, {"id": 15407, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ugcri831anamhe8e47n3.jpg"}, {"id": 1379889, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkq9.jpg"}, {"id": 1379890, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sctkqa.jpg"}], "slug": "rainbow-six-siege", "storyline": "Three years after the Rainbow Program's disbandment, a surge in global terrorism from a group called the White Masks prompts its reactivation under a new leader codenamed \"Six.\" She assembles elite operatives from special forces units across multiple nations to confront this threat. After a chemical attack on a university is thwarted, Team Rainbow expands its operations worldwide, recruiting specialists from dozens of countries. Over the following years, leadership changes hands, internal conflicts arise when a private military company called Nighthaven is invited to join, and a rogue former operative named Deimos orchestrates a campaign of violence against Rainbow itself, forcing the team to hunt him down while defending their own existence.", "summary": "Tom Clancy's Rainbow Six Siege is a tactical first-person shooter focused on close-quarters combat between teams of five. Players select from a roster of operators drawn from counter-terrorism units around the world, each with unique gadgets and abilities. One team attacks objectives such as defusing bombs or rescuing hostages, while the other team fortifies and defends. The game emphasizes destructible environments, with players able to breach walls, ceilings, and floors to create new lines of sight. There is no respawning within rounds, making each player's survival critical. The title has no single-player campaign but includes training modes and cooperative scenarios against AI opponents.", "themes": [{"id": 1, "name": "Action"}, {"id": 39, "name": "Warfare"}], "url": "https://www.igdb.com/games/rainbow-six-siege", "videos": [{"id": 6293, "name": "Launch Trailer", "video_id": "Cz05pYI0dIc", "url": "https://www.youtube.com/watch?v=Cz05pYI0dIc", "title": "Tom Clancy's Rainbow Six: Siege - Launch Trailer (Official)", "thumb": "https://i.ytimg.com/vi/Cz05pYI0dIc/maxresdefault.jpg"}, {"id": 6095, "name": "CTU Spotlight: SAS Trailer", "video_id": "IOPjrDUuXaQ", "url": "https://www.youtube.com/watch?v=IOPjrDUuXaQ", "title": "Tom Clancy's Rainbow Six: Siege - CTU Spotlight: SAS Trailer (Official)", "thumb": "https://i.ytimg.com/vi/IOPjrDUuXaQ/maxresdefault.jpg"}, {"id": 6099, "name": "E3 White Masks Reveal Trailer", "video_id": "waTdua8gpDc", "url": "https://www.youtube.com/watch?v=waTdua8gpDc", "title": "Tom Clancy's Rainbow Six: Siege - E3 White Masks Reveal Trailer (Official)", "thumb": "https://i.ytimg.com/vi/waTdua8gpDc/maxresdefault.jpg"}, {"id": 6096, "name": "Art of Siege", "video_id": "N7sufn_qnDM", "url": "https://www.youtube.com/watch?v=N7sufn_qnDM", "title": "Tom Clancy's Rainbow Six: Siege - Art of Siege (Official)", "thumb": "https://i.ytimg.com/vi/N7sufn_qnDM/maxresdefault.jpg"}, {"id": 6098, "name": "Gamescom 2015 Trailer", "video_id": "yFAT9U64cuY", "url": "https://www.youtube.com/watch?v=yFAT9U64cuY", "title": "Tom Clancy's Rainbow Six: Siege - Gamescom 2015 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/yFAT9U64cuY/maxresdefault.jpg"}, {"id": 6100, "name": "E3 Trailer", "video_id": "F-6S7hu0wYc", "url": "https://www.youtube.com/watch?v=F-6S7hu0wYc", "title": "Tom Clancy's Rainbow Six: Siege - E3 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/F-6S7hu0wYc/maxresdefault.jpg"}, {"id": 6103, "name": "Operators Trailer", "video_id": "hhOgDFA-7L4", "url": "https://www.youtube.com/watch?v=hhOgDFA-7L4", "title": "Tom Clancy's Rainbow Six: Siege - Operato