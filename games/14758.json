ate": 1548892800, "platform": 6, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 554872, "date": 1720656000, "platform": 130, "y": 2024, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 557752, "date": 1547769600, "platform": 49, "y": 2019, "release_region": {"id": 2, "region": "north_america"}}, {"id": 553672, "date": 1547769600, "platform": 165, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 553673, "date": 1547769600, "platform": 49, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 553671, "date": 1547769600, "platform": 48, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 18817, "url": "//images.igdb.com/igdb/image/upload/t_thumb/jseibhuhbh9osdx560ob.jpg"}, {"id": 18813, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hrucemjabvszajvmj06a.jpg"}, {"id": 18815, "url": "//images.igdb.com/igdb/image/upload/t_thumb/thadgjjt8lkxukhja6oc.jpg"}, {"id": 18814, "url": "//images.igdb.com/igdb/image/upload/t_thumb/pho7vc4usrrbnu7wjgct.jpg"}, {"id": 18816, "url": "//images.igdb.com/igdb/image/upload/t_thumb/tsz2uox87tdklwmqqgqk.jpg"}, {"id": 211033, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dlviawaukxaf32jume7l.jpg"}, {"id": 211032, "url": "//images.igdb.com/igdb/image/upload/t_thumb/nsjyjhz6dbremnefilz7.jpg"}, {"id": 211031, "url": "//images.igdb.com/igdb/image/upload/t_thumb/fn1ons4sfge8at6lozff.jpg"}, {"id": 211036, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dm3dghgqo9uhjql2lwgy.jpg"}, {"id": 211037, "url": "//images.igdb.com/igdb/image/upload/t_thumb/bywzgvjyxixxdixnjvve.jpg"}, {"id": 211035, "url": "//images.igdb.com/igdb/image/upload/t_thumb/crzxy4g1qpumx55xnykj.jpg"}], "slug": "ace-combat-7-skies-unknown", "storyline": "Ace Combat 7: Skies Unknown returns to the series' fictional world of Strangereal, where the Osean Federation and the Kingdom of Erusea are drawn into a bitter aerial war sparked by a towering space elevator each side sees very differently. Players take on the role of an Osean fighter pilot known by the callsign Trigger, a skilled aviator whose career is upended when he is blamed for a catastrophe and cast into an expendable penal squadron. Flying through storm-wracked skies against elite enemy aces and swarms of advanced combat drones, Trigger must prove himself mission after dangerous mission. As the conflict spirals beyond anyone's control, the story follows soldiers, engineers, and royalty on both sides who come to question what they are really fighting for.", "summary": "Leveraging the trueSKY technology and developed utilizing Unreal Engine 4, Ace Combat 7 will astound players with beautifully rendered skies and highly detailed cityscapes but also set the stage for the most engaging aerial battles in the franchise\u2019s storied 20 year history accompanied with an immersive soundtrack. Ace Combat 7 will take the elements that the series is known for to a whole new level! Aces who have proven their combat prowess in Ace Combat 7\u2019s campaign mode can take their dogfighting skills further with furious online multiplayer battles.\n\nPlayStation4 players will also be able to get immersed in ACE COMBAT 7\u2019s realism through exclusive features developed specifically for PlayStationVR.", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 31, "name": "Drama"}, {"id": 39, "name": "Warfare"}], "url": "https://www.igdb.com/games/ace-combat-7-skies-unknown", "videos": [{"id": 11202, "name": "PSX 2016 Trailer", "video_id": "YwS0wCvHsOM", "url": "https://www.youtube.com/watch?v=YwS0wCvHsOM", "title": "Ace Combat 7 - PSX 2016 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/YwS0wCvHsOM/maxresdefault.jpg"}, {"id": 11890, "name": "PSX16 Extended Trailer", "video_id": "gXUCzEnxUa0", "url": "https://www.youtube.com/watch?v=gXUCzEnxUa0", "title": "Ace Combat 7: Skies Unknown - PSX16 Extended Trailer (Official)", "thumb": "https://i.ytimg.com/vi/gXUCzEnxUa0/maxresdefault.jpg"}, {"id": 6372, "name": " Announcement Trailer", "video_id": "GoZquRiPWu4", "url": "https://www.youtube.com/watch?v=GoZquRiPWu4", "title": "Ace Combat 7 - Announcement Trailer PSX 2015 (Official)", "thumb": "https://i.ytimg.com/vi/GoZquRiPWu4/maxresdefault.jpg"}, {"id": 15598, "name": "Gamescom 2017 Trailer", "video_id": "CSM-kaDfZQ4", "url": "https://www.youtube.com/watch?v=CSM-kaDfZQ4", "title": "Ace Combat 7: Skies - Gamescom 2017 Trailer", "thumb": "https://i.ytimg.com/vi/CSM-kaDfZQ4/maxresdefault.jpg"}, {"id": 14650, "name": "E3 2017: Cinematic Trailer", "video_id": "oFqnr0WkojE", "url": "https://www.youtube.com/watch?v=oFqnr0WkojE", "title": "Ace Combat 7: Skies Unknown - E3 2017: Cinematic Trailer (Official)", "thumb": "https://i.ytimg.com/vi/oFqnr0WkojE/maxresdefault.jpg"}, {"id": 23649, "name": "Trailer", "video_id": "2b48HA4mgw0", "url": "https://www.youtube.com/watch?v=2b48HA4mgw0", "title": "ACE COMBAT 7: SKIES UNKNOWN - Aircraft Profile: MiG-31B  | PS4, PSVR, X1, PC", "thumb": "https://i.ytimg.com/vi/2b48HA4mgw0/maxresdefault.jpg"}, {"id": 23273, "name": "Trailer", "video_id": "kV8ESueyVMI", "url": "https://www.youtube.com/watch?v=kV8ESueyVMI", "title": "Ace Combat 7: Skies Unknown - PS4/XB1/PC - Golden Joystick Awards Trailer", "thumb": "https://i.ytimg.com/vi/kV8ESueyVMI/maxresdefault.jpg"}, {"id": 24102, "name": "Trailer", "video_id": "pCslnk2nu1w", "url": "https://www.youtube.com/watch?v=pCslnk2nu1w", "title": "ACE COMBAT 7: SKIES UNKNOWN - Multiplayer Trailer | PS4, PSVR, X1, PC", "thumb": "https://i.ytimg.com/vi/pCslnk2nu1w/maxresdefault.jpg"}, {"id": 22977, "name": "Trailer", "video_id": "AKRkL8YbBvg", "url": "https://www.youtube.com/watch?v=AKRkL8YbBvg", "title": "Ace Combat 7: Skies Unknown - PS4/XB1/PC - Aircraft Customization", "thumb": "https://i.ytimg.com/vi/AKRkL8YbBvg/maxresdefault.jpg"}, {"id": 24159, "name": "Trailer", "video_id": "oLChPjZnm54", "url": "https://www.youtube.com/watch?v=oLChPjZnm54", "titl