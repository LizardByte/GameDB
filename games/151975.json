ral settings about the game to create their own experience while Story Mode follows a completely new unique story separated into different chapters.", "themes": [{"id": 18, "name": "Science fiction"}, {"id": 33, "name": "Sandbox"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/ifscl-a-code-lyoko-fangame", "videos": [{"id": 50442, "name": "Trailer", "video_id": "u3z6Kkh6HT8", "url": "https://www.youtube.com/watch?v=u3z6Kkh6HT8", "title": "IFSCL 4.0.X Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/u3z6Kkh6HT8/maxresdefault.jpg"}, {"id": 50440, "name": "Cinematic Trailer", "video_id": "aeUW_2w55B4", "url": "https://www.youtube.com/watch?v=aeUW_2w55B4", "title": "IFSCL 10-11th Anniversary Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/aeUW_2w55B4/maxresdefault.jpg"}, {"id": 50441, "name": "Trailer", "video_id": "L5i9aD_rbzY", "url": "https://www.youtube.com/watch?v=L5i9aD_rbzY", "title": "IFSCL 4.1.X Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/L5i9aD_rbzY/maxresdefault.jpg"}, {"id": 101353, "name": "Announcement Trailer", "video_id": "kYM5xYLs1BA", "url": "https://www.youtube.com/watch?v=kYM5xYLs1BA", "title": "IFSCL 13th Anniversary Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/kYM5xYLs1BA/fhddefault.jpg"}, {"id": 128368, "name": "Trailer", "video_id": "c5nbukIjcsc", "url": "https://www.youtube.com/watch?v=c5nbukIjcsc", "title": "IFSCL 4.6.X Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/c5nbukIjcsc/uhddefault.jpg"}, {"id": 128369, "name": "Trailer", "video_id": "3unDVlfihfk", "url": "https://www.youtube.com/watch?v=3unDVlfihfk", "title": "IFSCL 4.7.X Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/3unDVlfihfk/uhddefault.jpg"}, {"id": 166919, "name": "Trailer", "video_id": "q6rMYiAKZBw", "url": "https://www.youtube.com/watch?v=q6rMYiAKZBw", "title": "IFSCL 4.8.X Trailer - Code Lyoko Game", "thumb": "https://i.ytimg.com/vi/q6rMYiAKZBw/uhddefault.jpg"}]}