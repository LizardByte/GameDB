"}], "slug": "forgotten-seas", "storyline": "Survive the Void and rule the seas! Lost in the Bermuda Void, a strange realm where the ocean is endless and islands fade in and out of existence, seemingly suspended in the time of Dread Pirates. Neither alive nor truly dead, they roam these waters in search of prey. Unless you want to be fodder left in the wake of their mighty ships, you'll have to craft a ship and take to the waves - then conquer the forgotten seas, whose treacherous waters are full of bounty, treasure, and grave danger!", "summary": "You are lost in the Bermuda Void, where the ocean is endless and dry land precious. Craft your Ship-in-a-Bottle, then experience survival on the high seas. Sail for new land, build camps, hunt for treasures, trade for goods - then defend your ship from dreaded pirates stalking this strange realm!", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 21, "name": "Survival"}, {"id": 38, "name": "Open world"}, {"id": 39, "name": "Warfare"}], "url": "https://www.igdb.com/games/forgotten-seas", "videos": [{"id": 105457, "name": "Trailer", "video_id": "bBmQXOJviPs", "url": "https://www.youtube.com/watch?v=bBmQXOJviPs", "title": "Forgotten Seas - Official Game Trailer", "thumb": "https://i.ytimg.com/vi/bBmQXOJviPs/maxresdefault.jpg"}, {"id": 115980, "name": "Trailer", "video_id": "CbklPvvsSqs", "url": "https://www.youtube.com/watch?v=CbklPvvsSqs", "title": "Forgotten Seas - Official Trailer | IGN Live 2024", "thumb": "https://i.ytimg.com/vi/CbklPvvsSqs/maxresdefault.jpg"}, {"id": 165220, "name": "Launch Trailer", "video_id": "974uRhCvvTk", "url": "https://www.youtube.com/watch?v=974uRhCvvTk", "title": "Forgotten Seas | 1.0 Launch Trailer | High Seas Survival Game", "thumb": "https://i.ytimg.com/vi/974uRhCvvTk/maxresdefault.jpg"}]}