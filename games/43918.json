{"id": 43918, "age_ratings": [{"id": 17444, "organization": {"id": 1, "name": "ESRB"}, "rating_category": {"id": 3, "rating": "E"}}], "artworks": [{"id": 257998, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j2m.jpg"}, {"id": 257997, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j2l.jpg"}, {"id": 257996, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar5j2k.jpg"}], "cover": {"id": 547939, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cobqsj.jpg"}, "external_games": [{"id": 133941, "name": "Jigsaw Madness", "uid": "25519", "url": "https://www.giantbomb.com/games/3030-25519/", "external_game_source": {"id": 3, "name": "GiantBomb"}}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}, {"id": 4, "name": "Split screen"}], "genres": [{"id": 9, "name": "Puzzle"}, {"id": 26, "name": "Quiz/Trivia"}], "involved_companies": [{"id": 375810, "company": {"id": 1405, "name": "Nippon Ichi Software"}, "developer": true}, {"id": 375811, "company": {"id": 13634, "name": "Sony Computer Entertainment"}, "developer": false}, {"id": 375812, "company": {"id": 2034, "name": "XS Games"}, "developer": false}], "multiplayer_modes": [{"id": 40006, "campaigncoop": false, "dropin": false, "game": 43918, "lancoop": false, "offlinecoop": false, "offlinemax": 4, "onlinecoop": false, "splitscreen": true, "checksum": "108000f3-c45b-de5f-0a22-c2cb463866f0"}], "name": "Jigsaw Madness", "platforms": [9, 7, 38], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 887829, "date": 1072828800, "platform": 7, "y": 2003, "release_region": {"id": 1, "region": "europe"}}, {"id": 887830, "date": 1041292800, "platform": 7, "y": 2002, "release_region": {"id": 2, "region": "north_america"}}, {"id": 887831, "date": 1268870400, "platform": 9, "y": 2010, "release_region": {"id": 2, "region": "north_america"}}, {"id": 887832, "date": 1268870400, "platform": 38, "y": 2010, "release_region": {"id": 2, "region": "north_america"}}], "screenshots": [{"id": 1798278, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12jk6.jpg"}, {"id": 1798279, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12jk7.jpg"}, {"id": 1798280, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc12jk8.jpg"}], "slug": "jigsaw-madness", "summary": "An international Port of \"Jigsaw Island: Japan Graffiti\" that removes the storyline and plot of the title.\n\nA digital re-creation of the hobby of puzzle building, Jigsaw Madness offers gamers a collection of 150 different puzzles (across a variety of themes) that can be pieced together, alone or against up to three other players. Utilizing a small hand-shaped cursor, players construct puzzles that range in size from 24 to 96 to 150 pieces, each depicting anything from animals and insects to sports and anim\u00e9 characters. Players are given only seven pieces at a time with which to work, and basic statistics such as the number of pieces placed both, correctly and incorrectly, as well as the time elapsed is continually displayed.\n\nThe multiplayer portion of the title allows up to four players to compete against one another, in a race to see who can complete the puzzle fastest. A handful of options are available, including whether or not an outline of the various shapes is displayed on the playing field, thereby making the game easier.", "url": "https://www.igdb.com/games/jigsaw-madness", "videos": [{"id": 178365, "name": "Gameplay Video", "video_id": "A02wBkHOt-M", "url": "https://www.youtube.com/watch?v=A02wBkHOt-M", "title": "Jigsaw Madness (PS1 Gameplay)", "thumb": "https://i.ytimg.com/vi/A02wBkHOt-M/maxresdefault.jpg"}]}