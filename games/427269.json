d": 8, "region": "worldwide"}}, {"id": 985391, "date": 1793836800, "platform": 130, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1975408, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8g.jpg"}, {"id": 1975410, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8i.jpg"}, {"id": 1975412, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8k.jpg"}, {"id": 1975411, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8j.jpg"}, {"id": 1975405, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8d.jpg"}, {"id": 1975406, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8e.jpg"}, {"id": 1975407, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8f.jpg"}, {"id": 1975409, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc16c8h.jpg"}], "slug": "tidebreak", "summary": "The storm is coming. Send it back!\n\nTake the controls as Rei in Tidebreak, a single-player arcade shoot 'em up where daring dashes turn enemy fire into a powerful counterattack. Fly seven stages, from Glasswater Reef to the Heart of the Undertow. Capture pink shots with your dash to charge Return Volley, then send that energy back at the enemy. Read the patterns and dodge gold heavy shots.\n\nBuild your attack around five distinct weapons: Twin Shot, Prism Spread, Coral Lance, Reef Seeker, and Tide Breaker. Collect repair pickups, overcome varied formations, and challenge multi-phase bosses, including a four-phase finale.\n\nVoiced radio conversations draw Rei into a buried evacuation order and a mysterious rescue-band signal. Choose Rookie, Arcade, or Ace difficulty, take on Boss Rush, and chase local scores, ranks, and campaign-clear unlocks. Local campaign checkpoints make it easy to return for the next flight.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/tidebreak", "videos": [{"id": 201918, "name": "Trailer", "video_id": "NozjCsYdocM", "url": "https://www.youtube.com/watch?v=NozjCsYdocM", "title": "Tidebreak | Official Trailer", "thumb": "https://i.ytimg.com/vi/NozjCsYdocM/maxresdefault.jpg"}]}