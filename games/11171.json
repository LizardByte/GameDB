sive open world.", "themes": [{"id": 1, "name": "Action"}, {"id": 23, "name": "Stealth"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/tom-clancys-ghost-recon-wildlands", "videos": [{"id": 10246, "name": "Stealth Gameplay Walkthrough Trailer", "video_id": "lndl4wtFm1U", "url": "https://www.youtube.com/watch?v=lndl4wtFm1U", "title": "Tom Clancy's Ghost Recon: Wildlands - Stealth Gameplay Walkthrough Trailer (Official)", "thumb": "https://i.ytimg.com/vi/lndl4wtFm1U/maxresdefault.jpg"}, {"id": 11223, "name": "Comeback Trailer", "video_id": "_hFVokxR4g8", "url": "https://www.youtube.com/watch?v=_hFVokxR4g8", "title": "Tom Clancy's Ghost Recon: Wildlands - Comeback Trailer (Official)", "thumb": "https://i.ytimg.com/vi/_hFVokxR4g8/maxresdefault.jpg"}, {"id": 15076, "name": "Ghost War PvP Trailer", "video_id": "Wfl92kjdCd0", "url": "https://www.youtube.com/watch?v=Wfl92kjdCd0", "title": "Tom Clancys Ghost Recon Wildlands - Ghost War PvP Trailer (Official)", "thumb": "https://i.ytimg.com/vi/Wfl92kjdCd0/maxresdefault.jpg"}, {"id": 4436, "name": "E3 Trailer", "video_id": "P7V3B0t4omI", "url": "https://www.youtube.com/watch?v=P7V3B0t4omI", "title": "Tom Clancy's Ghost Recon: Wildlands - E3 Trailer (Official)", "thumb": "https://i.ytimg.com/vi/P7V3B0t4omI/maxresdefault.jpg"}, {"id": 8333, "name": "We Are Ghosts", "video_id": "Tzy-Dlf1VEE", "url": "https://www.youtube.com/watch?v=Tzy-Dlf1VEE", "title": "Tom Clancy's Ghost Recon: Wildlands - We Are Ghosts (Official)", "thumb": "https://i.ytimg.com/vi/Tzy-Dlf1VEE/maxresdefault.jpg"}, {"id": 8707, "name": "E3 2016 Cartel Cinematic Trailer", "video_id": "BsoB8nu0Y-U", "url": "https://www.youtube.com/watch?v=BsoB8nu0Y-U", "title": "Tom Clancy's Ghost Recon: Wildlands - E3 2016 Cartel Cinematic Trailer (Official)", "thumb": "https://i.ytimg.com/vi/BsoB8nu0Y-U/maxresdefault.jpg"}, {"id": 8709, "name": "E3 2016 Fight For The Wildlands Trailer", "video_id": "224nKpGc1NU", "url": "https://www.youtube.com/watch?v=2