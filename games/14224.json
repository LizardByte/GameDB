url": "https://www.microsoft.com/en-us/p/-1-/9P8JLH8V95CM", "external_game_source": {"id": 11, "name": "Microsoft"}}, {"id": 8564, "name": "Aurion: Legacy of the Kori-Odan", "uid": "368080", "url": "https://store.steampowered.com/app/368080", "external_game_source": {"id": 1, "name": "Steam"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 4, "name": "Fighting"}, {"id": 8, "name": "Platform"}, {"id": 12, "name": "Role-playing (RPG)"}, {"id": 31, "name": "Adventure"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 27492, "company": {"id": 7114, "name": "Kiro'o Games"}, "developer": true}, {"id": 27493, "company": {"id": 1460, "name": "Plug In Digital"}, "developer": false}], "name": "Aurion: Legacy of the Kori-Odan", "platforms": [6, 49], "player_perspectives": [{"id": 4, "name": "Side view"}], "rating": 70.0, "release_dates": [{"id": 600548, "date": 1716336000, "platform": 49, "y": 2024, "release_region": {"id": 2, "region": "north_america"}}, {"id": 116367, "date": 1460592000, "platform": 6, "y": 2016, "release_region": {"id": 1, "region": "europe"}}, {"id": 746137, "date": 1460592000, "platform": 6, "y": 2016, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 16099, "url": "//images.igdb.com/igdb/image/upload/t_thumb/mfdujmagqsnuo8njeqfy.jpg"}, {"id": 16101, "url": "//images.igdb.com/igdb/image/upload/t_thumb/qx1xk8deepfppknp0b1x.jpg"}, {"id": 16103, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ftfg9idsz9e8dwcuubx9.jpg"}, {"id": 16102, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ae1rdeel0lxhxaemnyti.jpg"}, {"id": 16100, "url": "//images.igdb.com/igdb/image/upload/t_thumb/s8s8iyjhzdxj2ikmnwyf.jpg"}], "slug": "aurion-legacy-of-the-kori-odan", "storyline": "The story follows Enzo Kori-Odan, prince and last heir of the ruling family of the fictional kingdom of Zama. On what should be the most triumphant day of his life, the moment of his coronation as king and his marriage to Erine Evou of Soma, disaster strikes. Enzo is ambushed, overthrown, and cast into exile in a sudden coup orchestrated by his own embittered brother-in-law. Stripped of his crown and his home, the dethroned prince refuses to surrender his birthright. Together with his wife Erine, he sets out on a sweeping journey across distant countries, encountering new peoples and cultures as he seeks to forge the alliances needed to reclaim his throne. Along the way, the royal couple must confront the weighty dilemmas of leadership and secure the future of their kingdom.", "summary": "Aurion: Legacy of the Kori-Odan is a 2D African Fantasy Action-RPG game that is introducing a new, rarely seen perspective to this genre. The dynamic and impressive gameplay has been more inspired by the \"Tales of\" series. The main narrative draws deeply from African culture and is hopefully the first entry in a series call The Kiro\u2019o Tales.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}], "url": "https://www.igdb.com/games/aurion-legacy-of-the-kori-odan", "videos": [{"id": 5985, "name": "Trailer", "video_id": "N-llfbapv40", "url": "https://www.youtube.com/watch?v=N-llfbapv40", "title": "Aurion - Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/N-llfbapv40/maxresdefault.jpg"}, {"id": 7300, "name": "Trailer", "video_id": "TeL-sCQSn_0", "url": "https://www.youtube.com/watch?v=TeL-sCQSn_0", "title": "Aurion: Legacy of the Kori-Odan - The 1st African-Fantasy 2D RPG on Steam (Official Trailer)", "thumb": "https://i.ytimg.com/vi/TeL-sCQSn_0/sddefault.jpg"}, {"id": 151084, "name": "Trailer", "video_id": "tEqkjOaYZt8", "url": "https://www.youtube.com/watch?v=tEqkjOaYZt8", "title": "Aurion: Legacy of The Kori-Odan | a nice 2D RPG on Xbox | Official Trailer", "thumb": "https://i.ytimg.com/vi/tEqkjOaYZt8/maxresdefault.jpg"}]}