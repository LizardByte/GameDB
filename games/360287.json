{"id": 360287, "artworks": [{"id": 185888, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfk.jpg"}, {"id": 185891, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfn.jpg"}, {"id": 185886, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfi.jpg"}, {"id": 185887, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfj.jpg"}, {"id": 185889, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfl.jpg"}, {"id": 185890, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ar3zfm.jpg"}], "cover": {"id": 524958, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cob926.jpg"}, "external_games": [{"id": 3148096, "name": "Speed Bubble", "uid": "803566942", "url": "https://www.twitch.tv/directory/game/Speed%20Bubble", "external_game_source": {"id": 14, "name": "Twitch"}}], "game_modes": [{"id": 1, "name": "Single player"}], "genres": [{"id": 2, "name": "Point-and-click"}, {"id": 32, "name": "Indie"}], "involved_companies": [{"id": 335705, "company": {"id": 57813, "name": "Remulla Games"}, "developer": true}], "name": "Speed Bubble", "platforms": [82], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 783348, "date": 1737849600, "platform": 82, "y": 2025, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1607796, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scygl0.jpg"}, {"id": 1607797, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scygl1.jpg"}, {"id": 1607798, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scygl2.jpg"}, {"id": 1607799, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scygl3.jpg"}, {"id": 1607800, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scygl4.jpg"}], "slug": "speed-bubble", "storyline": "The more you rush, the easier it is to screw up...\n...and this time, it happened to a poor layout artist working on the successful manga Blood Dawn. And not just any time, no. She dropped and messed up the speech bubbles two minutes before the final delivery.\nBut there's a way to fix this mess. There's still time to put the speech bubbles on the page... even if they're the first 15 speech bubbles you found lying on the floor.", "summary": "It's deadline time! Stick the speech bubbles from a manga together against the clock! Speed Bubble is a fast-paced experience in which you will try to make sense of the ridiculous dialogues in a manga. Lay out the speech bubbles (there are 90 different ones!) as best you can, and have fun reading the nonsense you have just created.", "themes": [{"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/speed-bubble", "videos": [{"id": 158492, "name": "Cinematic Trailer", "video_id": "7SY9zd5mtcc", "url": "https://www.youtube.com/watch?v=7SY9zd5mtcc", "title": "SPEED BUBBLE - Global Game Jam 25", "thumb": "https://i.ytimg.com/vi/7SY9zd5mtcc/maxresdefault.jpg"}]}