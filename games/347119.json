x?", "themes": [{"id": 1, "name": "Action"}, {"id": 18, "name": "Science fiction"}, {"id": 27, "name": "Comedy"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/romeo-is-a-dead-man", "videos": [{"id": 152573, "name": "Announcement Trailer", "video_id": "nW1cE6sj6h8", "url": "https://www.youtube.com/watch?v=nW1cE6sj6h8", "title": "Romeo is a Dead Man - Announce Trailer | PS5 Games", "thumb": "https://i.ytimg.com/vi/nW1cE6sj6h8/maxresdefault.jpg"}, {"id": 192053, "name": "Trailer", "video_id": "IMEu66-4ZyE", "url": "https://www.youtube.com/watch?v=IMEu66-4ZyE", "title": "ROMEO IS A DEAD MAN - 1st Content Update Trailer! / \u300e\u30ed\u30df\u30aa\u30fb\u30a4\u30ba\u30fb\u30a2\u30fb\u30c7\u30c3\u30c9\u30de\u30f3\u300f\u521d\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u30fb\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u30fb\u30c8\u30ec\u30fc\u30e9\u30fc\uff01", "thumb": "https://i.ytimg.com/vi/IMEu66-4ZyE/fhddefault.jpg"}, {"id": 192054, "name": "Accolades Trailer", "video_id": "2gW2CMo15O8", "url": "https://www.youtube.com/watch?v=2gW2CMo15O8", "title": "ROMEO IS A DEAD MAN - Accolades Trailer! / \u300e\u30ed\u30df\u30aa\u30fb\u30a4\u30ba\u30fb\u30a2\u30fb\u30c7\u30c3\u30c9\u30de\u30f3\u300f\u30a2\u30b3\u30ec\u30fc\u30c9\u30fb\u30c8\u30ec\u30fc\u30e9\u30fc\uff01(EN/JP Subs)", "thumb": "https://i.ytimg.com/vi/2gW2CMo15O8/uhddefault.jpg"}, {"id": 163579, "name": "Gameplay Trailer", "video_id": "FHng8C-N9bw", "url": "https://www.youtube.com/watch?v=FHng8C-N9bw", "title": "ROMEO IS A DEAD MAN - Gameplay Trailer: Extremely Bloody Action Buffet / \u300e\u30ed\u30df\u30aa\u30fb\u30a4\u30ba\u30fb\u30a2\u30fb\u30c7\u30c3\u30c9\u30de\u30f3\u300f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30c8\u30ec\u30fc\u30e9\u30fc", "thumb": "https://i.ytimg.com/vi/FHng8C-N9bw/maxresdefault.jpg"}, {"id": 170190, "name": "Trailer", "video_id": "ceog9nU0ucs", "url": "https://www.youtube.com/watch?v=ceog9nU0ucs", "title": "ROMEO IS A DEAD MAN - Release Date Trailer / \u300e\u30ed\u30df\u30aa\u30fb\u