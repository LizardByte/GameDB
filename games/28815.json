453, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ymiozwrupqoexbwcrnex.jpg"}, {"id": 109811, "url": "//images.igdb.com/igdb/image/upload/t_thumb/hgoxpkzrqsfqpvtyakqi.jpg"}, {"id": 163450, "url": "//images.igdb.com/igdb/image/upload/t_thumb/zhjasaep7ls1nzklxmwe.jpg"}, {"id": 163452, "url": "//images.igdb.com/igdb/image/upload/t_thumb/h5rmbz2o7esbxlpsopyh.jpg"}, {"id": 163455, "url": "//images.igdb.com/igdb/image/upload/t_thumb/l67lqbmievc4wxaevh0a.jpg"}], "slug": "lego-marvel-super-heroes-2", "storyline": "Across a playful, brick-built version of the Marvel Universe, the tyrannical time traveler Kang the Conqueror hatches an audacious scheme. Wielding a powerful time crystal, he plucks cities and kingdoms from countless eras and realities, from Ancient Egypt and the Old West to a Hydra-ruled Manhattan and the far future of 2099, and stitches them together into a single sprawling domain called Chronopolis, ruled from his towering citadel. Trapped within this patchwork world, the Guardians of the Galaxy, the Avengers, and a colorful host of heroes drawn from wildly different times and dimensions are forced to band together. Spider-heroes, sorcerers, kings, cosmic warriors, and unlikely allies must set aside their differences and journey through Chronopolis's clashing realms to unravel Kang's plan and free the realities he has stolen. Packed with humor and cameos, it is a globe-hopping, time-bending adventure spanning the wildest corners of the Marvel multiverse.", "summary": "Lego Marvel Super Heroes 2 is a Lego-themed action-adventure video game developed by Traveller's Tales. It is the sequel to 2013's Lego Marvel Super Heroes and the third instalment of the Lego Marvel franchise.\n\nWith the core gameplay following the same style of past Lego titles, the game features the ability to manipulate time and a four-player competitive Super Hero battle mode. Lego Marvel Super Heroes 2's storyline centers around superheroes from different eras and realities of the Marvel Universe as they fight against the time-travelling villain Kang the Conqueror in a battle across space and time.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 18, "name": "Science fiction"}, {"id": 27, "name": "Comedy"}, {"id": 35, "name": "Kids"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/lego-marvel-super-heroes-2", "videos": [{"id": 16141, "name": "Inhumans Trailer", "video_id": "kvCYYFTVzto", "url": "https://www.youtube.com/watch?v=kvCYYFTVzto", "title": "Lego Marvel Super Heroes 2 - Inhumans Trailer", "thumb": "https://i.ytimg.com/vi/kvCYYFTVzto/maxresdefault.jpg"}, {"id": 13793, "name": "Teaser", "video_id": "8Zt43Cj1_ao", "url": "https://www.youtube.com/watch?v=8Zt43Cj1_ao", "title": "Lego Marvel Super Heroes 2 - Teaser Trailer (Official)", "thumb": "https://i.ytimg.com/vi/8Zt43Cj1_ao/maxresdefault.jpg"}, {"id": 14538, "name": "E3 2017 Game Demo", "video_id": "BvYFUn-52fM", "url": "https://www.youtube.com/watch?v=BvYFUn-52fM", "title": "Lego Marvel Super Heroes 2 Live Demo & Developer Interview", "thumb": "https://i.ytimg.com/vi/BvYFUn-52fM/maxresdefault.jpg"}, {"id": 15073, "name": "Kang Trailer", "video_id": "iwfiMEZT0ng", "url": "https://www.youtube.com/watch?v=iwfiMEZT0ng", "title": "Lego Marvel Super Heroes 2 - Kang Trailer (Official)", "thumb": "https://i.ytimg.com/vi/iwfiMEZT0ng/maxresdefault.jpg"}, {"id": 16344, "name": "Story Trailer", "video_id": "aljLzNJcjYk", "url": "https://www.youtube.com/watch?v=aljLzNJcjYk", "title": "Lego Marvel Super Heroes 2 - Story Trailer", "thumb": "https://i.ytimg.com/vi/aljLzNJcjYk/maxresdefault.jpg"}], "collections": [{"id": 2715, "name": "Lego Marvel Super Heroes"}]}