le in an expansive 'Romance of the Three Kingdoms' world that will allow you to feel completely immersed in the tides of history.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 22, "name": "Historical"}, {"id": 38, "name": "Open world"}], "url": "https://www.igdb.com/games/dynasty-warriors-9", "videos": [{"id": 14638, "name": "History. Reborn", "video_id": "skA1jSjLiik", "url": "https://www.youtube.com/watch?v=skA1jSjLiik", "title": "Dynasty Warriors 9 - History. Reborn", "thumb": "https://i.ytimg.com/vi/skA1jSjLiik/sddefault.jpg"}, {"id": 17717, "name": "Trailer", "video_id": "MDOxZmOWacw", "url": "https://www.youtube.com/watch?v=MDOxZmOWacw", "title": "Dynasty Warriors 9 - Trailer", "thumb": "https://i.ytimg.com/vi/MDOxZmOWacw/maxresdefault.jpg"}, {"id": 15937, "name": "Gameplay Trailer", "video_id": "ZhJ3SZdXmL4", "url": "https://www.youtube.com/watch?v=ZhJ3SZdXmL4", "title": "Dynasty Warriors 9 - Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/ZhJ3SZdXmL4/maxresdefault.jpg"}, {"id": 18251, "name": "Launch Trailer", "video_id": "kEr8MLbqd80", "url": "https://www.youtube.com/watch?v=kEr8MLbqd80", "title": "Dynasty Warriors 9 - Launch Trailer", "thumb": "https://i.ytimg.com/vi/kEr8MLbqd80/maxresdefault.jpg"}], "collections": [{"id": 550, "name": "Dynasty Warriors"}]}