pg"}], "slug": "call-of-elyndra", "storyline": "The story revolves around you becoming a part of the local community during a time when a war brews. You'll team up with 2 other adventurers, traverse varied lands, repel an invasion, and uncover the truth about the surrounding world. While you may not have what it takes from the get-go, you will grow alongside your companions and the community. You will also grow tomatoes, cucumbers, and such, for you will be given a plot of land to farm and support the people of Elyndra. This means that you can play the game any way you want - you can do both farming and adventuring or focus entirely on either of those!", "summary": "CALL OF ELYNDRA, where farming meets adventure! Grow crops, battle monsters in real-time combat, upgrade your village and solve ancient quests across five epic realms.\n\nPlay as you want--cozy or action-driven. In Elyndra, farming meets fantasy!", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 28, "name": "Business"}, {"id": 33, "name": "Sandbox"}, {"id": 43, "name": "Mystery"}], "url": "https://www.igdb.com/games/call-of-elyndra", "videos": [{"id": 167073, "name": "Announcement Trailer", "video_id": "ojo3o301TZU", "url": "https://www.youtube.com/watch?v=ojo3o301TZU", "title": "Call of Elyndra Announcement", "thumb": "https://i.ytimg.com/vi/ojo3o301TZU/maxresdefault.jpg"}, {"id": 167070, "name": "Gameplay Trailer", "video_id": "EP13ylYOkh0", "url": "https://www.youtube.com/watch?v=EP13ylYOkh0", "title": "Call of Elyndra \u2013 Early Gameplay Footage (Farming & Adventure RPG)", "thumb": "https://i.ytimg.com/vi/EP13ylYOkh0/maxresdefault.jpg"}]}