ames/project-cataclysm--2", "videos": [{"id": 177669, "name": "Trailer", "video_id": "U0Hnj-ZAIFY", "url": "https://www.youtube.com/watch?v=U0Hnj-ZAIFY", "title": "Project Cataclysm | \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0422\u0440\u0435\u0439\u043b\u0435\u0440", "thumb": "https://i.ytimg.com/vi/U0Hnj-ZAIFY/maxresdefault.jpg"}]}