95200, "platform": 11, "y": 2005, "release_region": {"id": 2, "region": "north_america"}}, {"id": 601679, "date": 1134086400, "platform": 11, "y": 2005, "release_region": {"id": 1, "region": "europe"}}, {"id": 601670, "date": 1133395200, "platform": 6, "y": 2005, "release_region": {"id": 2, "region": "north_america"}}, {"id": 601669, "date": 1134086400, "platform": 21, "y": 2005, "release_region": {"id": 1, "region": "europe"}}, {"id": 601674, "date": 1133481600, "platform": 8, "y": 2005, "release_region": {"id": 1, "region": "europe"}}], "screenshots": [{"id": 20840, "url": "//images.igdb.com/igdb/image/upload/t_thumb/cucrswgiuw6lwum9wy1d.jpg"}, {"id": 20838, "url": "//images.igdb.com/igdb/image/upload/t_thumb/kylunga7zeutbg65vyq6.jpg"}, {"id": 2834, "url": "//images.igdb.com/igdb/image/upload/t_thumb/s5t0dho6rjdn0lqzxvxr.jpg"}, {"id": 20839, "url": "//images.igdb.com/igdb/image/upload/t_thumb/ai67uphqplgml40tjbgi.jpg"}, {"id": 2833, "url": "//images.igdb.com/igdb/image/upload/t_thumb/dzn6u3pabrdgpx7rzzq2.jpg"}], "slug": "prince-of-persia-the-two-thrones", "storyline": "The Prince returns home to Babylon only to find the city ravaged by war. His actions in the previous game have reshaped the timeline, and the villainous Vizier, once thought gone, is alive and moving against him. When the Vizier seizes the power of the Sands of Time and turns himself into an immortal threat, the Prince is caught in the fallout and left changed by the Sands, which give rise to a cruel second personality known as the Dark Prince that whispers in his mind and periodically seizes control of his body. Struggling against this inner corruption, the Prince fights his way through the city to stop the Vizier, crossing paths with Farah, a woman who, in this altered timeline, has never met him before.", "summary": "Prince of Persia: The Two Thrones is an action-adventure game blending acrobatic platforming, puzzle-solving, and hack and slash combat, and the final chapter of the Sands of Time trilogy. Players guide the Prince through the city of Babylon, running along walls, leaping between platforms, avoiding traps, and using the time-controlling Dagger of Time in combat and to recover from mistakes. A new Speed Kill system rewards well-timed stealth strikes to take down enemies quickly, and the Prince can wield secondary weapons taken from foes. At points he transforms into the Dark Prince, an alter ego that fights with a bladed whip called the Daggertail while steadily draining health. It was later ported to PlayStation Portable and Wii under the title Prince of Persia: Rival Swords.", "themes": [{"id": 1, "name": "Action"}, {"id": 17, "name": "Fantasy"}, {"id": 23, "name": "Stealth"}], "url": "https://www.igdb.com/games/prince-of-persia-the-two-thrones", "videos": [{"id": 1389, "name": "Trailer", "video_id": "0ulMNFlz29g", "url": "https://www.youtube.com/watch?v=0ulMNFlz29g", "title": "Prince of Persia: The Two Thrones GameCube Trailer - Trailer", "thumb": "https://i.ytimg.com/vi/0ulMNFlz29g/sddefault.jpg"}, {"id": 166610, "name": "Teaser", "video_id": "2nf2vMIA9GY", "url": "https://www.youtube.com/watch?v=2nf2vMIA9GY", "title": "Prince of Persia 3: Kindred Blades - Beta Two Thrones Trailer [High Quality]", "thumb": "https://i.ytimg.com/vi/2nf2vMIA9GY/maxresdefault.jpg"}], "collections": [{"id": 10840, "name": "Prince of Persia: The Sands of Time"}, {"id": 187, "name": "Prince of Persia"}]}