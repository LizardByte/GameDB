me": "Side view"}], "rating": 68.70448001950516, "release_dates": [{"id": 329418, "date": 1548288000, "platform": 130, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 329419, "date": 1583971200, "platform": 49, "y": 2020, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 212486, "date": 1548288000, "platform": 6, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 212487, "date": 1548288000, "platform": 14, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 212488, "date": 1548288000, "platform": 3, "y": 2019, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 239714, "date": 1612828800, "platform": 170, "y": 2021, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 951941, "date": 1775001600, "platform": 39, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 947566, "date": 1775520000, "platform": 34, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 269984, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbk.jpg"}, {"id": 269985, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbl.jpg"}, {"id": 269983, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbj.jpg"}, {"id": 269986, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbm.jpg"}, {"id": 269987, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbn.jpg"}, {"id": 269982, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbi.jpg"}, {"id": 269988, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc5sbo.jpg"}], "slug": "pikuniku", "storyline": "In a colorful island world, a cheerful figure named Mr. Sunshine appears in a commercial offering the local creatures free money in exchange for the junk his giant robots collect. Around the same time, a small red creature named Piku is woken by a ghost in a cave and told to leave. Emerging into the world, Piku finds that a legend has painted him as an evil beast, and the frightened villagers cage him until he agrees to repair the bridge he accidentally broke. As Piku earns the villagers' trust and explores further, he discovers that Mr. Sunshine's machines are quietly stripping the island of its essential resources, and he is drawn toward a small band of rebels determined to stop them.", "summary": "Pikuniku is a puzzle and adventure game set in a colorful world. The player controls Piku, a small red creature, guiding him through levels and solving puzzles that mostly involve kicking and pushing objects onto switches to open the way forward. Piku can lasso his legs to swing from hooks and zip lines, curl into a ball to roll, ride minecarts, and travel through pipes to reach new areas. Along the way the player meets villagers to talk with and can spend coins earned in levels on items such as hats. A local co-op mode lets a second player control a similar orange creature named Niku across a set of cooperative levels.", "themes": [{"id": 1, "name": "Action"}, {"id": 27, "name": "Comedy"}], "url": "https://www.igdb.com/games/pikuniku", "videos": [{"id": 18917, "name": "New Gameplay Trailer", "video_id": "wjEC6_VEEs4", "url": "https://www.youtube.com/watch?v=wjEC6_VEEs4", "title": "Pikuniku - New Gameplay Trailer", "thumb": "https://i.ytimg.com/vi/wjEC6_VEEs4/maxresdefault.jpg"}, {"id": 163640, "name": "Trailer", "video_id": "7KPKVD2kpFY", "url": "https://www.youtube.com/watch?v=7KPKVD2kpFY", "title": "Pikuniku - 'Wake Up' Launch Trailer", "thumb": "https://i.ytimg.com/vi/7KPKVD2kpFY/maxresdefault.jpg"}, {"id": 187315, "name": "Launch Trailer", "video_id": "Vnh3tcO-vpg", "url": "https://www.youtube.com/watch?v=Vnh3tcO-vpg", "title": "Pikuniku - Launch Trailer - Nintendo Switch", "thumb": "https://i.ytimg.com/vi/Vnh3tcO-vpg/maxresdefault.jpg"}], "collections": [{"id": 14538, "name": "Pikuniku"}]}