{"id": 6131, "cover": {"id": 571937, "url": "//images.igdb.com/igdb/image/upload/t_thumb/coc9b5.jpg"}, "external_games": [], "franchises": [{"id": 4047, "name": "Galaxian"}], "game_modes": [{"id": 1, "name": "Single player"}, {"id": 2, "name": "Multiplayer"}, {"id": 4, "name": "Split screen"}], "genres": [{"id": 5, "name": "Shooter"}], "involved_companies": [{"id": 394847, "company": {"id": 4981, "name": "Sega Enterprises, Ltd."}, "developer": false}, {"id": 394848, "company": {"id": 4981, "name": "Sega Enterprises, Ltd."}, "developer": false}, {"id": 241734, "company": {"id": 263, "name": "Namco"}, "developer": true}], "name": "Sega-Galaga", "platforms": [84, 64], "player_perspectives": [{"id": 3, "name": "Bird view / Isometric"}], "release_dates": [{"id": 538288, "date": 504835200, "platform": 64, "y": 1985, "release_region": {"id": 5, "region": "japan"}}, {"id": 538289, "date": 441676800, "platform": 84, "y": 1983, "release_region": {"id": 5, "region": "japan"}}, {"id": 929618, "date": 536371200, "platform": 84, "y": 1986, "release_region": {"id": 7, "region": "asia"}}], "screenshots": [{"id": 1060462, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmq9a.jpg"}, {"id": 1060461, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmq99.jpg"}, {"id": 1060463, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scmq9b.jpg"}, {"id": 1861312, "url": "//images.igdb.com/igdb/image/upload/t_thumb/sc13w74.jpg"}], "slug": "sega-galaga", "summary": "Sega-Galaga is the SG-1000 port of Galaga, and is strangely the only port to receive a name change.\n\nThe player pilots a starship and must destroy all the on-screen enemies, similar to Space Invaders and Galaxian. However, the enemies in Galaga have the power to steal your ship to use as reinforcements (meaning the player loses a life). However, if you are able to destroy the enemy who has captured your ship, you are able to pilot both ships at once, doubling your firepower at the expense of being a bigger target.\n\nThough Sega-Galaga is essentially the same game as the arcade original, the limitations of the SG-1000 means the graphics and sound are not quite as advanced. Also the \"challenging stages\" have been omitted, meaning each stage is identical to the last.", "themes": [{"id": 18, "name": "Science fiction"}], "url": "https://www.igdb.com/games/sega-galaga", "videos": [{"id": 188031, "name": "Gameplay Video", "video_id": "ydRU9Lj_qZI", "url": "https://www.youtube.com/watch?v=ydRU9Lj_qZI", "title": "Sega Galaga - Sega Master System", "thumb": "https://i.ytimg.com/vi/ydRU9Lj_qZI/maxresdefault.jpg"}, {"id": 188032, "name": "Gameplay Video", "video_id": "OTKGuQ015zU", "url": "https://www.youtube.com/watch?v=OTKGuQ015zU", "title": "Sega Galaga (SG-1000) - Gameplay", "thumb": "https://i.ytimg.com/vi/OTKGuQ015zU/sddefault.jpg"}], "collections": [{"id": 1971, "name": "Galaga"}]}