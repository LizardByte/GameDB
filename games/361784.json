": 2025, "release_region": {"id": 8, "region": "worldwide"}}, {"id": 925610, "date": 1780963200, "platform": 508, "y": 2026, "release_region": {"id": 8, "region": "worldwide"}}], "screenshots": [{"id": 1620909, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqp9.jpg"}, {"id": 1620910, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqpa.jpg"}, {"id": 1620912, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqpc.jpg"}, {"id": 1620911, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqpb.jpg"}, {"id": 1620907, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqp7.jpg"}, {"id": 1620908, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scyqp8.jpg"}], "slug": "snowrunner-season-15-oil-and-dirt", "summary": "Oil & Dirt is Season 15 of SnowRunner. Included in the Year 4 Pass. Requires the base game SnowRunner to run.\n\nQu\u00e9bec is bursting with exciting projects, and they need you to construct an oil platform by delivering building materials and a massive anchor. Link roads together to form a new highway network, help organize a major fishing festival and more, with 2 new trucks across 2 brand new maps.\n\nSeason 15: Oil & Dirt includes:\n\n\u2022 Two new 4km\u00b2 maps set in Qu\u00e9bec, Canada. Complete new missions across a new winter region traversed by tall mountains and frozen rivers.\n\u2022 Two new vehicles: the Sleiter ST 816 \u201cElephant\u201d, a 6-wheel Heavy Duty tractor able to pull even the heaviest loads, and the Mercer K520, an agile and versatile Off-road truck with exceptional capabilities in exploration and rescue scenarios.\n\u2022 New activities: Help Qu\u00e9bec companies with major infrastructure projects after the Canadian winter had them grind to halt, and celebrate the region\u2019s angling industry by helping organize a major fishing festival.", "url": "https://www.igdb.com/games/snowrunner-season-15-oil-and-dirt", "videos": [{"id": 159477, "name": "Trailer", "video_id": "x_j7CHs3gWc", "url": "https://www.y