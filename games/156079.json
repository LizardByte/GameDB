}, {"id": 525517, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scb9hp.jpg"}, {"id": 525513, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scb9hl.jpg"}, {"id": 525516, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scb9ho.jpg"}, {"id": 525515, "url": "//images.igdb.com/igdb/image/upload/t_thumb/scb9hn.jpg"}], "slug": "007-quantum-of-solace--3", "storyline": "In the Nintendo DS version of 007: Quantum of Solace, players follow James Bond through a storyline inspired by both Casino Royale and Quantum of Solace as he investigates criminal operations, infiltrates enemy bases, and uncovers the growing threat posed by the Quantum organization. Unlike the home console versions, the DS release features a modified storyline with several platform-specific changes to missions, characters, and events.", "summary": "In the Nintendo DS version of 007: Quantum of Solace, players control James Bond in a top-down third-person action experience that differs significantly from the console versions. Played with the system held sideways, the game relies heavily on touchscreen controls for movement, aiming, shooting, and interacting with icons. At the same time, the buttons are used mainly to initiate melee combat. It also features a progression system based on collectible casino chips and cards that can be used to enhance Bond\u2019s abilities.", "themes": [{"id": 1, "name": "Action"}], "url": "https://www.igdb.com/games/007-quantum-of-solace--3", "videos": [{"id": 163431, "name": "Gameplay Video", "video_id": "e9lP53gACCo", "url": "https://www.youtube.com/watch?v=e9lP53gACCo", "title": "Quantum of Solace Nintendo DS Video - Exploration and Touch Control", "thumb": "https://i.ytimg.com/vi/e9lP53gACCo/sddefault.jpg"}], "collections": [{"id": 326, "name": "James Bond"}]}